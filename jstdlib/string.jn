# Utilities for null-terminated byte string (NTBS) manipulation. Plus `memcpy`,
# because those C guys are weird.

fn free(void* ptr);

struct ArrayList;
struct StringBuilder;

# is the passed character a decimal digit?
pub fn isdigit(char c) {
    if c < '0' { return false; }
    if c > '9' { return false; }
    return true;
}

# is the passed character whitespace?
pub fn isspace(char c) {
    if c == ' ' { return  true; }
    if c < 9   { return false; } # < \t
    if c > 13  { return false; } # > \r
    return true;
}

# is the passed character a hexidecimal digit?
pub fn isxdigit(char c) {
    if c < '0' { return false; }
    if c <= '9' { return  true; }
    if c < 'A' { return false; }
    if c <= 'F' { return  true; }
    if c < 'a' { return false; }
    if c <= 'f' { return  true; }
    return false;
}

# copy bytes between non-overlapping memory regions.
pub fn memcpy(void* dest, void* src, int count) {
    # Once apple's CPUs support FEAT_MOPS, use the CPYP/CPYM/CPYE instructions.
    # copy byte-by-byte up to an 8-byte boundary
    int i = count % 8;
    int* d = dest;
    int* s = src;
    if i > 0 {
        memcpy_bytes(dest, src, i);
        d = d + i;
        s = s + i;
    }
    # copy the rest, long-by-long
    while i < count {
        *d = *s;
        d = d + 8;
        s = s + 8;
        i = i + 8;
    }
    return dest;
}

fn memcpy_bytes(void* dest, void* src, int count) {
    int i = 0;
    char* d = dest;
    char* s = src;
    while i < count {
        *d = *s;
        d = d + 1;
        s = s + 1;
        i = i + 1;
    }
    return dest;
}

# I return a pointer to the first occurrence of `ch` in `str`, or `null` if no
# occurrence was found. The terminating `null` is considered part of `str`.
pub fn strchr(char* str, char ch) {
    char* result = str;
    while true {
        char c = *result;
        if c == ch { return result; }
        if c == null { return null; }
        result = result + 1;
    }
}

# clone the passed string into a new allocation.
pub fn strclone(char* src) {
    int len = strlen(src) + 1; # for the null terminator
    char* dest = malloc(len);
    memcpy(dest, src, len);
    return dest;
}

# I return an `ArrayList` containing owned substrings from `str`, delimited by
# `sep`. If `sep` is the empty string, panic. I am the inverse of `strjoin`.
# This program prints `2: '', 'b'`.
#
# ```johann
# ArrayList* parts = strsplit("ab", "a");
# printf("%d: '%s', '%s'\\n",
#        parts.size(),
#        parts.get(0),
#        parts.get(1));
# parts.drop();
# ```
pub fn strsplit(char* str, char* sep) {
    int len = strlen(sep);
    if len == 0 { panic(4, "empty sep to strsplit\n", 22); }
    ArrayList* parts = ArrayList__new_owned(10, &free);
    char* ptr = strstr(str, sep);
    while ptr != null {
        parts.push(substr(str, 0, ptr - str));
        str = ptr + len;
        ptr = strstr(str, sep);
    }
    parts.push(substr(str, 0, strlen(str)));
    return parts;
}

# I return an `ArrayList` containing owned substrings from `str`, each ending
# with `sep`, except the last. If `sep` is the empty string, panic. This program
# prints `2: 'a', 'b'`.
#
# ```johann
# ArrayList* parts = strsplit_after("ab", "a");
# printf("%d: '%s', '%s'\\n",
#        parts.size(),
#        parts.get(0),
#        parts.get(1));
# parts.drop();
# ```
pub fn strsplit_after(char* str, char* sep) {
    int len = strlen(sep);
    if len == 0 { panic(4, "empty sep to strsplit_after\n", 28); }
    ArrayList* parts = ArrayList__new_owned(10, &free);
    char* ptr = strstr(str, sep);
    while ptr != null {
        parts.push(substr(str, 0, ptr - str + len));
        str = ptr + len;
        ptr = strstr(str, sep);
    }
    parts.push(substr(str, 0, strlen(str)));
    return parts;
}

# I take each `char*` element of `parts` and concatenate them together with
# `sep` between, returning the newly allocated string. I am the inverse of
# `strsplit`. This program prints `abc`;
#
# ```johann
# ArrayList* parts = ArrayList__new(2);
# parts.push("a"); parts.push("c");
# char* s = strjoin(parts, "b");
# puts(s);
# free(s); parts.drop();
# ```
pub fn strjoin(ArrayList* parts, char* sep) {
    int l = parts.size();
    if l == 0 { return strclone(""); }
    if l == 1 { return strclone(parts.get(0)); }
    StringBuilder* sb = StringBuilder__new(l);
    int i = 0;
    if *sep == null {
        # empty separator
        while i < l {
            sb.push_str(parts.get(i));
            i = i + 1;
        }
        return sb.into_chars();
    }
    sb.push_str(parts.get(0));
    i = 1;
    while i < l {
        sb.push_str(sep);
        sb.push_str(parts.get(i));
        i = i + 1;
    }
    return sb.into_chars();
}

# I compare two null-terminated byte strings and return a negative number if
# `lhs` sorts lexicographically first, a positive number if `rhs` is first, and
# zero if they are equal.
pub fn strcmp(char* lhs, char* rhs) {
    char l = *lhs;
    char r = *rhs;
    while l == r {
        if l == null { done; }
        lhs = lhs + 1;
        rhs = rhs + 1;
        l = *lhs;
        r = *rhs;
    }
    return l - r;
}

# I return an `int` hash value for the passed string. The hash of both the
# empty string and the null pointer is zero.
pub fn strhash(char* str) {
    if str == null { return 0; }
    int hash = 0;
    while *str != null {
        hash = 31 * hash + *str;
        str = str + 1;
    }
    return hash;
}

# I return the length of the passed string, not including the terminating null
# byte.
pub fn strlen(char* str) {
    char* end = str;
    while *end != null {
        end = end + 1;
    }
    return end - str;
}

# I return a pointer to the first instance of `substr` within `str`, or null if
# no occurrence was found. If `substr` is the empty string, `str` is returned.
pub fn strstr(char* str, char* substr) {
    # if substr is empty, it matches the start of str
    char first_char = *substr;
    if first_char == null { return str; }

    # otherwise, search
    char curr = *str;
    while curr != null {
        if curr == first_char {
            # the first chars matched, check the rest
            char* lhs = str;
            char* rhs = substr;
            char l = *lhs;
            char r = *rhs;
            while true {
                if r == null {
                    # found it!
                    return str;
                }
                if l != r {
                    done;
                }
                lhs = lhs + 1;
                rhs = rhs + 1;
                l = *lhs;
                r = *rhs;
            }
        }
        str = str + 1;
        curr = *str;
    }

    # didn't find it
    return null;
}

# I create a new null-terminated byte string from the given half-open range of
# the passed `str`. No bounds checking is performed.
pub fn substr(char* str, int start, int end) {
    int len = end - start;
    char* result = malloc(len + 1);
    memcpy(result, str + start, len);
    result[len] = null;
    return result;
}
