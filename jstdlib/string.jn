fn isdigit(char c) {
    if c < '0' { return false; }
    if c > '9' { return false; }
    return true;
}

fn isspace(char c) {
    if c = ' ' { return  true; }
    if c < 9   { return false; } # < \t
    if c > 13  { return false; } # > \r
    return true;
}

fn isxdigit(char c) {
    if c < '0' { return false; }
    if c < ':' { return  true; } # <= 9
    if c < 'A' { return false; }
    if c < 'G' { return  true; } # <= F
    if c < 'a' { return false; }
    if c < 'g' { return  true; } # <= f
    return false;
}

fn strclone(char* src) {
    int len = strlen(src);
    len = len + 1; # for the null terminator
    char* dest = malloc(len);
    memcpy(dest, src, len);
    return dest;
}

# Once apple's CPUs support FEAT_MOPS, use the CPYP/CPYM/CPYE instructions.
fn memcpy(void* dest, void* src, int count) {
    # copy byte-by-byte up to an 8-byte boundary
    int i = count % 8;
    int* d = dest;
    int* s = src;
    if i > 0 {
        memcpy_bytes(dest, src, i);
        d = d + i;
        s = s + i;
    }
    # copy the rest, long-by-long
    int n;
    while i < count {
        n = *s;
        *d = n;
        d = d + 8;
        s = s + 8;
        i = i + 8;
    }
    return dest;
}

fn memcpy_bytes(void* dest, void* src, int count) { # todo: not public!
    int i = 0;
    char* d = dest;
    char* s = src;
    char c;
    while i < count {
        c = *s;
        *d = c;
        d = d + 1;
        s = s + 1;
        i = i + 1;
    }
    return dest;
}
