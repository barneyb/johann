# No files, just `STDIN` and `STDOUT`. `EOF` is any negative number.
#
# ### `printf` & `eprintf`
#
# `pub fn printf( char* format, ... );`<br />
# `pub fn eprintf( char* format, ... );`
#
# I convert args to strings based on the null-terminated `format`, and write to
# `STDOUT` or `STDERR`. Note that `eprintf` is unbuffered at the moment.
#
# The conversion specs are a little rough around the edges, but can generally
# get the job done.
#
# |   spec    |                                                      | padding |
# |:---------:|------------------------------------------------------|:-------:|
# |    `%`    | literal `%`                                          |
# |    `b`    | boolean, either `true` or `false`                    |
# |    `c`    | character                                            |
# | `d` , `i` | base-10 integer                                      |  space  |
# |    `p`    | a pointer, in hex, at least 9 digits                 |  zero   |
# |    `s`    | a null-terminated byte string                        |
# | `x` , `X` | base-16 integer, w/ `0x` prefix, lower or upper case |  space  |
#
# Only integers and pointers support a width spec, and padding goes on the left.
# To pad integers with zeros instead of spaces, use a leading zero on the width.
# For hex, padding _spaces_ go before the `0x` (or `0X`), and padding _zeros_
# go after.
#
# Pointers zero-padded hex values, with a minimum of nine digits, except the
# `null` pointer. It formats as `NUL`, and is padded with spaces.
#
# There is no support for converting a single argument multiple times, you have
# to pass it for each conversion spec.
#
# ```johann
# printf("%d %s ways%c %5d, %05d, %5x\\n", 27, "four", ':', 27, 27, 27);
#      # "27 four ways:    27, 00027, 0x 1b"
# ```

int MAX_INTEGER;
int MIN_INTEGER;

# I consume the next character from STDIN and return it, or `EOF`.
pub fn getchar();

# I indicate whether STDIN has reached `EOF`.
pub fn iseof();

# I return the next character from STDIN without consuming it, or `EOF`.
pub fn peekchar();

# I write `ch` to STDOUT and return the `char` written.
pub fn putchar(char ch);

# I write the null-terminated byte string `str` _and a newline_ to STDOUT.
pub fn puts(char* str);

# I read one line of characters and return a pointer to a heap-allocated
# null-terminated byte string containing them. A line ends when `EOF` is
# reached, or a newline (`0xa`) is encountered. Such newlines _are_ consumed,
# but _are not_ returned as part of the result. If already at `EOF`, `null` is
# returned (not an empty string).
pub fn read_line() {
    if iseof() { return null; }
    void* b = StringBuilder__new();
    while !iseof() {
        char c = getchar();
        if c == 0xa { done; }
        StringBuilder_push(b, c);
    }
    return StringBuilder_into_chars(b);
}

pub fn printf_d__(int n,
                  void* emit_char,
                  char conv_spec,
                  int width,
                  char pad) {
    if n == MIN_INTEGER {
        # can't do the "abs and prefix with '-'" trick
        char* str = "-9223372036854775808";
        return printf_s__(
            str,
            emit_char,
            's',
            width,
            pad);
    }

    # it's a 24-byte "array"!
    char* buf0 = null;
    char* buf1 = null;
    char* buf2 = null;
    char* buf = &buf0;
    int i = 0;

    bool negative = n < 0;
    if negative {
        n = -n;
    }

    if n == 0 {
        buf[i] = '0';
        i = i + 1;
    } else {
        # stack it up
        while n != 0 {
            int d = n % 10;
            n = n / 10;
            buf[i] = '0' + d;
            i = i + 1;
        }
    }

    if pad != ' ' {
        int end = width;
        if negative {
            end = end - 1;
        }
        while i < end {
            buf[i] = pad;
            i = i + 1;
        }
    }

    if negative {
        buf[i] = '-';
        i = i + 1;
    }

    if pad == ' ' {
        while i < width {
            buf[i] = ' ';
            i = i + 1;
        }
    }

    # and pop back off
    int count = i;
    while i > 0 {
        i = i - 1;
        emit_char(buf[i]);
    }

    return count;
}

fn printf_nul_ptr(void* emit_char,
                  int width) {
    int i = 3;
    while i < width {
        emit_char(' ');
        i = i + 1;
    }
    emit_char('N');
    emit_char('U');
    emit_char('L');
    return i;
}

pub fn printf_x__(int n,
                  void* emit_char,
                  char conv_spec,
                  int width,
                  char pad) {
    if conv_spec == 'p' {
        # pointers have minimum width 11 (9 digits)
        width = max(width, 11);
        if n == 0 {
            return printf_nul_ptr(emit_char, width);
        }
        # non-null pointers always pad with zeros
        pad = '0';
    }

    # it's a 24-byte "array"!
    char* buf0 = null;
    char* buf1 = null;
    char* buf2 = null;
    char* buf = &buf0;
    int i = 0;

    if n == 0 {
        buf[i] = '0';
        i = i + 1;
    } else {
        char ten_digit = 'a' - 10;
        if conv_spec == 'X' {
            ten_digit = 'A' - 10;
        }

        # now stack it up
        while n != 0 {
            int d = n & 0xf;
            n = n >> 4;
            char c;
            if d < 10 { c = '0' + d; }
            else      { c = ten_digit + d; }
            buf[i] = c;
            i = i + 1;
        }
    }

    if pad != ' ' {
        int end = width - 2;
        while i < end {
            buf[i] = pad;
            i = i + 1;
        }
    }

    if conv_spec == 'X' {
        buf[i] = 'X';
    } else {
        buf[i] = 'x';
    }
    i = i + 1;
    buf[i] = '0';
    i = i + 1;

    if pad == ' ' {
        while i < width {
            buf[i] = ' ';
            i = i + 1;
        }
    }

    # and pop back off
    int count = i;
    while i > 0 {
        i = i - 1;
        emit_char(buf[i]);
    }

    return count;
}

pub fn printf_b__(bool value,
                  void* emit_char,
                  char conv_spec,
                  int width,
                  char pad) {
    char* str = "false";
    if value {
        str = "true";
    }
    return printf_s__(
        str,
        emit_char,
        's',
        width,
        pad);
}

pub fn printf_s__(char* str,
                  void* emit_char,
                  char conv_spec,
                  int width,
                  char pad) {
    # todo: padding
    int i = 0;
    while *str != null {
        emit_char(*str);
        str = str + 1;
        i = i + 1;
    }
    return i;
}
