# I am auto-resizing array-backed list structure. Elements are always 64-bit
# values with pass by value semantics. `ArrayList__new_owned` can if the
# elements are pointers to owned objects.
#
# The `push`, `peek`, and `pop` "methods" offer graceful use as a stack.

# struct ArrayList {
#   int capacity
#   int size
#   void** data
#   void* drop_el
#}

# I create a new list with the specified capacity.
pub fn ArrayList__new(int capacity) {
    return ArrayList__new_owned(capacity, null);
}

# I create a new list with the specified capacity, and function pointer for
# dropping elements.
pub fn ArrayList__new_owned(int capacity, void* drop_el) {
    if capacity < 4 { capacity = 4; }
    void* self = malloc(0x20);
    self = self + 0x8;              # -> size
    *self = 0;
    self = self + 0x8;              # -> data
    *self = null;
    self = self + 0x8;              # -> drop_el
    *self = drop_el;
    self = self - 0x18;             # -> capacity
    *self = capacity;
    return self;
}

# I return the number of elements current in the list.
pub fn ArrayList_size(void* self) {
    int* size = self + 0x8;         # -> size
    return *size;
}

# I add the passed element to the end of the list, extending it if needed.
pub fn ArrayList_push(void* self, void el) {
    int cap = *self;
    int* size = self + 0x8;         # -> size
    void** data = self + 0x10;      # -> data
    void* arr = *data;
    if arr == null {
        arr = malloc(cap * 0x8);
        *data = arr;
    }
    if *size == cap {
        # need more!
        cap = cap * 2;
        void* next = malloc(cap * 0x8);
        memcpy(next, arr, cap * 0x8)
        free(arr);
        *self = cap;
        *data = next;
        arr = next;
    }
    arr = arr + *size * 0x8;
    *arr = el;
    *size = *size + 1;
}

# I return the `i`th element in the list. If `i` < 0 or `i` >= size, panic.
pub fn ArrayList_get(void* self, int i) {
    if i < 0 { panic(-i, "Index out of bounds\n", 20); }
    if i >= ArrayList_size(self) { panic(i, "Index out of bounds\n", 20); }
    void** data = self + 0x10;      # -> data
    void* arr = *data;
    arr = arr + i * 0x8;
    return *arr;
}

# I consume the list and return a null-terminated array of its elements. The
# array may have unfreed capacity beyond the terminating null.
pub fn ArrayList_into_array(void* self) {
    void** data = self + 0x10;      # -> data
    if *data == null {
        # set capacity to one
        *self = 1;
    }
    ArrayList_push(self, null);
    data = self + 0x10;             # -> data
    data = *data;
    free(self);
    return data;
}

# I drop the list, along with its elements (if they are owned).
pub fn ArrayList_drop(void* self) {
    void* data = self + 0x10;       # -> data
    void* arr = *data;
    if arr == null {
        return free(self);
    }
    data = self + 0x18;             # -> drop_el
    void* drop_el = *data;
    if drop_el != null {
        data = self + 0x8;          # -> size
        int end = arr + *data * 0x8;
        int el = arr;
        while el < end {
            drop_el(*el);
            el = el + 0x8;
        }
    }
    free(arr);
    free(self);
}

# I remove and return the last element on the stack (in the list), panicking if
# the stack is empty.
pub fn ArrayList_pop(void* self) {
    void el = ArrayList_peek(self);
    int cap = *self;
    int* size = self + 0x8;         # -> size
    *size = *size - 1;
    if *size <= cap / 4 { if cap > 4 {
        # shrink
        cap = cap / 2;
        void* next = malloc(cap * 0x8);
        void** data = self + 0x10;  # -> data
        void arr = *data;
        memcpy(next, arr, cap * 0x8)
        free(arr);
        *self = cap;
        *data = next;
    } }
    return el;
}

# I return the last element on the stack (in the list), without removing it,
# panicking if the stack is empty.
pub fn ArrayList_peek(void* self) {
    int* size = self + 0x8;         # -> size
    if *size == 0 {
        panic(2, "No such element\n", 16);
    }
    void** data = self + 0x10;      # -> data
    void arr = *data;
    arr = arr + (*size - 1) * 0x8;
    return *arr;
}
