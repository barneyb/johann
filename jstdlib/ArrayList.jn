# I am auto-resizing array-backed list structure. Elements are always 64-bit
# values with pass by value semantics. `ArrayList__new_owned` can if the
# elements are pointers to owned objects.
#
# The `push`, `peek`, and `pop` "methods" offer graceful use as a stack.

struct StringBuilder;

# Storage for an ArrayList.
pub struct ArrayList {
    int capacity,
    int size,
    void** data,
    void* drop_el,
}

# I create a new list with the specified capacity.
pub fn ArrayList__new(int capacity) {
    return ArrayList__new_owned(capacity, null);
}

# I create a new list with the specified capacity, and function pointer for
# dropping elements.
pub fn ArrayList__new_owned(int capacity, void* drop_el) {
    if capacity < 4 { capacity = 4; }
    ArrayList* self = malloc(sizeof(ArrayList));
    self.capacity = capacity;
    self.size = 0;
    self.data = null;
    self.drop_el = drop_el;
    return self;
}

# I return the number of elements current in the list.
pub fn ArrayList_size(ArrayList* self) {
    return self.size;
}

# I add the passed element to the end of the list, extending it if needed.
pub fn ArrayList_push(ArrayList* self, void el) {
    int size = self.size;
    self.reserve(size + 1);
    void* idx = self.data + size * 0x8;
    *idx = el;
    self.size = size + 1;
}

# I reserve the given minimum capacity in the list, guaranteeing that no
# allocations will be required to if elements are added up to this size. Note
# that removing elements may reduce the list's capacity, reserved or not.
pub fn ArrayList_reserve(ArrayList* self, int min_capacity) {
    int cap = self.capacity;
    # use math, not iteration
    while cap < min_capacity {
        cap = cap * 2;
    }
    if self.data == null {
        self.data = malloc(cap * 0x8);
        self.capacity = cap;
        return;
    }
    if self.capacity < cap {
        void* next = malloc(cap * 0x8);
        memcpy(next, self.data, cap * 0x8);
        free(self.data);
        self.capacity = cap;
        self.data = next;
    }
}

# I add every element in the null-terminated `els` array to the end of the list,
# extending it if needed.
pub fn ArrayList_push_all(ArrayList* self, void* els) {
    if els == null { return; }
    int len = 0;
    void* el = els;
    while *el != null {
        len = len + 1;
        el = el + 0x8;
    }
    if len == 0 { return; }
    int size = self.size;
    self.reserve(size + len);
    memcpy(self.data + size * 0x8, els, len * 0x8);
    self.size = size + len;
}

# I return the `i`th element in the list. If `i` < 0 or `i` >= size, panic.
pub fn ArrayList_get(ArrayList* self, int i) {
    if i < 0 { panic(-i, "Index out of bounds\n", 20); }
    if i >= self.size() { panic(i, "Index out of bounds\n", 20); }
    void* arr = self.data;
    arr = arr + i * 0x8;
    return *arr;
}

# I consume the list and return a null-terminated array of its elements. The
# array may have unfreed capacity beyond the terminating null.
pub fn ArrayList_into_array(ArrayList* self) {
    if self.data == null {
        self.capacity = 1;
    }
    self.push(null);
    void* data = self.data;
    free(self);
    return data;
}

# I sort the list, in place, using the passed comparator function to define
# total order over the elements.
pub fn ArrayList_sort(ArrayList* self, void* cmp) {
    quicksort(self.data, 0, self.size() - 1, cmp);
}

# I render the list to a null-terminated byte string, using the passed function
# to convert each element in turn. If `null` is passed, the elements are assumed
# to be NTBSs, to be included in the final string directly. The returned string
# must be `free`-ed by the client. The list is not consumed.
pub fn ArrayList_to_string(ArrayList* self, void* el_to_string) {
    int l = self.size();
    if l == 0 {
        return strclone("[]");
    }
    StringBuilder* sb = StringBuilder__new(l);
    sb.push('[');
    int i = 0;
    while i < l {
        if i > 0 {
            sb.push(',');
        }
        void* el = self.get(i);
        if el_to_string != null {
            el = el_to_string(el, null);
        }
        sb.push_str(el);
        if el_to_string != null {
            free(el);
        }
        i = i + 1;
    }
    sb.push(']');
    return sb.into_chars();
}

# I drop the list, along with its elements (if they are owned).
pub fn ArrayList_drop(ArrayList* self) {
    void* arr = self.data;
    if arr == null {
        return free(self);
    }
    void* drop_el = self.drop_el;
    if drop_el != null {
        int end = arr + self.size * 0x8;
        int el = arr;
        while el < end {
            drop_el(*el);
            el = el + 0x8;
        }
    }
    free(arr);
    free(self);
}

# I remove and return the last element on the stack (in the list), panicking if
# the stack is empty.
pub fn ArrayList_pop(ArrayList* self) {
    void el = self.peek();
    int cap = self.capacity;
    int size = self.size - 1;
    self.size = size;
    if size <= cap / 4 { if cap > 4 {
        # shrink
        cap = cap / 2;
        void* next = malloc(cap * 0x8);
        void arr = self.data;
        memcpy(next, arr, cap * 0x8);
        free(arr);
        self.capacity = cap;
        self.data = next;
    } }
    return el;
}

# I return the last element on the stack (in the list), without removing it,
# panicking if the stack is empty.
pub fn ArrayList_peek(ArrayList* self) {
    if self.size < 1 {
        panic(2, "No such element\n", 16);
    }
    void arr = self.data;
    arr = arr + (self.size - 1) * 0x8;
    return *arr;
}
