pub fn main() {
    char* f_start = "\nTEST %s:\n";
    char* f_end = "/%s\n";
    char* name;

    name = "reuse"; printf(f_start, name);
    reuse();
    printf(f_end, name);
}

fn reuse() {
    int len = 8;
    int** addrs = new_array(len);
    int* end = addrs + 0x40;
    int n;
    printf("start of array: %p\n", addrs % 0x1000);

    int* a = malloc(len);
    printf("new alloc: %p\n", a % 0x1000);
    if a < end {
        printf("expected %p to be >= %p\n", a, end);
        exit(a);
    }
    free(a); a = null;

    int* a_i = addrs + 0x20; # addrs[4]
    printf("addrs[4]: %p\n", a_i % 0x1000);
    a = *a_i;
    printf("ptr @ addrs[4]: %p\n", a % 0x1000);
    *a_i = null;
    free(a);
    a_i = a;
    printf("free-d addrs[4]: %p\n", a_i % 0x1000);
    a = malloc(len);
    printf("allocate for reuse: %p\n", a % 0x1000);
    if a != a_i {
        printf("expected %p to be = %p\n", a, a_i);
        char* f = "  next alloc is %p\n";
        printf(f, malloc(len));
        printf(f, malloc(len));
        printf(f, malloc(len));
        exit(a);
    }
    *a_i = null;
    free(a); a = null;

    a_i = *addrs;
    printf("ptr @ addrs[0]: %p\n", a_i % 0x1000);

    # clean up...
    drop_array(addrs, len);

    a = malloc(len);
    printf("allocate for reuse: %p\n", a % 0x1000);
    if a == addrs {
        printf("Reused oversized %p?!\n", addrs);
    }
    if a != a_i {
        printf("Expected reuse of %p, not %p\n", a_i, a);
    }
    free(a);
}

fn new_array(int len) {
    printf("{NEW: alloc %i slots\n", len);
    int n = len * 0x8;
    void* addrs = malloc(n); # addrs = int[len]
    printf("  ARRAY> %p\n", addrs % 0x1000);
    int i = 0;
    char* f = "    NEW> %p\n";
    while i < len {
        n = i * 0x8;
        int a_i = addrs + n;
        *a_i = malloc(len);
        n = *a_i;
        n = n % 0x1000;
        printf(f, n);
        i = i + 1;
    }
    puts("    NEW complete!\n}");
    return addrs;
}

fn drop_array(void* addrs, int len) {
    int n = addrs % 0x1000;
    printf("{DROP: free %i slots at %p\n", len, n);
    n = len * 0x8;
    int a_i = addrs + n;
    char* f = "    DROP> %p\n";
    while a_i > addrs {
        a_i = a_i - 0x8;
        n = *a_i;
        if n != null {
            free(n);
            n = n % 0x1000;
            printf(f, n);
        }
        if n == null {
            char* g = "    <ALREADY DROPPED>";
            puts(g);
        }
    }
    free(addrs);
    printf("   ARRAY> %p\n", addrs % 0x1000);
    puts("    DROP complete!\n}");
}
