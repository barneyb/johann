char* prompt = "Name: ";
char* hello = "Hello, ";
char* world = "world";
char* punct = "!";

fn main(int a, char** g) {
    char* b;
    bool d = a > 1;
    bool f = true;
    if !d {
        b = getname();
        f = b = world;
    }
    if d {
        # first argument is second element
        g = g + 8;
        b = *g;
    }
    char* c = hello;
    print(c);
    print(b);
    if !f {
        free(b);
    }
    b = punct;
    println(b);
}

fn getname() -> char* {
    char* b = prompt;
    print(b);
    # read
    int a = 20;
    b = malloc(a);
    a = a - 1; # ensure room for the null byte
    char* d = b;
    int e = -1; # EOF
    char c = read();
    while c > e {
        if a > 0 { # no overflow!
            if c > 31 {
                if c < 127 {
                    # printable!
                    storeb(d, c); # kludge!
                    d = d + 1;
                    a = a - 1;
                }
            }
        }
        c = read();
    }
    if b = d {
        # read zero bytes - use default
        b = world;
        return b;
    }
    # trailing null byte
    c = 0;
    storeb(d, c);
    return b;
}
