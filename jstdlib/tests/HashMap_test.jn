fn free(void*);
fn strcmp(char*, char*);
fn strhash(char*);

struct HashMap;
struct Keys;
struct StringBuilder;

fn inthash(int i) { return i; }
fn intcmp(int a, int b) { return a - b; }

pub fn main() {
    basics();
    delete_collisions();
    owned_keys();
    owned_values();
}

fn basics() {
    puts("\nbasics:");
    HashMap* m = HashMap__new(null, null);
    size(m);
    put(m, 0, "zero");
    put(m, 7, "seven");
    put(m, 15, "fifteen"); # to collide with zero
    check(m, 0);
    check(m, 2);
    check(m, 7);
    check(m, 12);
    check(m, 15);
    five_keys(m);

    puts("\nhugify");
    hugify(m);
    size(m);
    check(m, 0);
    check(m, 7);
    check(m, 12);
    check(m, 15);
    check(m, 1234);

    puts("\ndelete seven");
    delete(m, 7);
    size(m);
    delete(m, 7);
    size(m);

    puts("\nsmallify");
    smallify(m);
    size(m);
    check(m, 0);
    check(m, 12);
    check(m, 15);
    check(m, 1234);
    five_keys(m);

    m.drop();
}

fn delete_collisions() {
    puts("\ndelete_collisions:");
    HashMap* m = HashMap__new(&inthash, &intcmp);
    put(m, 0, "zero");
    put(m, 7, "seven");
    put(m, 15, "fifteen"); # to collide with zero
    delete(m, 0);
    delete(m, 0);
    put(m, 0, "zero");
    delete(m, 0);
    delete(m, 0);
    m.drop();

    m = HashMap__new(null, null);
    put(m, 0, "zero");
    put(m, 7, "seven");
    put(m, 15, "fifteen"); # to collide with zero
    delete(m, 15);
    delete(m, 15);
    put(m, 15, "fifteen");
    delete(m, 15);
    delete(m, 15);
    m.drop();
}

fn hugify(HashMap* m) {
    int i = 1000;
    while i < 2000 {
        m.put(i, "big");
        i = i + 1;
    }
}

fn smallify(HashMap* m) {
    int i = 1000;
    while i < 2000 {
        m.delete(i);
        i = i + 1;
    }
}

fn put(HashMap* m, int key, char* value) {
    m.put(key, value);
    size(m);
}

fn delete(HashMap* m, int key) {
    printf("contains %d? %b\n", key, m.contains(key));
    char* v = m.delete(key);
    if v == null {
        printf("  delete %d: null\n", key);
        return;
    }
    printf("  delete %d: '%s'\n", key, v);
}

fn check(HashMap* m, int key) {
    printf("contains %d? %b\n", key, m.contains(key));
    char* v = m.get(key);
    if v == null {
        printf("     get %d: null\n", key);
        return;
    }
    printf("     get %d: '%s'\n", key, v);
}

fn owned_keys() {
    puts("\nowned_keys:");
    HashMap* m = HashMap__new_owned(&strhash, &strcmp, &free, null);
    m.put(strclone("one"), 1);
    m.put(strclone("two"), 2);
    m.put(strclone("three"), 3);
    printf("size: %d\n", m.size());
    int i = 55;
    while i < 85 {
        StringBuilder* sb = StringBuilder__new(10);
        sb.push_str("el ");
        char* s = itoa(i);
        sb.push_str(s);
        free(s);
        m.put(sb.into_chars(), i);
        i = i + 1;
    }
    printf("size: %d\n", m.size());
    printf("get    'el 68': %d\n", m.get("el 68"));
    printf("delete 'el 69': %d\n", m.delete("el 69"));
    printf("size: %d\n", m.size());
    printf("put    'el 70': %d\n", m.put(strclone("el 70"), 99999));
    printf("get    'el 70': %d\n", m.get("el 70"));
    printf("size: %d\n", m.size());
    m.drop();
}

fn owned_values() {
    puts("\nowned_values:");
    HashMap* m = HashMap__new_owned(&inthash, &intcmp, null, &free);
    m.put(1, strclone("one"));
    m.put(2, strclone("two"));
    m.put(3, strclone("three"));
    m.put(4, strclone("four"));
    size(m);
    void* old;
    int i = 0;
    while i < 20 {
        StringBuilder* sb = StringBuilder__new(10);
        sb.push_str("el ");
        char* s = itoa(i);
        sb.push_str(s);
        free(s);
        old = m.put(i * 4, sb.into_chars());
        if old != null { free(old); }
        i = i + 1;
    }
    size(m);
    printf("get 0: '%s'\n", m.get(0));
    printf("get 4: '%s'\n", m.get(4));
    printf("get 32: '%s'\n", m.get(32));
    old = m.delete(2);
    printf("delete 2: '%s'\n", old);
    free(old);
    size(m);
    old = m.delete(2);
    printf("delete 2: %x\n", old);
    size(m);
    m.drop();
}

fn size(HashMap* m) {
    int s = m.size();
    printf("size: %d :: ", s);
    keys(m);
}

fn five_keys(HashMap* m) {
    printf("five ");
    keys(m);
}

fn keys(HashMap* m) {
    printf("keys: [");
    int i = 0;
    Keys* ks = m.keys();
    while i < 5 {
        void* k = ks.next();
        if k == null { done; }
        printf("%d, ", *k);
        i = i + 1;
    }
    ks.drop();
    puts("]");
}
