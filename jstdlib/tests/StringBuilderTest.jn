pub fn main() {
    int n;
    n = 14; build_up_to(n);
    n = 15; build_up_to(n);
    n = 16; build_up_to(n);
    n = 17; build_up_to(n);

    void* sb = StringBuilder__new(1);
    # catch buffer overrun
    char* after = malloc(1);
    StringBuilder_push_str(sb, "qwertyuiop");
    StringBuilder_push_str(sb, "qwertyuiop");
    StringBuilder_push_str(sb, "qwertyuiop");
    free(after);
    char* str = StringBuilder_into_chars(sb);
    puts(str);
    free(str);
}

fn build_up_to(int count) {
    int cap = 16;
    char* prefix = malloc(cap);
    void* buf = StringBuilder__new(cap);
    char* middle = malloc(cap);
    while count > 0 {
        char c = 'a' + count;
        c = c - 1;
        count = count - 1;
        StringBuilder_push(buf, c);
    }
    char* str = StringBuilder_into_chars(buf);
    char* suffix = malloc(cap);

    free(prefix);
    free(middle);
    middle = "%s: %i\n";
    cap = strlen(str);
    printf(middle, str, cap);
    free(str);
    free(suffix);
}
