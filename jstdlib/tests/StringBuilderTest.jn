struct StringBuilder;

pub fn main() {
    puts("build up...");
    int n;
    n = 14; build_up_to(n);
    n = 15; build_up_to(n);
    n = 16; build_up_to(n);
    n = 17; build_up_to(n);
    n = 18; build_up_to(n);

    puts("\ninto int...");
    StringBuilder* sb = StringBuilder__new(1);
    sb.push_str("123");
    printf("'123': %d\n", sb.into_int());
    sb = StringBuilder__new(1);
    sb.push_str("-456");
    printf("'-456': %d\n", sb.into_int());
    sb = StringBuilder__new(1);
    sb.push_str("789");
    printf("'+789': %d\n", sb.into_int());

    puts("\noverruns...");
    sb = StringBuilder__new(1);
    # catch buffer overrun
    char* after = malloc(1);
    sb.push_str("qwertyuiop");
    sb.push_str("qwertyuiop");
    sb.push_str("qwertyuiop");
    free(after);
    char* str = sb.into_chars();
    puts(str);
    free(str);
}

fn build_up_to(int count) {
    int cap = 16;
    char* prefix = malloc(cap);
    void* buf = StringBuilder__new(cap);
    char* middle = malloc(cap);
    while count > 0 {
        char c = 'a' + count;
        c = c - 1;
        count = count - 1;
        StringBuilder_push(buf, c);
    }
    count = StringBuilder_length(buf);
    char* str = StringBuilder_into_chars(buf);
    char* suffix = malloc(cap);

    free(prefix);
    free(middle);
    middle = "%s: %i / %i\n";
    cap = strlen(str);
    printf(middle, str, cap, count);
    free(str);
    free(suffix);
}
