pub int MAX_INTEGER;
pub int MIN_INTEGER;

pub fn main() {
    test_MIN();
    test_MAX();
    test_abs();
    test_min();
    test_max();
    test_pow();
}

fn test_MIN() {
    puts("\nMIN:");
    int min = pow(-2, 63);
# todo: can't actually print MIN_INTEGER...
    puts("Can't actually print MIN_INTEGER...");
#    printf("-2^63      : %d (%x)\n", min, min);
#    printf("MIN_INTEGER: %d (%x)\n", MIN_INTEGER, MIN_INTEGER);
    printf("is MIN correct? %b\n", MIN_INTEGER == min);
    printf("is MIN correct? %b\n", MIN_INTEGER == MAX_INTEGER + 1);
}

fn test_MAX() {
    puts("\nMAX:");
    int max = pow(2, 63) - 1;
    printf("2^63 - 1   : %d (%x)\n", max, max);
    printf("MAX_INTEGER: %d (%x)\n", MAX_INTEGER, MAX_INTEGER);
    printf("is MAX correct? %b\n", MAX_INTEGER == max);
}

fn test_abs() {
    puts("\nabs:");
    abs_one(1);
    abs_one(-1);
    abs_one(0);
    abs_one(MAX_INTEGER);
#    abs_one(MIN_INTEGER); # todo: please fix printf
}

fn abs_one(int n) {
    printf("abs(%d) : %d\n", n, abs(n));
}

fn test_min() {
    puts("\nmin:");
    min_one(0, 0);
    min_one(0, 1);
    min_one(1, 0);
    min_one(0, -1);
    min_one(-1, 0);
}

fn min_one(int a, int b) {
    printf("min(%d, %d) : %d\n", a, b, min(a, b));
}

fn test_max() {
    puts("\nmax:");
    max_one(0, 0);
    max_one(0, 1);
    max_one(1, 0);
    max_one(0, -1);
    max_one(-1, 0);
}

fn max_one(int a, int b) {
    printf("max(%d, %d) : %d\n", a, b, max(a, b));
}

fn test_pow() {
    puts("\npow:");
    pow_one(0, 0);
    pow_one(0, 1);
    pow_one(1, 0);
    pow_one(5, 0);
    pow_one(0, 5);
    pow_one(2, 1);
    pow_one(2, 2);
    pow_one(2, 3);
    pow_one(1, 3);
}

fn pow_one(int a, int b) {
    printf("pow(%d, %d) : %d\n", a, b, pow(a, b));
}
