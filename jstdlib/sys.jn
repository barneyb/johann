# Functions for interacting with the underlying operating system. `syscall` is
# the magic sledgehammer, since Johann's pretty thin on wrappers.

# Terminate the process, with the given exit status.
pub fn exit(int status);

# Print a character buffer to STDERR and terminate processing, as if by `exit`.
pub fn panic(int status, char* buf, int nbytes);

# Make an arbitrary system call, by number. All additional arguments passed will
# be moved forward one "slot", so the second argument passed to `syscall` will
# be the first argument passed to the kernel.
pub fn syscall(int number);

# todo: use count/width
pub fn quicksort_half_open(void* arr, int lo, int hi, void* cmp) {
    # todo: protection for quadratic runtime when largely sorted
    if lo < hi - 1 {
        int p = qsort_part(arr, lo, hi, cmp);
        quicksort_half_open(arr,    lo, p + 1, cmp);
        quicksort_half_open(arr, p + 1,    hi, cmp);
    }
}

fn qsort_part(void* arr, int lo, int hi, void* cmp) {
    void pivot = arr[lo];
    # start just outside the target range
    int l = lo - 1;
    int r = hi;
    while true {
        # move left index to the right at least once
        while true {
            l = l + 1;
            if cmp(arr[l], pivot) >= 0 { done; }
        }
        # and same for right index
        while true {
            r = r - 1;
            if cmp(arr[r], pivot) <= 0 { done; }
        }
        # if they crossed, partitioning is complete
        if l >= r { return r; }

        # swap the two elements and keep going
        void* t = arr[l];
        arr[l] = arr[r];
        arr[r] = t;
    }
}
