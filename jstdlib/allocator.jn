fn find_free_chunk(int bytes) {
#    printf(" Looking for free %x\n", bytes);
    void free_list = free_list_for(bytes);
    if *free_list == null {
#        puts("   No free chunks!");
        return null;
    }
    void curr = *free_list; # pointer -> a chunk
#    printf("  CURR %p\n", curr);
    int a;
    while curr != null {
        a = curr - 0x8;
        int size = *a; # size of chunk
#        printf("   FREE: %x bytes at %p\n", size, curr);
        if bytes <= size {
            # big enough
            done;
        }
        a = curr + 0x8;
        curr = *a; # next chunk
    }
    if curr == null {
        # didn't find one
#        printf("   No free chunk >= %x bytes\n", bytes);
        return null;
    }
    # unlink and return the chunk's address
#    printf("   Recycle %x byte chunk at %p\n", size, curr);
    void prev = *curr;
    a = curr + 0x8;
    void next = *a;
    if curr == *free_list {
        *free_list = next; # null or not
    }
#    printf("   CURR %p is preceded by %p and succeeded by %p\n", curr, prev, next);
    if next != null {
        *next = prev;
    }
    if prev != null {
        prev = prev + 0x8;
        *prev = next;
    }
#    print_free_list(*free_list);
    return curr;
}

# Allocate memory for an array of `num` elements, each `width` bytes wide,
# initialize each byte to zero, and return a pointer to the first byte. The same
# pointer must be passed back to `free` at some point.
pub fn calloc(int num, int width) {
    int bytes = align(num * width, MALLOC_ALIGN);
    void* mem = malloc(bytes);
    void* end = mem + bytes;
    while end > mem {
        end = end - sizeof(void);
        *end = null;
    }
    return mem;
}

# Allocate (at least) the specified number of bytes of memory and return a
# pointer to it. The same pointer must be passed back to `free` at some point.
pub fn malloc(int bytes) {
#    printf("\n\nmalloc(%x)\n", bytes);
    if bytes <= 0 {
        if bytes == 0 {
            return null;
        }
        eprintf("Negative-byte (%d) malloc?!\n", bytes);
        exit(88);
    }

    bytes = align(bytes, MALLOC_ALIGN);

    # first, see if there's a free chunk to recycle
    void mem = find_free_chunk(bytes);

    if mem == null {
        # need to allocate a new chunk
        # first, see if we need to get more from the OS
        mem = HEAP_TOP;
        int thru = mem + bytes;
        thru = thru + 0x8; # for the header
        if HEAP_END < thru {
            get_more_memory(bytes + 0x8);
            mem = HEAP_TOP;
        }

        # then, allocate a chunk at the top of the heap
        *mem = bytes; # the header
        mem = mem + 0x8; # user chunk
        HEAP_TOP = mem + bytes;
#            printf(" ; new %x byte chunk\n", bytes);
        STAT_CHUNK_COUNT = STAT_CHUNK_COUNT + 1;
        STAT_CHUNK_SIZE = STAT_CHUNK_SIZE + bytes;
        track_by_size(bytes, chunks);
    }
    int chunk_size = mem - 0x8;
    chunk_size = *chunk_size;

#        int waste = chunk_size - bytes;
#        if waste == 0 {
#            printf(" ; alloc %x bytes at %p\n", bytes, mem);
#        } else {
#            printf(" ; alloc %x bytes at %p (waste %x)\n", bytes, mem, waste);
#        }

    STAT_ALLOC_COUNT = STAT_ALLOC_COUNT + 1;
    # Only 'bytes` were requested, but the chunk size is what free can correlate
    # with, so that's what gets recorded.
    STAT_ALLOC_SIZE = STAT_ALLOC_SIZE + chunk_size;
    track_by_size(bytes, allocs);
    return mem;
}

fn align(int bytes, int alignment) {
    # todo: bitwise ops would be nice...
    int remainder = bytes % alignment;
    if remainder != 0 {
        bytes = bytes - remainder;
        bytes = bytes + alignment;
    }
    return bytes;
}

fn get_more_memory(int bytes) {
#        char* f = "get_more_memory(%x)\n";
#        eprintf(f, bytes);
    bytes = align(bytes, PAGE_SIZE);
#        f = "  -> get_more_memory(%x)\n";
#        eprintf(f, bytes);
    void at = HEAP_END;
    void mem = mmap_internal(at, bytes);
    if mem == null {
        panic(99, "ERROR: Failed to allocate\n", 26);
    }

#        f = "  -> got %x bytes @ %p (%x total)\n";
#        int aln = HEAP_END - HEAP_START;
#        aln = aln + bytes;
#        eprintf(f, bytes, mem, aln);

    if HEAP_START == HEAP_END {
        HEAP_START = mem; # this was the first page
    }
    HEAP_TOP = mem;
    HEAP_END = mem + bytes;
    STAT_MMAP_COUNT = STAT_MMAP_COUNT + 1;
    STAT_MMAP_SIZE = STAT_MMAP_SIZE + bytes;
}

fn mmap_internal(void at, int bytes) {
    return sys_mmap(at, bytes, MMAP_PROTO, MMAP_FLAGS, -1, 0);
}
