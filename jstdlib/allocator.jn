int MALLOC_ALIGN= 0x10;
int PAGE_SIZE   = 0x4000;
int MAP_ANON    = 0x1000;
int MAP_PRIVATE = 2;
int PROT_READ   = 1;
int PROT_WRITE  = 2;

void START = 0;
void CURR = 0;
void END = 0;

int ALLOC_STAT_COUNT = 0;
int ALLOC_STAT_SIZE = 0;
int FREE_STAT_COUNT = 0;
int FREE_STAT_SIZE = 0;

fn mem_stats__() {
    int ac = ALLOC_STAT_COUNT;
    int as = ALLOC_STAT_SIZE;
    int fc = FREE_STAT_COUNT;
    int fs = FREE_STAT_SIZE;
    bool c = ac ! fc;
    bool s = as ! fs;
    if c + s {
        char* format = "; MEM: %d allocs (%x bytes)\n;      %d frees  (%x bytes)\n";
        printf(format, ac, as, fc, fs);
    }
}

fn free(void* mem) {
    if mem = null {
        return 0;
    }
    # load the size/bytes from the header
    mem = mem - 0x8;
    int bytes = *mem;
#        char* f = " ; free  %x bytes at %p\n";
#        mem = mem + 0x8;
#        printf(f, bytes, mem);
    FREE_STAT_COUNT = FREE_STAT_COUNT + 1;
    FREE_STAT_SIZE = FREE_STAT_SIZE + bytes;


    # todo /* 73 - int munmap(caddr_t addr, size_t len) */
}

fn malloc(int bytes) {
    int aln = MALLOC_ALIGN;
    bytes = align(bytes, aln);

    void mem = CURR;
    int thru = mem + bytes;
    thru = thru + 0x8; # for the header
    if END < thru {
        get_more_memory(bytes);
        mem = CURR;
    }

    # the header
    *mem = bytes;
    mem = mem + 0x8;
#    bytes = bytes + 0x8;

#        char* f = " ; alloc %x bytes at %p\n";
#        printf(f, bytes, mem);

    CURR = mem + bytes;
    ALLOC_STAT_COUNT = ALLOC_STAT_COUNT + 1;
    ALLOC_STAT_SIZE = ALLOC_STAT_SIZE + bytes;
    return mem;
}

fn align(int bytes, int alignment) {
    # todo: bitwise ops would be nice...
    int remainder = bytes % alignment;
    if remainder ! 0 {
        bytes = bytes - remainder;
        bytes = bytes + alignment;
    }
    return bytes;
}

fn get_more_memory(int bytes) {
#        char* f = "get_more_memory(%x)\n";
#        eprintf(f, bytes);
    int aln = PAGE_SIZE;
    bytes = align(bytes, aln);
#        f = "  -> get_more_memory(%x)\n";
#        eprintf(f, bytes);
    void at = END;
    void mem = mmap_internal(at, bytes);
    if mem = null {
        failed_to_mmap();
    }

#        f = "  -> got %x bytes @ %p (%x total)\n";
#        aln = END - START;
#        aln = aln + bytes;
#        eprintf(f, bytes, mem, aln);

    if START = END {
        START = mem; # this was the first page
    }
    CURR = mem;
    END = mem + bytes;
}

fn mmap_internal(void at, int bytes) {
    # todo: having to use vars for constants is sorta silly...
    int protocol = PROT_READ + PROT_WRITE;
    int flags = MAP_ANON + MAP_PRIVATE;
    int negOne = -1;
    int zero = 0;
    return sys_mmap(at, bytes, protocol, flags, negOne, zero);
}

fn failed_to_mmap() {
    int err = 99;
    char* msg = "ERROR: Failed to allocate\n";
    int len = strlen(msg);
    panic(err, msg, len);
}
