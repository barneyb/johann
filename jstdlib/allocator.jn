# Dynamic memory functions. Eventually, these will go away in favor of `new`/`drop`
# or something. And hopefully be taken over by the compiler itself, so programmers
# can't screw it up. We'll see.

int MALLOC_ALIGN= 0x10;
int PAGE_SIZE   = 0x4000;
int MAP_ANON    = 0x1000;
int MAP_PRIVATE = 2;
int PROT_READ   = 1;
int PROT_WRITE  = 2;

void HEAP_START = null;
void HEAP_TOP = null;
void HEAP_END = null;

void FREE_LIST = null;

int STAT_MMAP_COUNT = 0;
int STAT_MMAP_SIZE = 0;
int STAT_CHUNK_COUNT = 0;
int STAT_CHUNK_SIZE = 0;
int STAT_ALLOC_COUNT = 0;
int STAT_ALLOC_SIZE = 0;
int STAT_FREE_COUNT = 0;
int STAT_FREE_SIZE = 0;

pub fn mem_stats__() {
    int ac = STAT_ALLOC_COUNT;
    int as = STAT_ALLOC_SIZE;
    int fc = STAT_FREE_COUNT;
    int fs = STAT_FREE_SIZE;
    bool c = ac ! fc;
    bool s = as ! fs;
    if c + s {
        char* format = "; MEM: %d allocs (%x bytes)\n;      %d frees  (%x bytes)\n";
        printf(format, ac, as, fc, fs);
        eprintf(format, ac, as, fc, fs);
        format = ";      %d chunks (%x bytes)\n;      %d mmaps  (%i pages)\n";
        ac = STAT_CHUNK_COUNT;
        as = STAT_CHUNK_SIZE;
        fc = STAT_MMAP_COUNT;
        fs = STAT_MMAP_SIZE;
        fs = fs / PAGE_SIZE;
        printf(format, ac, as, fc, fs);
        eprintf(format, ac, as, fc, fs);
    }
}

# Free the allocation pointed to by the passed pointer, previously returned from
# `malloc`. A null pointer may be "freed" as a no-op.
pub fn free(void* mem) {
    if mem = null {
        return null;
    }
    # load the size/bytes from the header
    int a = mem - 0x8;
    int bytes = *a;

#        printf(" ; free  %x bytes at %p\n", bytes, mem);

    if bytes = 0 {
        eprintf("Zero-byte free at %p. First quadword of chunk: %x\n", mem, *mem);
        a = mem - 0x10; # go back to last quadword of prev chunk
        eprintf("  Last quadword of prev chunk: %x\n", *a);
        exit(88);
    }

    STAT_FREE_COUNT = STAT_FREE_COUNT + 1;
    STAT_FREE_SIZE = STAT_FREE_SIZE + bytes;

    # header remains "len"
    # first quad is "prev" pointer
    # second quad is "next" pointer

    void next = FREE_LIST;
    void prev = null;
    while next ! null {
        if mem = next {
            # already in the free list?!
            exit(98);
        }
        int bs = next - 0x8;        # -> len
        bs = *bs;
        if bs < bytes {
            prev = next;
            next = next + 0x8;      # -> next
            next = *next;
            again;
        }
        done;
    }

    *mem = prev;
    if prev = null {
        FREE_LIST = mem;
    }
    if prev ! null {
        prev = prev + 8;
        *prev = mem;
    }
    if next ! null {
        *next = mem;
    }
    mem = mem + 8;
    *mem = next;

#        print_free_list();


    # todo /* 73 - int munmap(caddr_t addr, size_t len) */
}

fn print_free_list() {
    void curr = FREE_LIST;
    printf("[FREE LIST: %p\n", curr);
    while curr ! null {
        curr = curr - 0x8;
        int bytes = *curr;
        curr = curr + 0x10;
        void* next = *curr;
        curr = curr - 0x8;
        void* prev = *curr;
        printf("  -> %x bytes at %p < %p : %p >\n", bytes, curr, prev, next);
        curr = next;
    }
    puts("]");
}

fn find_free_chunk(int bytes) {
#    char* f;
    if FREE_LIST = null {
#            f = "   No free chunks!";
#            puts(f);
        return null;
    }
    void curr = FREE_LIST; # pointer -> a chunk
#        f = "   CURR %p\n";
#        printf(f, curr);
    int a;
    while curr ! null {
        a = curr - 0x8;
        int size = *a; # size of chunk
#            f = "   FREE: %x bytes at %p\n";
#            printf(f, size, curr);
        # todo: <= sure would be nice...
        if bytes > size {
            curr = *curr; # pointer -> previous chunk
            again;
        }
        done;
    }
    if curr = null {
        # didn't find one
#            f = "   No free chunk >= %x bytes\n";
#            printf(f, bytes);
        return null;
    }
    # unlink and return the chunk's address
#        f = "   Recycle %x byte chunk at %p\n";
#        printf(f, size, curr);
    void prev = *curr;
    a = curr + 0x8;
    void next = *a;
    if curr = FREE_LIST {
        FREE_LIST = next; # null or not
    }
#        f = "   CURR %p is preceded by %p and succeeded by %p\n";
#        printf(f, curr, prev, next);
    if next ! null {
        *next = prev;
    }
    if prev ! null {
        prev = prev + 0x8;
        *prev = next;
    }
    return curr;
}

# Allocate (at least) the specified number of bytes of memory and return a
# pointer to it. The same pointer must be passed back to `free` at some point.
pub fn malloc(int bytes) {
    int aln = MALLOC_ALIGN;
    bytes = align(bytes, aln);

    # first, see if there's a free chunk to recycle
    void mem = find_free_chunk(bytes);

    if mem = null {
        # need to allocate a new chunk
        # first, see if we need to get more from the OS
        mem = HEAP_TOP;
        int thru = mem + bytes;
        thru = thru + 0x8; # for the header
        if HEAP_END < thru {
            get_more_memory(bytes);
            mem = HEAP_TOP;
        }

        # then, allocate a chunk at the top of the heap
        *mem = bytes; # the header
        mem = mem + 0x8; # user chunk
        HEAP_TOP = mem + bytes;
#            f = " ; new %x byte chunk\n";
#            printf(f, bytes);
        STAT_CHUNK_COUNT = STAT_CHUNK_COUNT + 1;
        STAT_CHUNK_SIZE = STAT_CHUNK_SIZE + bytes;
    }
    int chunk_size = mem - 0x8;
    chunk_size = *chunk_size;

#        if chunk_size = bytes {
#            printf(" ; alloc %x bytes at %p\n", chunk_size, mem);
#        }
#        if chunk_size ! bytes {
#            int waste = chunk_size - bytes;
#            printf(" ; alloc %x bytes at %p (waste %x)\n", chunk_size, mem, waste);
#        }
#        if FREE_LIST ! null {
#            print_free_list();
#        }

    STAT_ALLOC_COUNT = STAT_ALLOC_COUNT + 1;
    # Only 'bytes` were requested, but the chunk size is what free can correlate
    # with, so that's what gets recorded.
    STAT_ALLOC_SIZE = STAT_ALLOC_SIZE + chunk_size;
    return mem;
}

fn align(int bytes, int alignment) {
    # todo: bitwise ops would be nice...
    int remainder = bytes % alignment;
    if remainder ! 0 {
        bytes = bytes - remainder;
        bytes = bytes + alignment;
    }
    return bytes;
}

fn get_more_memory(int bytes) {
#        char* f = "get_more_memory(%x)\n";
#        eprintf(f, bytes);
    int aln = PAGE_SIZE;
    bytes = align(bytes, aln);
#        f = "  -> get_more_memory(%x)\n";
#        eprintf(f, bytes);
    void at = HEAP_END;
    void mem = mmap_internal(at, bytes);
    if mem = null {
        failed_to_mmap();
    }

#        f = "  -> got %x bytes @ %p (%x total)\n";
#        aln = HEAP_END - HEAP_START;
#        aln = aln + bytes;
#        eprintf(f, bytes, mem, aln);

    if HEAP_START = HEAP_END {
        HEAP_START = mem; # this was the first page
    }
    HEAP_TOP = mem;
    HEAP_END = mem + bytes;
    STAT_MMAP_COUNT = STAT_MMAP_COUNT + 1;
    STAT_MMAP_SIZE = STAT_MMAP_SIZE + bytes;
}

fn mmap_internal(void at, int bytes) {
    # todo: having to use vars for constants is sorta silly...
    int protocol = PROT_READ + PROT_WRITE;
    int flags = MAP_ANON + MAP_PRIVATE;
    int negOne = -1;
    int zero = 0;
    return sys_mmap(at, bytes, protocol, flags, negOne, zero);
}

fn failed_to_mmap() {
    int err = 99;
    char* msg = "ERROR: Failed to allocate\n";
    int len = strlen(msg);
    panic(err, msg, len);
}
