# Dynamic memory functions. Eventually, these will go away in favor of `new`/`drop`
# or something. And hopefully be taken over by the compiler itself, so programmers
# can't screw it up. We'll see.

int MALLOC_ALIGN= 0x10;
int PAGE_SIZE   = 0x4000;
int MMAP_FLAGS  = 0x1000 + 2; # MAP_ANON + MAP_PRIVATE
int MMAP_PROTO  = 1 + 2;      # PROT_READ + PROT_WRITE

void HEAP_START = null;
void HEAP_TOP   = null;
void HEAP_END   = null;

void FREE_LIST  = null;

int STAT_MMAP_COUNT  = 0;
int STAT_MMAP_SIZE   = 0;
int STAT_CHUNK_COUNT = 0;
int STAT_CHUNK_SIZE  = 0;
int STAT_ALLOC_COUNT = 0;
int STAT_ALLOC_SIZE  = 0;
int STAT_FREE_COUNT  = 0;
int STAT_FREE_SIZE   = 0;

pub fn mem_stats__(bool force) {
    int ac = STAT_ALLOC_COUNT;
    int as = STAT_ALLOC_SIZE;
    int fc = STAT_FREE_COUNT;
    int fs = STAT_FREE_SIZE;
    bool c = fc - ac;
    bool s = fs - as;
    bool doit = force;
    if c + s {
        force = false;
        doit = true;
    }
    if doit {
        char* format = "; MEM: %d allocs (%x bytes)\n;      %d frees  (%x bytes) [%d : %x bytes]\n";
        if !force {
            # if not forced, send to STDOUT too
            printf(format, ac, as, fc, fs, c, s);
        }
        eprintf(format, ac, as, fc, fs, c, s);
        format = ";      %d chunks (%x bytes)\n;      %d mmaps  (%i pages)\n";
        ac = STAT_CHUNK_COUNT;
        as = STAT_CHUNK_SIZE;
        fc = STAT_MMAP_COUNT;
        fs = STAT_MMAP_SIZE;
        fs = fs / PAGE_SIZE;
        if !force {
            # if not forced, send to STDOUT too
            printf(format, ac, as, fc, fs);
        }
        eprintf(format, ac, as, fc, fs);
    }
}

pub fn print_mem_chain__(void* mem) {
    int i = 0;
    printf("chain:\n");
    while mem > 0x100000000 {
        if mem > 0x110000000 {
            done;
        }
        printf("  Value at %p: %x / %i\n", mem, *mem, *mem);
        mem = *mem;
        i = i + 1;
        if i > 25 { done; }
    }
}

pub fn dump_around__(void* mem) {
    void* curr = mem - 0x100;
    void* end = mem + 0x100;
    eprintf("DUMP AROUND %x\n", mem);
    while curr < end {
        if curr == mem {
            eprintf("> %p: ", curr);
        }
        if curr != mem {
            eprintf("  %p: ", curr);
        }
        char* cc = curr;
        int line = curr + 0x20;
        while curr < line {
            int i = *curr;
            eprintf("%16x ", i);
            curr = curr + 0x8;
        }
        while cc < line {
            char c = *cc;
            if c <  0x20 { c = '.'; }
            if c >= 0x7f { c = '.'; }
            eprintf("%c", c);
            cc = cc + 0x1;
            if cc % 0x8 == 0 { eprintf(" "); }
        }
        eprintf("\n");
    }
}

# Free the allocation pointed to by the passed pointer, previously returned from
# `malloc`. A null pointer may be "freed" as a no-op.
pub fn free(void* mem) {
    if mem == null {
        return null;
    }
    # load the size/bytes from the header
    int a = mem - 0x8;
    int bytes = *a;
#    printf("\n\nfree(%x) at %x\n", bytes, mem);

#        printf(" ; free  %x bytes at %p\n", bytes, mem);

    if bytes <= 0 {
        if bytes == 0 {
            eprintf("Zero-byte free at %p. First quadword of chunk: %x\n", mem, *mem);
        } else {
            eprintf("Negative-byte (%d) free at %p?! First quadword of chunk: %x\n", bytes, mem, *mem);
        }
        a = mem - 0x10; # go back to last quadword of prev chunk
        eprintf("  Last quadword of prev chunk: %x\n", *a);
        exit(88);
    }

    STAT_FREE_COUNT = STAT_FREE_COUNT + 1;
    STAT_FREE_SIZE = STAT_FREE_SIZE + bytes;

    # header remains "len"
    # first quad is "prev" pointer
    # second quad is "next" pointer

    void next = FREE_LIST;
    void prev = null;
    while next != null {
        if mem == next {
            # already in the free list?!
            eprintf("Memory at %x has already been freed\n", mem);
            dump_around__(mem);
            exit(98);
        }
        int bs = next - 0x8;        # -> len
        bs = *bs;
        if bs >= bytes {
            # big enough!
            done;
        }
        prev = next;
        next = next + 0x8;          # -> next
        next = *next;
    }

    *mem = prev;
    if prev == null {
        FREE_LIST = mem;
    }
    if prev != null {
        prev = prev + 8;
        *prev = mem;
    }
    if next != null {
        *next = mem;
    }
    mem = mem + 8;
    *mem = next;

#    print_free_list();


    # todo /* 73 - int munmap(caddr_t addr, size_t len) */
}

