# Dynamic memory functions. Eventually, these will go away in favor of `new`/`drop`
# or something. And hopefully be taken over by the compiler itself, so programmers
# can't screw it up. We'll see.

int MALLOC_ALIGN= 0x10;
int PAGE_SIZE   = 0x4000;
int MMAP_FLAGS  = 0x1000 + 2; # MAP_ANON + MAP_PRIVATE
int MMAP_PROTO  = 1 + 2;      # PROT_READ + PROT_WRITE

void HEAP_START = null;
void HEAP_TOP   = null;
void HEAP_END   = null;

# it's an "array"!
void** free_lists = 0;
void* free_lists_1 = 0;
void* free_lists_2 = 0;
void* free_lists_3 = 0;
void* free_lists_4 = 0;
void* free_lists_5 = 0;
void* free_lists_6 = 0;

fn free_list_for(int bytes) {
    int sz = bytes / MALLOC_ALIGN;
    if sz > 6 { sz = 0; }
    return &free_lists + sz * sizeof(void*);
}

int STAT_MMAP_COUNT  = 0;
int STAT_MMAP_SIZE   = 0;
int STAT_CHUNK_COUNT = 0;
int STAT_CHUNK_SIZE  = 0;
int STAT_ALLOC_COUNT = 0;
int STAT_ALLOC_SIZE  = 0;
int STAT_FREE_COUNT  = 0;
int STAT_FREE_SIZE   = 0;

# they're "arrays"!
int* allocs = 0;
int allocs_1 = 0;
int allocs_2 = 0;
int allocs_3 = 0;
int allocs_4 = 0;
int allocs_5 = 0;
int allocs_6 = 0;

int* frees = 0;
int frees_1 = 0;
int frees_2 = 0;
int frees_3 = 0;
int frees_4 = 0;
int frees_5 = 0;
int frees_6 = 0;

int* chunks = 0;
int chunks_1 = 0;
int chunks_2 = 0;
int chunks_3 = 0;
int chunks_4 = 0;
int chunks_5 = 0;
int chunks_6 = 0;

fn track_by_size(int bytes, int* stat) {
    int sz = bytes / MALLOC_ALIGN;
    if sz > 6 { sz = 0; }
    stat[sz] = stat[sz] + 1;
}

pub fn mem_stats__(bool force) {
    int unfreed_count = STAT_FREE_COUNT - STAT_ALLOC_COUNT;
    # undetected double free can leave count right but size wrong
    int unfreed_size = STAT_FREE_SIZE - STAT_ALLOC_SIZE;
    if ! force { if unfreed_count == 0 { if unfreed_size == 0 {
        return;
    } } }
    char* format = "; MEM: %d allocs (%x bytes)\n;      %d frees  (%x bytes) [%d : %x bytes]\n";
    if !force {
        # if not forced, send to STDOUT too
        printf(format, STAT_ALLOC_COUNT, STAT_ALLOC_SIZE, STAT_FREE_COUNT, STAT_FREE_SIZE, unfreed_count, unfreed_size);
    }
    eprintf(format, STAT_ALLOC_COUNT, STAT_ALLOC_SIZE, STAT_FREE_COUNT, STAT_FREE_SIZE, unfreed_count, unfreed_size);
    format = ";      %d chunks (%x bytes)\n;      %d mmaps  (%i pages)\n";
    int page_count = STAT_MMAP_SIZE / PAGE_SIZE;
    if !force {
        # if not forced, send to STDOUT too
        printf(format, STAT_CHUNK_COUNT, STAT_CHUNK_SIZE, STAT_MMAP_COUNT, page_count);
    }
    eprintf(format, STAT_CHUNK_COUNT, STAT_CHUNK_SIZE, STAT_MMAP_COUNT, page_count);

    format = "; %s |%7d %7d %7d %7d %7d %7d";
    char* format2 = " %7d | %7d\n";
    eprintf(";            'big'%7d %7d %7d %7d %7d"
                  , MALLOC_ALIGN
                  , MALLOC_ALIGN * 2
                  , MALLOC_ALIGN * 3
                  , MALLOC_ALIGN * 4
                  , MALLOC_ALIGN * 5);eprintf(" %7d     total\n"
                  , MALLOC_ALIGN * 6
                  );
    eprintf(format, "allocs"
                  , allocs[0]
                  , allocs[1]
                  , allocs[2]
                  , allocs[3]
                  , allocs[4]
                  , allocs[5]);eprintf(format2
                  , allocs[6]
                  , STAT_ALLOC_COUNT);
    eprintf(format, "frees "
                  , frees[0]
                  , frees[1]
                  , frees[2]
                  , frees[3]
                  , frees[4]
                  , frees[5]);eprintf(format2
                  , frees[6]
                  , STAT_FREE_COUNT);
    eprintf(format, "chunks"
                  , chunks[0]
                  , chunks[1]
                  , chunks[2]
                  , chunks[3]
                  , chunks[4]
                  , chunks[5]);eprintf(format2
                  , chunks[6]
                  , STAT_CHUNK_COUNT);
}

pub fn print_mem_chain__(void* mem) {
    int i = 0;
    printf("chain:\n");
    while mem > 0x100000000 {
        if mem > 0x110000000 {
            done;
        }
        printf("  Value at %p: %x / %i\n", mem, *mem, *mem);
        mem = *mem;
        i = i + 1;
        if i > 25 { done; }
    }
}

pub fn dump_around__(void* mem) {
    void* curr = mem - 0x100;
    void* end = mem + 0x100;
    eprintf("DUMP AROUND %x\n", mem);
    while curr < end {
        if curr == mem {
            eprintf("> %p: ", curr);
        }
        if curr != mem {
            eprintf("  %p: ", curr);
        }
        char* cc = curr;
        int line = curr + 0x20;
        while curr < line {
            int i = *curr;
            eprintf("%16x ", i);
            curr = curr + 0x8;
        }
        while cc < line {
            char c = *cc;
            if c <  0x20 { c = '.'; }
            if c >= 0x7f { c = '.'; }
            eprintf("%c", c);
            cc = cc + 0x1;
            if cc % 0x8 == 0 { eprintf(" "); }
        }
        eprintf("\n");
    }
}

# Free the allocation pointed to by the passed pointer, previously returned from
# `malloc`. A null pointer may be "freed" as a no-op.
pub fn free(void* mem) {
    if mem == null {
        return;
    }
    # load the size/bytes from the header
    int a = mem - 0x8;
    int bytes = *a;
#    printf("\n\nfree(%x) at %x\n", bytes, mem);

#        printf(" ; free  %x bytes at %p\n", bytes, mem);

    if bytes <= 0 {
        if bytes == 0 {
            eprintf("Zero-byte free at %p. First quadword of chunk: %x\n", mem, *mem);
        } else {
            eprintf("Negative-byte (%d) free at %p?! First quadword of chunk: %x\n", bytes, mem, *mem);
        }
        a = mem - 0x10; # go back to last quadword of prev chunk
        eprintf("  Last quadword of prev chunk: %x\n", *a);
        exit(88);
    }

    STAT_FREE_COUNT = STAT_FREE_COUNT + 1;
    STAT_FREE_SIZE = STAT_FREE_SIZE + bytes;
    track_by_size(bytes, frees);

    # header remains "len"
    # first quad is "prev" pointer
    # second quad is "next" pointer

    void free_list = free_list_for(bytes);
    void next = *free_list;
    void prev = null;
    while next != null {
        if mem == next {
            # already in the free list?!
            eprintf("Memory at %x has already been freed\n", mem);
            dump_around__(mem);
            exit(98);
        }
        int bs = next - 0x8;        # -> len
        bs = *bs;
        if bs >= bytes {
            # big enough!
            done;
        }
        prev = next;
        next = next + 0x8;          # -> next
        next = *next;
    }

    *mem = prev;
    if prev == null {
        *free_list = mem;
    }
    if prev != null {
        prev = prev + 8;
        *prev = mem;
    }
    if next != null {
        *next = mem;
    }
    mem = mem + 8;
    *mem = next;

#    print_free_list(*free_list);


    # todo /* 73 - int munmap(caddr_t addr, size_t len) */
}

