# I am a dynamically resizing builder for null-terminated byte strings.

# struct StringBuilder {
#   int capacity
#   int size
#   char** buf
# }

# I create new builder, with the given initial capacity.
pub fn StringBuilder__new(int capacity) {
    if capacity < 0x10 {
        # can't allocate less, so may as well use it
        capacity = 0x10;
    }
    void* self = malloc(0x18);
    self = self + 0x8;              # -> size
    *self = 0;
    self = self + 0x8;              # -> buf
    *self = malloc(capacity);
    self = self - 0x10;             # -> capacity
    *self = capacity;
    return self;
}

# I push a single character into the buffer, which will be automatically
# extended if the character won't fit.
pub fn StringBuilder_push(void* self, char c) {
    int capacity = *self;
    self = self + 0x10;             # -> buffer
    char* chars = *self;
    self = self - 0x8;              # -> size
    int size = *self;
    if size == capacity {
        # need more!
        capacity = capacity * 2;
        char* next = malloc(capacity);
        memcpy(next, chars, size);
        free(chars);
        chars = next;
        self = self - 0x8;          # -> capacity
        *self = capacity;
        self = self + 0x10;         # -> buf
        *self = chars;
        self = self - 0x8;          # -> size
    }
    char* chars_i = chars + size;
    *chars_i = c;
    *self = size + 1;
}

# I consume the builder and produce a null-terminated byte string from it.
pub fn StringBuilder_into_chars(void* self) {
    # add the null terminator
    StringBuilder_push(self, null);
    self = self + 0x10;             # -> buf
    char* chars = *self;
    self = self - 0x10;             # -> capacity
    free(self);
    return chars;
}
