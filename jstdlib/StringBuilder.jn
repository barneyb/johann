# I am a dynamically resizing builder for null-terminated byte strings.

# Type of `StringBuilder`s.
pub struct StringBuilder {
    int capacity,
    int size,
    char** buf,
}

# I create new builder, with the given initial capacity.
pub fn StringBuilder__new(int capacity) {
    if capacity < 0x10 {
        # can't allocate less, so may as well use it
        capacity = 0x10;
    }
    StringBuilder* self = malloc(0x18);
    self.size = 0;
    self.buf = malloc(capacity);
    self.capacity = capacity;
    return self;
}

# I push a single character into the buffer, which will be automatically
# extended if the character won't fit.
pub fn StringBuilder_push(StringBuilder* self, char c) {
    int size = self.size;
    char* buf = ensure_buf_capacity(self, size + 1);
    char* buf_i = buf + size;
    *buf_i = c;
    self.size = size + 1;
}

# I push another string into the buffer, which will be automatically
# extended if needed.
pub fn StringBuilder_push_str(StringBuilder* self, char* str) {
    int size = self.size;
    int len = strlen(str);
    char* buf = ensure_buf_capacity(self, size + len);
    char* buf_i = buf + size;
    memcpy(buf_i, str, len);
    self.size = size + len;
}

# I consume the builder and produce a null-terminated byte string from it.
pub fn StringBuilder_into_chars(StringBuilder* self) {
    # add the null terminator
    StringBuilder_push(self, null);
    char* buf = self.buf;
    free(self);
    return buf;
}

# I consume the builder and produce a base-10 integer from it.
pub fn StringBuilder_into_int(StringBuilder* self) {
    self.push(null);
    int i = atoi(self.buf);
    free(self.buf);
    free(self);
    return i;
}

# I return the number of characters in the buffer, as if by `strlen`.
pub fn StringBuilder_length(StringBuilder* self) {
    return self.size;
}

fn ensure_buf_capacity(StringBuilder* self, int min) {
    int capacity = self.capacity;
    int size = self.size;
    char* buf = self.buf;
    if capacity >= min { return buf; }

    # use math, not iteration
    while capacity < min {
        capacity = capacity * 2;
    }
    char* next = malloc(capacity);
    memcpy(next, buf, size);
    free(buf);
    self.buf = next;
    self.capacity = capacity;
    return next;
}
