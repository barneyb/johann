# General-purpose algorithms. Currently just sort. Binary search is a likely
# future addition.

# I sort the elements at indices at or above `lo` and less than `hi` of the
# given array `arr`, using the comparator function pointer `cmp` to compare
# elements, _assuming each element is `sizeof(void*)`_. Since Johann puts nearly
# everything behind a pointer into the heap (Java-like, not C-like), this is
# probably what you want. If your array has elements of a different size (e.g.,
# a manually-laid-out array of non-pointers), you'll need to implement sorting
# manually too.
pub fn quicksort(void* arr, int lo, int hi, void* cmp) {
    if lo >= hi - 1 {
        # a single item (or nonsense range) is always sorted
        return;
    }
    if lo == hi - 2 {
        # two items can be checked directly
        if cmp(arr[lo], arr[lo + 1]) > 0 {
            swap(arr, lo, lo + 1);
        }
        return;
    }
    int pi = quicksort_partition(arr, lo, hi, cmp);
    if pi > lo + 1 { quicksort(arr, lo,     pi, cmp); }
    if pi < hi - 1 { quicksort(arr, pi + 1, hi, cmp); }
}

fn move_median_to_lo(void* arr, int lo, int hi, void* cmp) {
    # Thanks Bob! Now if only the compiler didn't suck...
    hi = hi - 1; # make hi inclusive
    int mid = (lo + hi) / 2;
    if cmp(arr[mid], arr[hi]) < 0 { swap(arr,  hi, mid); }
    if cmp(arr[ lo], arr[hi]) < 0 { swap(arr,  hi,  lo); }
    if cmp(arr[mid], arr[lo]) < 0 { swap(arr, mid,  lo); }
}

fn quicksort_partition(void* arr, int lo, int hi, void* cmp) {
    # If the slice to partition is more than an arbitrary 11 in length, do a
    # little extra work to try and pick a better pivot w/in the slice.
    if lo < hi - 11 { move_median_to_lo(arr, lo, hi, cmp); }
    void pivot = arr[lo];
    # min index < pivot
    int i = lo;
    # max unknown index
    int j = hi - 1;
    # search for a j on the wrong side
    while j > i {
        if cmp(arr[j], pivot) < 0 {
            # find an i also on the wrong side
            i = i + 1;
            while cmp(arr[i], pivot) < 0 {
                if i == j {
                    # crossed indices i->j, so done!
                    swap(arr, lo, i);
                    return i;
                }
                i = i + 1;
            }
            # both on the wrong side, so swap
            swap(arr, i, j);
        }
        j = j - 1;
    }

    # crossed indices j->i, so done!
    swap(arr, lo, i);
    return i;
}

fn swap(void* arr, int l, int r) {
    void t = arr[l];
    arr[l] = arr[r];
    arr[r] = t;
}
