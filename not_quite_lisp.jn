fn main() {
    int floor = 0;
    int first_descent = -1;
    int idx = 0;
    char c = getchar();
    while c > 0 { # not EOF
        idx = idx + 1;
        if c = '(' {
            floor = floor + 1;
        }
        if c = ')' {
            floor = floor - 1;
            if first_descent < 0 { if floor < 0 {
                first_descent = idx;
            } }
        }
        c = getchar();
    }
    char* format = "Part A: %i\nPart B: %i\n";
    printf(format, floor, first_descent);
}
