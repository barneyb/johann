fn main(): int {
    int f = zero();
    int e = 0;
    int g = 0;
    char c = read();
    int b = 0 - 1;
    while c > b {
        g = g + 1;
        if c = '(' {
            f = f + 1;
        }
        if c = ')' {
            f = f - 1;
        }
        int d = f + 1;
        if d = 0 {
            d = e = 0;
            if d {
                e = g;
            }
        }
        c = read();
    }
    char* a = "one: ";
    print();            # passed prior result as single arg
    f = f;
    a = itoa();         # passed prior result as single arg
    println();          # passed prior result as single arg
    a = a;
    free();             # passed prior result as single arg
    char* a = "two: ";
    print();            # passed prior result as single arg
    e = e;
    a = itoa();         # passed prior result as single arg
    println();          # passed prior result as single arg
    a = a;
    free();             # passed prior result as single arg
    return 0;
}

fn zero() {
    return 0;
}
