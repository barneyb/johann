fn main() {
    int floor = 0;
    int descend = 0;
    int a = 0;
    char c = read();
    int eol = 0 - 1;
    while c > eol {
        a = a + 1;
        if c = '(' {
            floor = floor + 1;
        }
        if c = ')' {
            if floor = 0 { if descend = 0 {
                descend = a;
            } }
            floor = floor - 1;
        }
        c = read();
    }
    output(floor, descend);
}

fn output(floor, descend) {
    char* a = "one: ";
    print(a);
    a = itoa(floor);
    println(a);
    free(a);
    a = "two: ";
    print(a);
    a = itoa(descend);
    println(a);
    free(a);
}
