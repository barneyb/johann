fn main(): int {
    int f = 0;
    bool d = false;
    char c = read();
    int b = 0 - 1;
    b = c > b;
    while b { # block 1
        d = c = '(';
        if d {
            f = f + 1;
        }
        d = c = ')';
        if d {
            f = f - 1;
        }
        c = read();
        b = 0 - 1;
        b = c > b;
    }
    char* a = "a: ";
    print();
    f = f;
    a = itoa();         # passed prior result as single arg
    println();          # passed prior result as single arg
    a = a;
    free();             # passed prior result as single arg
    return 0;
}
