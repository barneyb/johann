# I store information about a block/scope. I used to be an implementation detail
# of Emitter, which still hard-codes some layout information.

fn free(void*);
fn strcmp(char* left, char* right);

struct Table;

struct Block {
    int type,       # type of the block, identified by its token
    int id,         # unique id num of the block
    int nvars,      # number of vars (function only)
    Table* symbols,
}

pub int SIZEOF_BLOCK = sizeof(Block);

pub fn Block_init(Block* self, int type, int id) {
    self.type = type;
    self.id = id;
    self.nvars = 0;
    self.symbols = Table__new(&strcmp);
    return self;
}

pub fn Block_drop(Block* self) {
    Table_drop_owned(self.symbols, &free, &free);
}

pub fn Block_type(Block* self) {
    return self.type;
}

pub fn Block_id(Block* self) {
    return self.id;
}

pub fn Block_contains_symbol(Block* self, char* name) {
    return Table_contains(self.symbols, name);
}

pub fn Block_get_symbol(Block* self, char* name) {
    return Table_get(self.symbols, name);
}

pub fn Block_put_symbol(Block* self, char* name, void* symbol) {
    # only take ownership of the symbol, not the name
    return Table_put(self.symbols, strclone(name), symbol);
}

pub fn Block_symbol_count(Block* self) {
    return Table_size(self.symbols);
}

pub fn Block_symbols(Block* self) {
    return self.symbols;
}
