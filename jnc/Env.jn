# I hold the environment during compilation, which is usually nested.

int AST_FN;
int AST_TYPE_NAMED;
int AST_TYPE_PTR;
int AST_TYPE_STRUCT;
int AST_TYPE_VOID;
int AST_VARIABLE;

char* ERR_UNKNOWN_SYMBOL;

struct Token;

fn strcmp(char*, char*);
fn strhash(char*);
fn free(void*);
fn drop_ast(void*);

struct Env {
    Env* parent,
    HashMap* symbols,
    HashMap* types,
    HashMap* strings,
}

pub fn Env__new(Env* parent) {
    Env* e = malloc(sizeof(Env));
    e.parent = parent;
    e.symbols = HashMap__new_owned(&strhash, &strcmp, &free, null);
    e.types = HashMap__new_owned(&strhash, &strcmp, &free, &drop_ast);
    e.strings = null; # HashMap__new_owned(&strhash, &strcmp, &free, null);
    return e;
}

pub fn Env_drop(Env* self) {
    # don't drop parent - it isn't owned.
    HashMap_drop(self.symbols);
    HashMap_drop(self.types);
    # HashMap_drop(self.strings);
    free(self);
}

pub fn Env_push(void* self) {
    return Env__new(self);
}

pub fn Env_pop(Env* self) {
    void* parent = self.parent;
    self.drop();
    return parent;
}

pub fn Env_symbol_count(Env* self) {
    return HashMap_size(self.symbols);
}

fn dupe_symbol(Token* nameT, int status) {
    eprintf("Duplicate symbol '%s' at line %i, col %i\n",
            nameT.value(),
            nameT.line(),
            nameT.col());
    exit(status);
}

fn inconsistent_redecl(Token* nameT, int status) {
    eprintf("Inconsistent redeclaration of '%s' at line %i, col %i\n",
            nameT.value(),
            nameT.line(),
            nameT.col());
    exit(status);
}

pub fn Env_register_symbol(Env* self, Token* nameT, void* ast) {
    char* name = nameT.value();
    if HashMap_contains(self.symbols, name) {
        # this is ridiculous...
        if *ast != AST_FN { if *ast != AST_VARIABLE {
            dupe_symbol(nameT, 88);
        } }
        if *ast == AST_FN { if !should_update_fn_registration(
                nameT,
                HashMap_get(self.symbols, name),
                ast) {
            # keep the old one
            return;
        } }
        if *ast == AST_VARIABLE { if !should_update_var_registration(
                nameT,
                HashMap_get(self.symbols, name),
                ast) {
            # keep the old one
            return;
        } }
    }
    HashMap_put(self.symbols, strclone(name), ast);
}

fn should_update_var_registration(Token* nameT, void* curr, void* ast) {
    # [AST_VARIABLE, type, nameT, init?]
    bool do_update = false;

    # types - both better be AST_VARIABLE
    if *ast != *curr {
        eprintf("types: %d vs %d\n", *ast, *curr);
        inconsistent_redecl(nameT, 88);
    }

    if ast[3] != null {
        if curr[3] != null {
            eprintf("defns(%s:%d): %x vs %x\n", nameT.value(), nameT.line(), ast[3], curr[3]);
            dupe_symbol(nameT, 88);
        }
        # replace the declaration with the definition
        do_update = true;
    }

    if is_var_type_mismatch(ast, curr) {
        inconsistent_redecl(nameT, 88);
    }

    return do_update;
}

fn should_update_fn_registration(Token* nameT, void* curr, void* ast) {
    # [AST_FN, nameT, args[], body?]
    bool do_update = false;

    # types - both better be AST_FN
    if *ast != *curr {
        eprintf("types: %d vs %d\n", *ast, *curr);
        inconsistent_redecl(nameT, 88);
    }

    # names already are known to match

    # definitions - can't redefine
    ast = ast + 0x18; curr = curr + 0x18;
    if *ast != null {
        if *curr != null {
            eprintf("defns(%s:%d): %x vs %x\n", nameT.value(), nameT.line(), *ast, *curr);
            dupe_symbol(nameT, 88);
        }
        # replace the declaration with the definition
        do_update = true;
    }

    # args
    ast = ast - 0x8; curr = curr - 0x8;
    ast = *ast; curr = *curr;
    if ast == null { if curr == null {
        # if both are zero-arg, done!
        return do_update;
    } }
    if ast == null {
        eprintf("args: %x vs %x\n", ast, curr);
        inconsistent_redecl(nameT, 88);
    }
    if curr == null {
        eprintf("args: %x vs %x\n", ast, curr);
        inconsistent_redecl(nameT, 88);
    }
    int tl = arrlen(ast);
    int cl = arrlen(curr);
    if tl != cl {
        eprintf("arg #: %d vs %d\n", tl, cl);
        inconsistent_redecl(nameT, 88);
    }
    int i = 0;
    while i < tl {
        if is_var_type_mismatch(ast[i], curr[i]) {
            eprintf("  arg %d\n", i + 1);
            inconsistent_redecl(nameT, 88);
        }
        i = i + 1;
    }

    return do_update;
}

fn is_var_type_mismatch(void* a, void* b) {
    # move to the type AST
    a = a + 0x8; b = b + 0x8;
    a = *a; b = *b;

    # base type
    if *a != *b {
        # void goes with anything - it's the absence of a type requirement
        if *a == AST_TYPE_VOID { return false; }
        if *b == AST_TYPE_VOID { return false; }
        eprintf("  types: %d vs %d\n", *a, *b);
        return true;
    }

    # named types must match
    if *a == AST_TYPE_NAMED {
        # make sure the names match
        a = a + 0x8; b = b + 0x8;
        if strcmp(Token_value(*a), Token_value(*b)) != 0 {
            eprintf(" types: %s v %s\n", Token_value(*a), Token_value(*b));
            return true;
        }
    }

    # pointers must be equivalent
    if *a == AST_TYPE_PTR {
        # recurse! this only works because both AST_VARIABLE and AST_TYPE_PTR
        # store their type subAST in the 'value' slot.
        return is_var_type_mismatch(a, b);
    }

    return false;
}

pub fn Env_typeof_symbol(Env* self, Token* nameT) {
    void* sym = Env_opt_typeof_symbol(self, nameT);
    if sym == null {
        # munge for panic
        nameT.set_type(nameT.value());
        jnc_panic(ERR_UNKNOWN_SYMBOL, nameT, 23);
    }
    return sym;
}

pub fn Env_opt_typeof_symbol(Env* self, Token* nameT) {
    char* name = nameT.value();
    while self != null {
        void* sym = HashMap_get(self.symbols, name);
        if sym != null {
            return sym;
        }
        self = self.parent;
    }
    # bottomed out without finding it
    return null;
}

fn should_update_type_registration(Token* nameT, void* curr, void* type_ast) {
    # [AST_TYPE_STRUCT, total_align, total_size, members]
    # take total_size==0 to mean "just declaration"
    if curr[2] == 0 {
        # update if this is a definition
        return type_ast[2] != 0;
    }
    # redeclare is always fine
    if type_ast[2] == 0 { return false; }

    # munge for panic
    nameT.set_type(nameT.value());
    jnc_panic("ERROR(%d): Duplicate type '%s' at line %i, col %i\n", nameT, 82);
}

pub fn Env_register_type(Env* self, Token* nameT, void* type_ast) {
    char* name = nameT.value();
    if HashMap_contains(self.types, name) {
        if !should_update_type_registration(
                nameT,
                HashMap_get(self.types, name),
                type_ast) {
            # keep the old one
            drop_ast(type_ast);
            return;
        }
    }
    drop_ast(HashMap_put(self.types, strclone(name), type_ast));
}

# I'm just for `jnc` to register the built-in types.
pub fn Env_seed_type(Env* self, char* name, void* type_ast) {
    HashMap_put(self.types, strclone(name), type_ast);
}

pub fn Env_get_type(Env* self, char* name) {
    void* t = find_type(self, name);
    if t == null {
        eprintf("No type '%s' is known\n", name);
        exit(83);
    }
    return t;
}

pub fn Env_is_type(Env* self, char* name) {
    return find_type(self, name) != null;
}

fn find_type(Env* self, char* name) {
    if self == null {
        # bottomed out without finding it
        return null;
    }
    void t = HashMap_get(self.types, name);
    if t != null { return t; }
    return find_type(*self, name);
}

pub fn Env_sizeof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    return type[2];
}

pub fn Env_alignof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    return type[1];
}

# [AST_TYPE_STRUCT, alignof, sizeof, memberMap]
fn get_struct_type(void* self, char* name) {
    void* ast = Env_get_type(self, name);
    if *ast != AST_TYPE_STRUCT {
        eprintf("Expected an %i, but got an %i\n", AST_TYPE_STRUCT, *ast);
        exit(84);
    }
    return ast;
}
