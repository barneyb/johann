# I hold the environment during compilation, which is usually nested.

int AST_MEMBER;
int AST_TYPE_STRUCT;
int AST_TYPE_MEMBER;

fn strcmp(char*, char*);
fn free(void*);
fn drop_ast(void*);

char* ERR_DUPLICATE_STRUCT_MEMBER = "ERROR(%i): duplicate '%s' member\n";

# struct Env {
#   Env* parent;
#   TreeMap* symbols;
#   TreeMap* types;
#   TreeMap* strings;
# }

pub fn Env__new(void* parent) {
    void* self = malloc(0x20);
    self = self + 0x8;              # -> symbols
    *self = null; # TreeMap__new_owned(&strcmp, &free, null);
    self = self + 0x8;              # -> types
    *self = TreeMap__new_owned(&strcmp, &free, &drop_ast);
    self = self + 0x8;              # -> strings
    *self = null; # TreeMap__new_owned(&strcmp, &free, null);
    self = self - 0x18;             # -> parent
    *self = parent;
    return self;
}

pub fn Env_drop(void* self) {
    self = self + 0x8;              # -> symbols
    # TreeMap_drop(*self);
    self = self + 0x8;              # -> types
    TreeMap_drop(*self);
    self = self + 0x8;              # -> strings
    # TreeMap_drop(*self);
    self = self - 0x18;             # -> parent
    # don't drop parent - it isn't owned.
    free(self);
}

pub fn Env_push(void* self) {
    return Env__new(self);
}

pub fn Env_pop(void* self) {
    void* parent = *self;
    Env_drop(self);
    return parent;
}

pub fn Env_register_type(void* self, void* nameT, void* ast) {
    char* name = Token_value(nameT);
    self = self + 0x10;             # -> types
    if TreeMap_contains(*self, name) {
        eprintf("Type '%s' is already defined at line %i, char %i\n",
                name,
                Token_line(nameT),
                Token_char(nameT));
        exit(82);
    }
    TreeMap_put(*self, strclone(name), build_type_info(ast));
}

fn build_type_info(void* ast) {
    void* members = TreeMap__new_owned(&strcmp, null, &drop_ast);
    int size = 0;
    int align = 0;
    void* kids = ast + 0x10;
    kids = *kids;
    while true {
        void* kid = *kids;
        if kid == null { done; }
        if *kid != AST_MEMBER {
            eprintf("Expected an %i building type info, but got an %i\n", AST_MEMBER, *kid);
            exit(84);
        }
        kids = kids + 0x8;
        kid = kid + 0x8;            # -> nameT
        char* name = Token_value(*kid);
        if TreeMap_contains(members, name) {
            eprintf(ERR_DUPLICATE_STRUCT_MEMBER, 36, name);
            exit(36);
        }
        kid = kid + 0x8;            # -> type
        int i = ast_alignment(*kid);
        align = imax(align, i);
        i = ast_sizeof(*kid);
        size = round_up_to_mod(size, i);
        name = strclone(name);
        TreeMap_put(members, name, ast3(AST_TYPE_MEMBER, name, size));
        size = size + i;
    }
    size = round_up_to_mod(size, align);
    return ast4(AST_TYPE_STRUCT, align, size, members);
}

fn round_up_to_mod(int value, int modulus) {
    int overage = value % modulus;
    if overage != 0 {
        value = value + modulus - overage;
    }
    return value;
}

pub fn Env_sizeof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    type = type + 0x10;
    return *type;
}

pub fn Env_alignof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    type = type + 0x8;
    return *type;
}

fn get_struct_type(void* self, char* name) {
    if self == null {
        eprintf("No type '%s' is known\n", name);
        exit(83);
    }
    self = self + 0x10;             # -> types
    void* ast = TreeMap_get(*self, name);
    if ast != null {
        if *ast != AST_TYPE_STRUCT {
            eprintf("Expected an %i sizeof-ing a type, but got an %i\n", AST_TYPE_STRUCT, *ast);
            exit(84);
        }
        return ast;
    }
    self = self - 0x10;             # -> parent
    return get_struct_type(*self, name);
}
