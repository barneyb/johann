# I hold the environment during compilation, which is usually nested.

int AST_TYPE_STRUCT;

fn strcmp(char*, char*);
fn free(void*);
fn drop_ast(void*);

# struct Env {
#   Env* parent;
#   TreeMap* symbols;
#   TreeMap* types;
#   TreeMap* strings;
# }

pub fn Env__new(void* parent) {
    void* self = malloc(0x20);
    self = self + 0x8;              # -> symbols
    *self = TreeMap__new_owned(&strcmp, &free, null);
    self = self + 0x8;              # -> types
    *self = TreeMap__new_owned(&strcmp, &free, &drop_ast);
    self = self + 0x8;              # -> strings
    *self = null; # TreeMap__new_owned(&strcmp, &free, null);
    self = self - 0x18;             # -> parent
    *self = parent;
    return self;
}

pub fn Env_drop(void* self) {
    self = self + 0x8;              # -> symbols
    TreeMap_drop(*self);
    self = self + 0x8;              # -> types
    TreeMap_drop(*self);
    self = self + 0x8;              # -> strings
    # TreeMap_drop(*self);
    self = self - 0x18;             # -> parent
    # don't drop parent - it isn't owned.
    free(self);
}

pub fn Env_push(void* self) {
    return Env__new(self);
}

pub fn Env_pop(void* self) {
    void* parent = *self;
    Env_drop(self);
    return parent;
}

pub fn Env_register_symbol(void* self, void* nameT, void* type_ast) {
    char* name = Token_value(nameT);
    void* symbols = self + 0x8;     # -> symbols
    if TreeMap_contains(*symbols, name) {
        eprintf("Duplicate symbol '%s' at line %i, char %i\n",
                name,
                Token_line(nameT),
                Token_char(nameT));
        exit(88);
    }
    TreeMap_put(*symbols, strclone(name), type_ast);
}

pub fn Env_typeof_symbol(void* self, char* name) {
    if self == null {
        # bottomed out without finding it
        eprintf("No symbol '%s' is known\n", name);
        exit(87);
    }
    void* symbols = self + 0x8;     # -> symbols
    void* sym = TreeMap_get(*symbols, name);
    if sym != null {
        return sym;
    }
    return Env_typeof_symbol(*self, name);
}

pub fn Env_register_type(void* self, void* nameT, void* type_ast) {
    char* name = Token_value(nameT);
    void* types = self + 0x10;      # -> types
    if TreeMap_contains(*types, name) {
        eprintf("Duplicate type '%s' at line %i, char %i\n",
                name,
                Token_line(nameT),
                Token_char(nameT));
        exit(82);
    }
    TreeMap_put(*types, strclone(name), type_ast);
}

# I'm just for `jnc` to register the built-in types.
pub fn Env_seed_type(void* self, char* name, void* type_ast) {
    void* types = self + 0x10;      # -> types
    TreeMap_put(*types, strclone(name), type_ast);
}

pub fn Env_get_type(void* self, char* name) {
    void* t = find_type(*self, name);
    if t == null {
        eprintf("No type '%s' is known\n", name);
        exit(83);
    }
    return t;
}

pub fn Env_is_type(void* self, char* name) {
    return find_type(*self, name) != null;
}

fn find_type(void* self, char* name) {
    if self == null {
        # bottomed out without finding it
        return null;
    }
    void* types = self + 0x10;      # -> types
    void t = TreeMap_get(*types, name);
    if t != null { return t; }
    return find_type(*self, name);
}

pub fn Env_sizeof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    type = type + 0x10;
    return *type;
}

pub fn Env_alignof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    type = type + 0x8;
    return *type;
}

fn get_struct_type(void* self, char* name) {
    void* ast = Env_get_type(self, name);
    if *ast != AST_TYPE_STRUCT {
        eprintf("Expected an %i, but got an %i\n", AST_TYPE_STRUCT, *ast);
        exit(84);
    }
    return ast;
}
