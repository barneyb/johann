# I hold the environment during compilation, which is usually nested.

int AST_FN;
int AST_TYPE_NAMED;
int AST_TYPE_PTR;
int AST_TYPE_STRUCT;
int AST_TYPE_VOID;

fn strcmp(char*, char*);
fn free(void*);
fn drop_ast(void*);

struct Env {
    Env* parent,
    TreeMap* symbols,
    TreeMap* types,
    TreeMap* strings,
}

pub fn Env__new(Env* parent) {
    Env* e = malloc(0x20);
    e.parent = parent;
    e.symbols = TreeMap__new_owned(&strcmp, &free, null);
    e.types = TreeMap__new_owned(&strcmp, &free, &drop_ast);
    e.strings = null; # TreeMap__new_owned(&strcmp, &free, null);
    return e;
}

pub fn Env_drop(Env* self) {
    # don't drop parent - it isn't owned.
    TreeMap_drop(self.symbols);
    TreeMap_drop(self.types);
    # TreeMap_drop(self.strings);
    free(self);
}

pub fn Env_push(void* self) {
    return Env__new(self);
}

pub fn Env_pop(Env* self) {
    void* parent = self.parent;
    self.drop();
    return parent;
}

fn dupe_symbol(Token* nameT, int status) {
    eprintf("Duplicate symbol '%s' at line %i, col %i\n",
            nameT.value(),
            nameT.line(),
            nameT.col());
    exit(status);
}

pub fn Env_register_symbol(Env* self, void* nameT, void* type_ast) {
    char* name = Token_value(nameT);
    if TreeMap_contains(self.symbols, name) {
        if *type_ast != AST_FN {
            dupe_symbol(nameT, 88);
        }
        if !should_update_fn_registration(
                nameT,
                TreeMap_get(self.symbols, name),
                type_ast) {
            # keep the old one
            return;
        }
    }
    TreeMap_put(self.symbols, strclone(name), type_ast);
}

fn should_update_fn_registration(Token* nameT, void* curr, void* type_ast) {
    bool do_update = false;

    # types
    if *type_ast != *curr {
        eprintf("types: %d vs %d\n", *type_ast, *curr);
        dupe_symbol(nameT, 88);
    }

    # names already are known to match

    # definitions - can't redefine
    type_ast = type_ast + 0x18; curr = curr + 0x18;
    if *type_ast != null {
        if *curr != null {
            eprintf("defns(%s:%d): %x vs %x\n", nameT.value(), nameT.line(), *type_ast, *curr);
            dupe_symbol(nameT, 88);
        }
        # replace the declaration with the definition
        do_update = true;
    }

    # args
    type_ast = type_ast - 0x8; curr = curr - 0x8;
    type_ast = *type_ast; curr = *curr;
    if type_ast == null { if curr == null {
        # if both are zero-arg, done!
        return do_update;
    } }
    if type_ast == null {
        eprintf("args: %x vs %x\n", type_ast, curr);
        dupe_symbol(nameT, 88);
    }
    if curr == null {
        eprintf("args: %x vs %x\n", type_ast, curr);
        dupe_symbol(nameT, 88);
    }
    int tl = arrlen(type_ast);
    int cl = arrlen(curr);
    if tl != cl {
        eprintf("arg #: %d vs %d\n", tl, cl);
        dupe_symbol(nameT, 88);
    }
    int i = 0;
    while i < tl {
        check_arg_types(nameT, i, type_ast[i], curr[i]);
        i = i + 1;
    }

    return do_update;
}

fn check_arg_types(Token* nameT, int arg_num, void* a, void* b) {
    # move to the type AST
    a = a + 0x8; b = b + 0x8;
    a = *a; b = *b;

    # base type
    if *a != *b {
        # void goes with anything - it's the absence of a type requirement
        if *a == AST_TYPE_VOID { return; }
        if *b == AST_TYPE_VOID { return; }
        eprintf("  arg %d types: %d vs %d\n", arg_num + 1, *a, *b);
        dupe_symbol(nameT, 88);
    }

    # named types must match
    if *a == AST_TYPE_NAMED {
        # make sure the names match
        a = a + 0x8; b = b + 0x8;
        if strcmp(Token_value(*a), Token_value(*b)) != 0 {
            eprintf(" arg %d types: %s v %s\n", arg_num + 1, Token_value(*a), Token_value(*b));
            dupe_symbol(nameT, 88);
        }
    }

    # pointers must be equivalent
    if *a == AST_TYPE_PTR {
        # recurse! this only works because both AST_VARIABLE and AST_TYPE_PTR
        # store their type subAST in the 'value' slot.
        check_arg_types(nameT, arg_num, a, b);
    }
}

pub fn Env_typeof_symbol(Env* self, char* name) {
    if self == null {
        # bottomed out without finding it
        eprintf("No symbol '%s' is known\n", name);
        exit(87);
    }
    void* sym = TreeMap_get(self.symbols, name);
    if sym != null {
        return sym;
    }
    return Env_typeof_symbol(self.parent, name);
}

pub fn Env_opt_typeof_symbol(Env* self, Token* nameT) {
    char* name = nameT.value();
    while self != null {
        void* sym = TreeMap_get(self.symbols, name);
        if sym != null {
            return sym;
        }
        self = self.parent;
    }
    # bottomed out without finding it
    return null;
}

fn should_update_type_registration(Token* nameT, void* curr, void* type_ast) {
    # [AST_TYPE_STRUCT, total_align, total_size, members]
    # take total_size==0 to mean "just declaration"
    if curr[2] == 0 {
        # update if this is a definition
        return type_ast[2] != 0;
    }
    # redeclare is always fine
    if type_ast[2] == 0 { return false; }

    eprintf("Duplicate type '%s' at line %i, col %i\n",
            nameT.value(),
            nameT.line(),
            nameT.col());
    exit(82);
}

pub fn Env_register_type(Env* self, Token* nameT, void* type_ast) {
    char* name = nameT.value();
    if TreeMap_contains(self.types, name) {
        if !should_update_type_registration(
                nameT,
                TreeMap_get(self.types, name),
                type_ast) {
            # keep the old one
            drop_ast(type_ast);
            return;
        }
    }
    TreeMap_put(self.types, strclone(name), type_ast);
}

# I'm just for `jnc` to register the built-in types.
pub fn Env_seed_type(void* self, char* name, void* type_ast) {
    void* types = self + 0x10;      # -> types
    TreeMap_put(*types, strclone(name), type_ast);
}

pub fn Env_get_type(void* self, char* name) {
    void* t = find_type(*self, name);
    if t == null {
        eprintf("No type '%s' is known\n", name);
        exit(83);
    }
    return t;
}

pub fn Env_is_type(void* self, char* name) {
    return find_type(*self, name) != null;
}

fn find_type(void* self, char* name) {
    if self == null {
        # bottomed out without finding it
        return null;
    }
    void* types = self + 0x10;      # -> types
    void t = TreeMap_get(*types, name);
    if t != null { return t; }
    return find_type(*self, name);
}

pub fn Env_sizeof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    type = type + 0x10;
    return *type;
}

pub fn Env_alignof_type(void* self, char* name) {
    void* type = get_struct_type(self, name);
    type = type + 0x8;
    return *type;
}

fn get_struct_type(void* self, char* name) {
    void* ast = Env_get_type(self, name);
    if *ast != AST_TYPE_STRUCT {
        eprintf("Expected an %i, but got an %i\n", AST_TYPE_STRUCT, *ast);
        exit(84);
    }
    return ast;
}
