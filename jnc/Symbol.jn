# I store information about a symbol in a Johann program (during emission).

int T_KW_BOOL;
int T_KW_CHAR;

int AST_TYPE_BOOL;
int AST_TYPE_CHAR;

struct Symbol {
    int width,  # byte width of a value - ick!
    int nptr,   # number of pointer indirections
    int offset, # locals : offset from fp (one-indexed)
                # statics: non-positive
    int type,   # type of the symbol
}

# I create a new symbol, computing its width from its type (ick).
pub fn Symbol__new(int type, int nptr) {
    Symbol* s = malloc(sizeof(Symbol));
    s.width = 0x8;
    if type == T_KW_BOOL     { s.width = 0x1; }
    if type == T_KW_CHAR     { s.width = 0x1; }
    if type == AST_TYPE_BOOL { s.width = 0x1; }
    if type == AST_TYPE_CHAR { s.width = 0x1; }
    s.nptr = nptr;
    s.offset = 0;
    s.type = type;
    return s;
}

pub fn Symbol_type(Symbol* self) {
    return self.type;
}

pub fn Symbol_width(Symbol* self) {
    return self.width;
}

pub fn Symbol_nptr(Symbol* self) {
    return self.nptr;
}

pub fn Symbol_offset(Symbol* self) {
    return self.offset;
}

pub fn Symbol_set_offset(Symbol* self, int offset) {
    self.offset = offset;
}
