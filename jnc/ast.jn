# I hold the compiler's AST implementation.

void ENV;

##################################################
# simple literals are __x, in promotion order

# [AST_LIT_BOOL, value]
pub int AST_LIT_BOOL    = 1;
# [AST_LIT_CHAR, value]
pub int AST_LIT_CHAR    = 2;
# [AST_LIT_INT, value]
pub int AST_LIT_INT     = 3;

##################################################
# compound literals are _2x

# [AST_LIT_STRING, value]
pub int AST_LIT_STRING  = 20;

##################################################
# simple expressions are _5x

# [AST_ID, nameT]
pub int AST_ID          = 50;

##################################################
# compound expressions are 1xx

# [AST_UNARY, op, operand]
pub int AST_UNARY       = 101;
# [AST_BINARY, op, left, right]
pub int AST_BINARY      = 102;
# [AST_ADDR_OP, op, nameT]
pub int AST_ADDR_OP     = 103;
# [AST_CALL, callee, args[]]
pub int AST_CALL        = 104;
# [AST_MEMBER, rcvr, offset, width]
pub int AST_MEMBER      = 105;
# [AST_INDEX, rcvr, off_expr, width]
pub int AST_INDEX       = 106;

##################################################
# declarations are 3xx

# [AST_PROGRAM, decls[]]
pub int AST_PROGRAM     = 301;
# [AST_DECL, is_pub, fn_or_var]
pub int AST_DECL        = 302;
# [AST_FN, nameT, params[], block?]
pub int AST_FN          = 303;
# [AST_STRUCT, nameT, members?]
pub int AST_STRUCT      = 306;
# [AST_VARIABLE, type, nameT? init?]
pub int AST_VARIABLE    = 307;

##################################################
# statements are 4xx

# [AST_EVAL, expr]
pub int AST_EVAL        = 401;
# [AST_ASSIGN, expr, rhs]
pub int AST_ASSIGN      = 402;
# [AST_IF, cond, block]
pub int AST_IF          = 403;
# [AST_WHILE, cond, block]
pub int AST_WHILE       = 404;
# [AST_DONE, kwT]
pub int AST_DONE        = 405;
# [AST_AGAIN, kwT]
pub int AST_AGAIN       = 406;
# [AST_RETURN, kwT, expr?]
pub int AST_RETURN      = 407;

##################################################
# types are 5xx

# [AST_TYPE_BOOL]
pub int AST_TYPE_BOOL   = 501;
# [AST_TYPE_CHAR]
pub int AST_TYPE_CHAR   = 502;
# [AST_TYPE_INT]
pub int AST_TYPE_INT    = 503;
# [AST_TYPE_VOID]
pub int AST_TYPE_VOID   = 520;
# [AST_TYPE_PTR, type]
pub int AST_TYPE_PTR    = 521;
# [AST_TYPE_NAMED, nameT]
pub int AST_TYPE_NAMED  = 550;
## todo: functions and arrays...

##################################################
# synthetics are 10xx

# [AST_TYPE_STRUCT, alignof, sizeof, memberMap]
pub int AST_TYPE_STRUCT = 1002;
# [AST_TYPE_MEMBER, name, offset, width]
pub int AST_TYPE_MEMBER = 1003;

##################################################

struct Ast1 {
    int type
}

# [type] 1-tuple (silly, but uniform)
pub fn ast1(int type) {
    Ast1* ast = malloc(sizeof(Ast1));
    ast.type = type;
    return ast;
}

struct Ast2 {
    int type,
    void value
}

# [type, value] 2-tuple
pub fn ast2(int type, void value) {
    Ast2* ast = malloc(sizeof(Ast2));
    ast.type = type;
    ast.value = value;
    return ast;
}

struct Ast3 {
    int type,
    void value,
    void left
}

# [type, value, left] 3-tuple
pub fn ast3(int type, void value, void left) {
    Ast3* ast = malloc(sizeof(Ast3));
    ast.type = type;
    ast.value = value;
    ast.left = left;
    return ast;
}

struct Ast4 {
    int type,
    void value,
    void left,
    void right
}

# [type, value, left, right] 4-tuple
pub fn ast4(int type, void value, void left, void right) {
    Ast4* ast = malloc(sizeof(Ast4));
    ast.type = type;
    ast.value = value;
    ast.left = left;
    ast.right = right;
    return ast;
}

pub fn ast_sizeof(void* ast) {
    int t = *ast;
    if t == AST_TYPE_BOOL { return 1; }
    if t == AST_TYPE_CHAR { return 1; }
    if t == AST_TYPE_INT  { return 8; }
    if t == AST_TYPE_VOID { return 8; } # void means "opaque 64-bit value"
    if t == AST_TYPE_PTR  { return 8; }
    if t == AST_TYPE_NAMED {
        ast = ast + 0x8;            # -> nameT
        char* name = Token_value(*ast);
        return Env_sizeof_type(ENV, name);
    }

    char* f = "Can't compute sizeof type %i / %x\n";
    eprintf(f, t, t);
    printf(f, t, t);
    exit(63);
}

pub fn ast_alignment(void* ast) {
    int t = *ast;
    if t == AST_TYPE_NAMED {
        ast = ast + 0x8;            # -> nameT
        char* name = Token_value(*ast);
        return Env_alignof_type(ENV, name);
    }
    # everything else is aligned at its size
    return ast_sizeof(ast);
}

# I drop an AST. It might be narrower than `Ast4`, but the type
# field will indicate that.
pub fn drop_ast(Ast4* ast) {
    if ast == null { return; }
    int type = ast.type;

#    eprintf("drop_ast(%i)\n", type);

    if type == AST_LIT_BOOL {
        return free(ast);
    }
    if type == AST_LIT_CHAR {
        return free(ast);
    }
    if type == AST_LIT_INT {
        return free(ast);
    }
    if type == AST_LIT_STRING {
        free(ast.value);
        return free(ast);
    }
    if type == AST_BINARY {
        drop_ast(ast.left);
        drop_ast(ast.right);
        return free(ast);
    }
    if type == AST_UNARY {
        drop_ast(ast.left); # operand
        return free(ast);
    }
    if type == AST_FN {
        Token_drop(ast.value); # nameT
        drop_ast_array(ast.left); # args
        drop_ast_array(ast.right); # stmts
        return free(ast);
    }
    if type == AST_STRUCT {
        Token_drop(ast.value); # nameT
        drop_ast_array(ast.left); # members
        return free(ast);
    }
    if type == AST_VARIABLE {
        drop_ast(ast.value); # type
        if ast.left != null { # nameT
            Token_drop(ast.left);
        }
        drop_ast(ast.right); # init
        return free(ast);
    }
    if type == AST_RETURN {
        Token_drop(ast.value); # token
        drop_ast(ast.left); # expr
        return free(ast);
    }
    if type == AST_EVAL {
        drop_ast(ast.value); # expr
        return free(ast);
    }
    if type == AST_ID {
        Token_drop(ast.value); # nameT
        return free(ast);
    }
    if type == AST_CALL {
        drop_ast(ast.value); # callee
        drop_ast_array(ast.left); # args
        return free(ast);
    }
    if type == AST_ASSIGN {
        drop_ast(ast.value); # lehs
        drop_ast(ast.left); # rhs
        return free(ast);
    }
    if type == AST_IF {
        drop_ast(ast.value); # condition
        drop_ast_array(ast.left); # body
        return free(ast);
    }
    if type == AST_WHILE {
        drop_ast(ast.value); # condition
        drop_ast_array(ast.left); # body
        return free(ast);
    }
    if type == AST_DONE {
        Token_drop(ast.value); # token
        return free(ast);
    }
    if type == AST_AGAIN {
        Token_drop(ast.value); # token
        return free(ast);
    }
    if type == AST_ADDR_OP {
        Token_drop(ast.left); # nameT
        return free(ast);
    }
    if type == AST_PROGRAM {
        drop_ast_array(ast.value); # decls
        return free(ast);
    }
    if type == AST_DECL {
        drop_ast(ast.left); # fn_or_var
        return free(ast);
    }
    if type == AST_TYPE_BOOL {
        return free(ast);
    }
    if type == AST_TYPE_CHAR {
        return free(ast);
    }
    if type == AST_TYPE_INT {
        return free(ast);
    }
    if type == AST_TYPE_VOID {
        return free(ast);
    }
    if type == AST_TYPE_PTR {
        drop_ast(ast.value); # type
        return free(ast);
    }
    if type == AST_TYPE_NAMED {
        Token_drop(ast.value); # nameT
        return free(ast);
    }
    if type == AST_TYPE_STRUCT {
        TreeMap_drop(ast.right); # memberMap
        return free(ast);
    }
    if type == AST_TYPE_MEMBER {
        free(ast.value); # name
        return free(ast);
    }
    if type == AST_MEMBER {
        drop_ast(ast.value); # rcvr
        return free(ast);
    }
    if type == AST_INDEX {
        drop_ast(ast.value); # rcvr
        drop_ast(ast.left); # off_expr
        return free(ast);
    }

    dump_around__(ast);
    char* f = "Can't drop ast of type %i / %x\n";
    eprintf(f, type, type);
    printf(f, type, type);
    exit(62);
}

fn drop_ast_array(void* array) {
    if array == null { return; }
    void* i = array;
    while true {
        void* ast = *i;
        if ast == null { done; }
        drop_ast(ast);
        i = i + 0x8;
    }
    free(array);
}
