# literals are 00x, in promotion order

# [AST_BOOL, value]
pub int AST_BOOL        = 1;
# [AST_CHAR, value]
pub int AST_CHAR        = 2;
# [AST_INT, value]
pub int AST_INT         = 3;

# simple expressions are 0xx

# [AST_STRING, value]
pub int AST_STRING      = 50;
# [AST_ID, nameT]
pub int AST_ID          = 75;

# compound expressions are 1xx

# [AST_UNARY, op, operand]
pub int AST_UNARY       = 101;
# [AST_BINARY, op, *left, *right]
pub int AST_BINARY      = 102;
# [AST_ADDR_OP, op, nameT]
pub int AST_ADDR_OP     = 103;
# [AST_CALL, rcvr, args[]]
pub int AST_CALL        = 104;

# declarations are 3xx

# [AST_PROGRAM, decls[]]
pub int AST_PROGRAM     = 301;
# [AST_DECL, is_pub, fn_or_var]
pub int AST_DECL        = 302;
# [AST_FN, nameT, args[], block?]
pub int AST_FN          = 303;
# [AST_VAR, name_and_type, init?]
pub int AST_VAR         = 304;
# [AST_NAMETYPE, nameT?, T_type, nptr] - todo: deprecated
pub int AST_NAMETYPE    = 305;

# statements are 4xx

# [AST_EVAL, expr]
pub int AST_EVAL        = 401;
# [AST_ASSIGN, expr, rhs]
pub int AST_ASSIGN      = 402;
# [AST_IF, cond, block]
pub int AST_IF          = 403;
# [AST_WHILE, cond, block]
pub int AST_WHILE       = 404;
# [AST_DONE, token]
pub int AST_DONE        = 405;
# [AST_AGAIN, token]
pub int AST_AGAIN       = 406;
# [AST_RETURN, token, expr?]
pub int AST_RETURN      = 407;

# [type, value] 2-tuple
pub fn ast2(int type, void value) {
    void* ast = malloc(0x10);
    ast = ast + 0x8;                # -> value
    *ast = value;
    ast = ast - 0x8;                # -> type
    *ast = type;
    return ast;
}

# [type, value, left] 3-tuple
pub fn ast3(int type, void value, void left) {
    void* ast = malloc(0x18);
    ast = ast + 0x8;                # -> value
    *ast = value;
    ast = ast + 0x8;                # -> left
    *ast = left;
    ast = ast - 0x10;               # -> type
    *ast = type;
    return ast;
}

# [type, value, left, right] 4-tuple
pub fn ast4(int type, void value, void left, void right) {
    void* ast = malloc(0x20);
    ast = ast + 0x8;                # -> value
    *ast = value;
    ast = ast + 0x8;                # -> left
    *ast = left;
    ast = ast + 0x8;                # -> right
    *ast = right;
    ast = ast - 0x18;               # -> type
    *ast = type;
    return ast;
}

pub fn drop_ast(void* ast) {
    if ast == null { return; }
    int type = *ast;
    void* it;

    if type == AST_BOOL {
        return free(ast);
    }
    if type == AST_CHAR {
        return free(ast);
    }
    if type == AST_INT {
        return free(ast);
    }
    if type == AST_STRING {
        it = ast + 0x8;             # -> value
        free(*it);
        return free(ast);
    }
    if type == AST_BINARY {
        it = ast + 0x10;            # -> left
        drop_ast(*it);
        it = ast + 0x18;            # -> right
        drop_ast(*it);
        return free(ast);
    }
    if type == AST_UNARY {
        it = ast + 0x10;            # -> operand
        drop_ast(*it);
        return free(ast);
    }
    if type == AST_FN {
        it = ast + 0x8;             # -> name_token
        Token_drop(*it);
        it = ast + 0x10;            # -> args
        drop_ast_array(*it);
        it = ast + 0x18;            # -> stmts
        drop_ast_array(*it);
        return free(ast);
    }
    if type == AST_NAMETYPE {
        it = ast + 0x8;             # -> name_token
        if *it != null { Token_drop(*it); }
        return free(ast);
    }
    if type == AST_RETURN {
        it = ast + 0x8;             # -> token
        Token_drop(*it);
        it = ast + 0x10;            # -> expr
        drop_ast(*it);
        return free(ast);
    }
    if type == AST_EVAL {
        it = ast + 0x8;             # -> expr
        drop_ast(*it);
        return free(ast);
    }
    if type == AST_VAR {
        it = ast + 0x8;             # -> name_and_type
        drop_ast(*it);
        it = ast + 0x10;            # -> expr
        drop_ast(*it);
        return free(ast);
    }
    if type == AST_ID {
        it = ast + 0x8;             # -> nameT
        Token_drop(*it);
        return free(ast);
    }
    if type == AST_CALL {
        it = ast + 0x8;             # -> rcvr
        drop_ast(*it);
        it = ast + 0x10;            # -> args
        drop_ast_array(*it);
        return free(ast);
    }
    if type == AST_ASSIGN {
        it = ast + 0x8;             # -> lhs
        drop_ast(*it);
        it = ast + 0x10;            # -> rhs
        drop_ast(*it);
        return free(ast);
    }
    if type == AST_IF {
        it = ast + 0x8;             # -> condition
        drop_ast(*it);
        it = ast + 0x10;            # -> body
        drop_ast_array(*it);
        return free(ast);
    }
    if type == AST_WHILE {
        it = ast + 0x8;             # -> condition
        drop_ast(*it);
        it = ast + 0x10;            # -> body
        drop_ast_array(*it);
        return free(ast);
    }
    if type == AST_DONE {
        it = ast + 0x8;             # -> token
        Token_drop(*it);
        return free(ast);
    }
    if type == AST_AGAIN {
        it = ast + 0x8;             # -> token
        Token_drop(*it);
        return free(ast);
    }
    if type == AST_ADDR_OP {
        it = ast + 0x10;            # -> nameT
        Token_drop(*it);
        return free(ast);
    }
    if type == AST_PROGRAM {
        it = ast + 0x8;             # -> decls
        drop_ast_array(*it);
        return free(ast);
    }
    if type == AST_DECL {
        it = ast + 0x10;            # -> fn_or_var
        drop_ast(*it);
        return free(ast);
    }

    char* f = "Can't drop ast of type %i / %x\n";
    eprintf(f, type, type);
    printf(f, type, type);
    exit(62);
}

fn drop_ast_array(void* nodes) {
    if nodes == null { return; }
    void* p = nodes;
    while true {
        void it = *p;
        if it == null { done; }
        drop_ast(it);
        p = p + 0x8;
    }
    free(nodes);
}
