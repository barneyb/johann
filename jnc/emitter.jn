int T_AMP;
int T_ASSIGN;
int T_BANG;
int T_BOOL;
int T_CBRACE;
int T_CHAR;
int T_COMMA;
int T_CPAREN;
int T_EQ;
int T_GT;
int T_ID;
int T_INT;
int T_KW_AGAIN;
int T_KW_BOOL;
int T_KW_CHAR;
int T_KW_DONE;
int T_KW_FN;
int T_KW_IF;
int T_KW_INT;
int T_KW_PUB;
int T_KW_RETURN;
int T_KW_VOID;
int T_KW_WHILE;
int T_LT;
int T_MINUS;
int T_OBRACE;
int T_OPAREN;
int T_PERCENT;
int T_PLUS;
int T_SEMI;
int T_SLASH;
int T_STAR;
int T_STRING;

char* JNC_SHORT_VERSION;

bool IS_PUB = false; # this is just ridiculous

char* ERR_BAD_TOKEN         = "ERROR(%i): Bad token %x at line %i, char %i\n";
char* ERR_BAD_OPERATOR      = "ERROR(%i): Bad operator %x at line %i, char %i\n";
char* ERR_BAD_EXPRESSION    = "ERROR(%i): Bad expression %x at line %i, char %i\n";
char* ERR_NONLOCAL_PARAM    = "ERROR(%i): non-local param (%x) at line %i, char %i\n";
char* ERR_TOO_MANY_PARAMS   = "ERROR(%i): too many call params (%x) at line %i, char %i\n";
char* ERR_DUPE_DECL         = "ERROR(%i): Duplicate declaration of '%s' at line %i, char %i\n";
char* ERR_TOO_MANY_LOCALS   = "ERROR(%i): Only eight local vars are allowed; '%s' is a ninth at line %i, char %i\n";
char* ERR_UNKNOWN_SYMBOL    = "ERROR(%i): Unknown symbol '%s' at line %i, char %i\n";
char* ERR_INVALID_NESTING   = "ERROR(%i): Invalid nesting %x at line %i, char %i\n";
char* ERR_BAD_STMT          = "ERROR(%i): Bad statement %x at line %i, char %i\n";

char* TMPL_PRELUDE              = "; Compiled with %s\n    .text\n    .align  3\n    NULL  = 0\n    TRUE  = 1\n    FALSE = 0\n";

char* TMPL_GLOBAL_PUB           = "    .global _j_gbl_%s\n";
char* WIDTH_BYTE   = ".byte";
char* WIDTH_QUAD   = ".quad";
char* TMPL_GLOBAL_NUM           = "    .data\n        _j_gbl_%s: %s %i\n    .text\n";
char* TMPL_GLOBAL_CHAR          = "    .data\n        _j_gbl_%s: %s '%c'\n    .text\n";
char* TMPL_GLOBAL_STRING        = "    .data\n        _j_gbl_%s: .asciz %c%s%c\n    .text\n";

char* TMPL_FN_ARG               = "        str     x%i, [fp, -%x]\n";

char* TMPL_FN_PUB               = "    .global __j_%s\n";
char* TMPL_FN_INTRO             = "    __j_%s:\n        stp     fp, lr, [sp, -0x10]!\n        mov     fp, sp\n            ; todo: this is enough space for the same 8 locals as before\n            sub sp, sp, 0x40\n";

char* TMPL_MAIN_PUB             = "    .global _main\n";
char* TMPL_MAIN                 = "    _main:\n        bl      __j_main\n        b       __j_exit\n\n";

char* TMPL_FN_OUTRO             = "        mov      x0, #0\n        _return_%i:\n            ; todo: this was enough space for the same 8 locals as before\n            add sp, sp, 0x40\n        ldp     fp, lr, [sp], 0x10\n        ret\n\n\n";
char* TMPL_IF_OUTRO             = "        if_%i_done:\n";
char* TMPL_WHILE_OUTRO          = "        b     while_%i_again\n        while_%i_done:\n";

char* TMPL_RETURN               = "        b       _return_%i\n";

char* TMPL_IF_INTRO             = "        cmp     x0, FALSE\n        b.eq    if_%i_done\n";

char* TMPL_WHILE_PRELUDE        = "        while_%i_again:\n";
char* TMPL_WHILE_INTRO          = "        cmp     x0, FALSE\n        b.eq    while_%i_done\n";
char* TMPL_WHILE_AGAIN          = "        b       while_%i_again\n";
char* TMPL_WHILE_DONE           = "        b       while_%i_done\n";

char* TMPL_ASSIGN_LOCAL         = "        str     x0, [fp, -%x]\n";
char* TMPL_ASSIGN_GLOBAL_BYTE   = "        adrp    x7, _j_gbl_%s@PAGE\n        add     x7, x7, _j_gbl_%s@PAGEOFF\n        strb    w0, [x7]\n";
char* TMPL_ASSIGN_GLOBAL_QUAD   = "        adrp    x7, _j_gbl_%s@PAGE\n        add     x7, x7, _j_gbl_%s@PAGEOFF\n        str     x0, [x7]\n";

char* TMPL_GET_ADDR_LOCAL       = "        ldr     x7, [fp, -%x]\n";
char* TMPL_GET_ADDR_GLOBAL      = "        adrp    x7, _j_gbl_%s@PAGE\n        add     x7, x7, _j_gbl_%s@PAGEOFF\n";
char* TMPL_ASSIGN_PTR_BYTE      = "        strb    w0, [x7]\n";
char* TMPL_ASSIGN_PTR_QUAD      = "        str     x0, [x7]\n";

char* TMPL_CALL_PARAM           = "        ldr     x%i, [fp, -%x]\n";
char* TMPL_CALL                 = "        bl      __j_%s\n";
char* TMPL_CALL_PTR_INTRO       = "        str     x0, [sp, -0x10]!\n";
char* TMPL_CALL_PTR             = "        ldr     x16, [sp], 0x10\n        blr     x16\n";

char* TMPL_UN_NOT               = "        cmp     x0, FALSE\n        b.ne    expr_%i_was_true\n        mov     x0, TRUE\n        b       expr_%i_end\n        expr_%i_was_true:\n        mov     x0, FALSE\n        expr_%i_end:\n";
char* TMPL_UN_NEGATE            = "        neg     x0, x0\n";

char* TMPL_STASH                = "        str     x0, [sp, -0x10]!\n";
char* TMPL_UNSTASH_X1           = "        ldr     x1, [sp], 0x10\n";

char* TMPL_BIN_ADD              = "        add     x0, x0, x1\n";
char* TMPL_BIN_SUB              = "        sub     x0, x0, x1\n";
char* TMPL_BIN_MUL              = "        mul     x0, x0, x1\n";
char* TMPL_BIN_DIV              = "        sdiv    x0, x0, x1\n";
char* TMPL_BIN_MOD              = "        sdiv    x2, x0, x1\n        msub    x0, x2, x1, x0\n";

char* COMP_GT = "gt";
char* COMP_LT = "lt";
char* COMP_EQ = "eq";
char* COMP_NE = "ne";
char* TMPL_BIN_LOGICAL          = "        cmp     x0, x1\n        b.%s    expr_%i\n        mov     x0, FALSE\n        b       expr_%i_end\n        expr_%i:\n        mov     x0, TRUE\n        expr_%i_end:\n";

char* TMPL_VALUE_STRING         = "        .data\n          _j_str_%i: .asciz %c%s%c\n        .text\n        adrp    x0, _j_str_%i@PAGE\n        add     x0, x0, _j_str_%i@PAGEOFF\n";
char* TMPL_VALUE_INT            = "        mov     x0, #%i\n";
char* TMPL_VALUE_INT_LARGE      = "        .data\n          _j_int_%i: .quad %x ; %i\n        .text\n        adrp    x0, _j_int_%i@PAGE\n        add     x0, x0, _j_int_%i@PAGEOFF\n        ldr     x0, [x0]\n";
char* TMPL_VALUE_OF_LOCAL       = "        ldr     x0, [fp, -%x]\n";

# "add-a-negative" so it matches the addressing offsets
char* TMPL_ADDR_LOCAL           = "        add     x0, fp, -%x\n";
char* TMPL_ADDR_GLOBAL          = "        adrp    x0, _j_gbl_%s@PAGE\n        add     x0, x0, _j_gbl_%s@PAGEOFF\n";
char* TMPL_ADDR_FN              = "        adrp    x0, __j_%s@PAGE\n        add     x0, x0, __j_%s@PAGEOFF\n";

char* TMPL_BYTE_AT_ADDR         = "        ldrb    w0, [x0]\n";
char* TMPL_QUAD_AT_ADDR         = "        ldr     x0, [x0]\n";

# struct Emitter {
#   int seq                         ; sequence for unique label names
#   int depth
#   [Block] blocks                  ; array/stack of "lexical" Blocks
# }

int SIZEOF_BLOCK;
int BLOCKS_CAP = 10;

pub fn Emitter__new() {
    int bytes = SIZEOF_BLOCK * BLOCKS_CAP;
    bytes = bytes + 0x10;
    void* self = malloc(bytes);
    *self = 0;
    self = self + 0x8;              # -> depth
    *self = 0;
    self = self - 0x8;              # -> seq
    int type = null;
    Emitter_enter_block(self, type);
    char* tmpl = TMPL_PRELUDE;
    char* ver = JNC_SHORT_VERSION;
    printf(tmpl, ver);
    return self;
}

pub fn Emitter_drop(void* self) {
    void* block = Emitter_leave_block(self);
    Block_drop(block);
    free(self);
}

fn Emitter_seqnum(void* self) {
    int seq = *self;
    seq = seq + 1;
    *self = seq;
    return seq;
}

fn Emitter_enter_block(void* self, int type) {
    int id = Emitter_seqnum(self);
    self = self + 0x8;             # -> depth
    int depth = *self;
    void* blocks = self + 0x8;
    depth = depth * SIZEOF_BLOCK;
    void* block = blocks + depth;
    Block_init(block, type, id);
    depth = *self;
    depth = depth + 1;
    *self = depth;
    return block;
}

fn Emitter_current_block(void* self) {
    void* blocks = self + 0x10;
    self = self + 0x8;             # -> depth
    int depth = *self;
    depth = depth - 1;
    depth = depth * SIZEOF_BLOCK;
    blocks = blocks + depth;
    return blocks;
}

fn Emitter_is_global(void* self) {
    self = self + 0x8;             # -> depth
    int depth = *self;
    return depth = 1;
}

fn Emitter_innermost_block_of(void* self, int type, void* token) {
    self = self + 0x8;             # -> depth
    int depth = *self;
    void* blocks = self + 0x8;
    while depth > 0 {
        depth = depth - 1;
        void* block = depth * SIZEOF_BLOCK;
        block = block + blocks;
        int t = Block_type(block);
        if type = t {
            return block;
        }
    }

    # out of blocks
    char* err = ERR_INVALID_NESTING;
    depth = 37;
    jnc_panic(err, token, depth);
}

fn Emitter_leave_block(void* self) {
    self = self + 0x8;             # -> depth
    int depth = *self;
    depth = depth - 1;
    *self = depth;
    self = self + 0x8;             # -> blocks
    void* block = depth * SIZEOF_BLOCK;
    block = block + self;
    return block;
}

fn Emitter_lookup_symbol_for(void* self, void* id_token, bool allow_null) {
    char* name = Token_value(id_token);
    return Emitter_lookup_symbol_by_name_and_token(self, name, id_token, allow_null);
}

fn Emitter_lookup_symbol_by_name_and_token(void* self, char* name, void* t, bool allow_null) {
    self = self + 0x8;             # -> depth
    int depth = *self;
    void* blocks = self + 0x8;
    while depth > 0 {
        depth = depth - 1;
        void* symbols = depth * SIZEOF_BLOCK;
        symbols = symbols + blocks;
        symbols = Block_symbols(symbols);
        void* sym = Table_get(symbols, name);
        if sym ! null {
            return sym;
        }
    }

    # out of blocks
    if allow_null {
        return null;
    }
    Token_set_type(t, name);
    name = ERR_UNKNOWN_SYMBOL;
    depth = 22;
    jnc_panic(name, t, depth);
}

pub fn Emitter_emit(void* self, void* buffer) {
    void* token = *buffer;          # first token
    int type = Token_type(token);
    IS_PUB = type = T_KW_PUB;
    if IS_PUB {
        buffer = buffer + 0x8;      # skip it
        token = *buffer;            # new first token
        type = Token_type(token);
    }

    if type = T_SEMI { return; }
    if type = T_KW_FN { return Emitter_do_fn(self, buffer); }
    if type = T_KW_INT { return Emitter_do_decl(self, buffer); }
    if type = T_KW_CHAR { return Emitter_do_decl(self, buffer); }
    if type = T_KW_BOOL { return Emitter_do_decl(self, buffer); }
    if type = T_KW_VOID { return Emitter_do_decl(self, buffer); }
    if type = T_KW_WHILE { return Emitter_do_while(self, buffer); }
    if type = T_KW_AGAIN { return Emitter_do_again(self, buffer); }
    if type = T_KW_DONE { return Emitter_do_done(self, buffer); }
    if type = T_KW_IF { return Emitter_do_if(self, buffer); }
    if type = T_KW_RETURN { return Emitter_do_return(self, buffer); }
    if type = T_CBRACE { return Emitter_do_close_block(self, buffer); }
    if type = T_STAR { return Emitter_do_assign_pointer(self, buffer); }

    # now the second token...
    token = buffer + 0x8;
    token = *token;
    type = Token_type(token);

    if type = T_ASSIGN { return Emitter_do_assign(self, buffer); }
    if type = T_OPAREN { return Emitter_do_call(self, buffer); }

    char* err = ERR_BAD_STMT;
    token = *buffer;
    type = 27;
    jnc_panic(err, token, type);
}

fn Emitter_vardecl(void* self, void* buffer) {
    void* token = decl_id_token(buffer);
    char* name = Token_value(token);
    void* symbols = decl_symbols(self, token);
    # now the type info
    int nptr = decl_num_pointers(buffer);
    token = *buffer;
    int type = Token_type(token);
    void* symbol = Symbol__new(type, nptr);
    # reuse type for offset, because "8 vars"
    type = Emitter_is_global(self);
    type = ! type;
    if type {
        type = Table_size(symbols);
        type = type + 1; # local vars are one-indexed
    }
    Symbol_set_offset(symbol, type);
    name = strclone(name);
    Table_put(symbols, name, symbol);
    return symbol;
}

fn decl_symbols(void* self, void* id_token) {
    void * block;
    bool global = Emitter_is_global(self);
    int n;
    if global {
        block = Emitter_current_block(self);
    }
    if ! global {
        n = T_KW_FN;
        block = Emitter_innermost_block_of(self, n, id_token);
    }
    void* symbols = Block_symbols(block);
    char* name = Token_value(id_token);
    if Table_contains(symbols, name) {
        # munge for panic
        Token_set_type(id_token, name);
        name = ERR_DUPE_DECL;
        n = 22;
        jnc_panic(name, id_token, n);
    }
    if ! global {
        n = Table_size(symbols);
        if n > 7 {
            # already have eight
            Token_set_type(id_token, name);
            name = ERR_TOO_MANY_LOCALS;
            n = 24;
            jnc_panic(name, id_token, n);
        }
    }
    return symbols;
}

fn decl_num_pointers(void* buffer) {
    int nptr = 0;
    while true {
        buffer = buffer + 0x8;
        void token = *buffer;
        int type = Token_type(token);
        if type ! T_STAR {
            return nptr;
        }
        nptr = nptr + 1;
    }
}

fn decl_id_token(void* buffer) {
    while true {
        buffer = buffer + 0x8;
        void token = *buffer;
        int type = Token_type(token);
        if type = T_ID {
            return token;
        }
    }
}

fn Emitter_do_decl(void* self, void* buffer) {
    void* symbol = Emitter_vardecl(self, buffer);

    # scan until ASSIGN or SEMI to indicate end of declaration.
    void* buf_i = buffer + 0x8; # first token is type
    void* token;
    int type;
    while true {
        buf_i = buf_i + 0x8;
        token = *buf_i;
        type = Token_type(token);
        if type = T_ASSIGN { done; }
        if type = T_SEMI   { return; }
    }
    buf_i = buf_i - 0x8; # go back one (to id)

    bool global = Emitter_is_global(self);
    if !global {
        return Emitter_do_assign(self, buf_i);
    }
    token = *buf_i;
    buf_i = buf_i + 0x10;
    void* value_token = *buf_i;
    decl_global(self, token, value_token, symbol);
}

fn decl_global(void* self, void* id_token, void* value_token, void* symbol) {
    char* name = Token_value(id_token);
    if IS_PUB {
        char* tmpl = TMPL_GLOBAL_PUB;
        printf(tmpl, name);
    }
    void value = Token_value(value_token);
    int type = Token_type(value_token);
    # strings are easy, storage and value must both be strings
    if type = T_STRING {
        return decl_global_string(name, value);
    }
    # the rest are messy, as any type of value can initialize any size of storage
    decl_global_num(symbol, name, type, value);
}

fn decl_global_num(void* symbol, char* name, int val_type, char* value) {
    int var_width = Symbol_width(symbol);
    char* width;
    if var_width = 1 {
        width = WIDTH_BYTE;
    }
    if var_width ! 1 {
        width = WIDTH_QUAD;
    }
    char* tmpl;
    if val_type = T_CHAR {
        tmpl = TMPL_GLOBAL_CHAR;
    }
    if val_type ! T_CHAR {
        tmpl = TMPL_GLOBAL_NUM;
    }
    return printf(tmpl, name, width, value);
}

fn decl_global_string(char* name, char* value) {
    char* tmpl = TMPL_GLOBAL_STRING;
    char q = '"';
    return printf(tmpl, name, q, value, q);
}

fn Emitter_do_fn(void* self, void* buffer) {
    void* token = buffer + 0x8;     # -> name token
    token = *token;
    char* name = Token_value(token);
    fn_symbol(self, name);

    if is_fn_prototype(buffer) {
        return;
    }

    introduce_fn(self, name);

    void* buf_i = buffer + 0x18;          # -> first arg or close paren
    int reg_offset = 0;
    while true {
        token = *buf_i;
        int type = Token_type(token);
        if type = T_CPAREN { return; }
        # introduce a local variable
        bool decl = false;
        if type = T_KW_INT  { decl = true; }
        if type = T_KW_CHAR { decl = true; }
        if type = T_KW_BOOL { decl = true; }
        if type = T_KW_VOID { decl = true; }
        if decl {
            Emitter_vardecl(self, buf_i);
            buf_i = buf_i + 0x8;
            again;
        }
        # read the argument
        if type = T_ID {
            read_fn_arg(self, token, reg_offset);
            reg_offset = reg_offset + 1;
        }
        buf_i = buf_i + 0x8;
    }
}

fn fn_symbol(void* self, char* name) {
    name = strclone(name);
    void* block = Emitter_current_block(self);
    void* symbols = Block_symbols(block);
    int type = T_KW_FN;
    int zero = 0;
    void* symbol = Symbol__new(type, zero);
    void* old = Table_put(symbols, name, symbol);
    if old ! null {
        free(name);
        free(old);
    }
}

fn is_fn_prototype(void* buffer) {
    # if there's a SEMI instead of an OBRACE, it's a prototype
    void* bi = buffer;
    while true {
        void* t = *bi;
        int type = Token_type(t);
        if type = T_SEMI   { return  true; }
        if type = T_OBRACE { return false; }
        bi = bi + 0x8;
    }
}

fn read_fn_arg(void* self, void* token, int reg_offset) {
    void* symbol = Emitter_lookup_symbol_for(self, token);
    int offset = Symbol_offset(symbol);
    offset = offset * 0x8;
    char* tmpl = TMPL_FN_ARG;
    printf(tmpl, reg_offset, offset);
}

fn introduce_fn(void* self, char* name) {
    int kw = T_KW_FN;
    Emitter_enter_block(self, kw);
    bool is_pub = IS_PUB;
    introduce_main(name, is_pub);
    char* tmpl;
    if is_pub {
        tmpl = TMPL_FN_PUB;
        printf(tmpl, name);
    }
    tmpl = TMPL_FN_INTRO;
    printf(tmpl, name);
}

fn introduce_main(char* name, bool is_pub) {
    char* tmpl = "main";
    int cmp = strcmp(tmpl, name);
    if cmp ! 0 { return; }
    if is_pub {
        tmpl = TMPL_MAIN_PUB;
        printf(tmpl);
    }
    tmpl = TMPL_MAIN;
    printf(tmpl);
}

fn Emitter_do_close_block(void* self, void* buffer) {
    void* block = Emitter_leave_block(self);
    int id = Block_id(block);
    int type = Block_type(block);
    Block_drop(block);
    char* tmpl;
    if type = T_KW_FN {
        tmpl = TMPL_FN_OUTRO;
        printf(tmpl, id);
    }
    if type = T_KW_IF {
        tmpl = TMPL_IF_OUTRO;
        printf(tmpl, id);
    }
    if type = T_KW_WHILE {
        tmpl = TMPL_WHILE_OUTRO;
        printf(tmpl, id, id);
    }
}

fn Emitter_do_return(void* self, void** buffer) {
    int kw = T_KW_FN;
    void* token = *buffer;
    void* block = Emitter_innermost_block_of(self, kw, token);
    int id = Block_id(block);
    token = buffer + 8;
    token = *token;
    kw = T_SEMI;
    int type = Token_type(token);
    if type ! kw {
        buffer = buffer + 8;
        Emitter_expr(self, buffer);
    }
    char* tmpl = TMPL_RETURN;
    printf(tmpl, id);
}

fn Emitter_do_if(void* self, void* buffer) {
    char* prelude = null;
    char* intro = TMPL_IF_INTRO;
    do_conditional(self, buffer, prelude, intro);
}

fn Emitter_do_while(void* self, void* buffer) {
    char* prelude = TMPL_WHILE_PRELUDE;
    char* intro = TMPL_WHILE_INTRO;
    do_conditional(self, buffer, prelude, intro);
}

fn do_conditional(void* self, void* buffer, char* prelude, char* intro) {
    void* token = *buffer; # keyword
    buffer = buffer + 0x8; # conditional expression
    char* type = Token_type(token);
    void* block = Emitter_enter_block(self, type, token);
    int id = Block_id(block);
    if prelude ! null { printf(prelude, id); }
    Emitter_expr(self, buffer);
    if intro ! null { printf(intro, id); }
}

fn Emitter_do_again(void* self, void* buffer) {
    char* tmpl = TMPL_WHILE_AGAIN;
    loop_control_flow(self, buffer, tmpl);
}

fn Emitter_do_done(void* self, void* buffer) {
    char* tmpl = TMPL_WHILE_DONE;
    loop_control_flow(self, buffer, tmpl);
}

fn loop_control_flow(void* self, void* buffer, char* tmpl) {
    void* token = *buffer;
    char* kw = T_KW_WHILE;
    void* block = Emitter_innermost_block_of(self, kw, token);
    int id = Block_id(block);
    printf(tmpl, id);
}

fn Emitter_do_assign(void* self, void* buffer) {
    void* token = *buffer; # LHS
    buffer = buffer + 0x10; # RHS
    Emitter_expr(self, buffer);

    void* symbol = Emitter_lookup_symbol_for(self, token);
    int offset = Symbol_offset(symbol);
    char* tmpl;
    if offset > 0 {
        # local
        tmpl = TMPL_ASSIGN_LOCAL;
        offset = offset * 0x8;
        return printf(tmpl, offset);
    }
    # global
    char* name = Token_value(token);
    int width = Symbol_width(symbol);
    if width = 1 {
        tmpl = TMPL_ASSIGN_GLOBAL_BYTE;
    }
    if width ! 1 {
        tmpl = TMPL_ASSIGN_GLOBAL_QUAD;
    }
    printf(tmpl, name, name);
}

fn Emitter_do_assign_pointer(void* self, void* buffer) {
    buffer = buffer + 0x8; # name
    void* token = *buffer;
    buffer = buffer + 0x10; # RHS
    Emitter_expr(self, buffer);

    # compute address
    void* symbol = Emitter_lookup_symbol_for(self, token);
    int offset = Symbol_offset(symbol);
    char* tmpl;
    if offset > 0 {
        # local
        tmpl = TMPL_GET_ADDR_LOCAL;
        offset = offset * 0x8;
        printf(tmpl, offset);
    }
    if offset < 1 {
        # global
        tmpl = TMPL_GET_ADDR_GLOBAL;
        char* name = Token_value(token);
        printf(tmpl, name, name);
    }

    # now write to address
    tmpl = TMPL_ASSIGN_PTR_BYTE;
    int n = Symbol_width(symbol);
    if n ! 1 {
        tmpl = TMPL_ASSIGN_PTR_QUAD;
    }
    n = Symbol_nptr(symbol);
    if n > 1 {
        tmpl = TMPL_ASSIGN_PTR_QUAD;
    }
    printf(tmpl);
}

fn Emitter_expr(void* self, void* buffer) {
    # start with the second token
    void* token = buffer + 0x8;
    token = *token;
    int type = Token_type(token);

    if type = T_SEMI {
        # copy/assignment
        token = *buffer;
        return Emitter_do_token(self, token);
    }
    if type = T_OBRACE {
        # simple conditional (if/while)
        token = *buffer;
        return Emitter_do_token(self, token);
    }
    if type = T_OPAREN {
        # function call
        return Emitter_do_call(self, buffer);
    }
    if type = T_BANG    { return Emitter_do_binary_op(self, buffer); }
    if type = T_EQ      { return Emitter_do_binary_op(self, buffer); }
    if type = T_GT      { return Emitter_do_binary_op(self, buffer); }
    if type = T_LT      { return Emitter_do_binary_op(self, buffer); }
    if type = T_MINUS   { return Emitter_do_binary_op(self, buffer); }
    if type = T_PERCENT { return Emitter_do_binary_op(self, buffer); }
    if type = T_PLUS    { return Emitter_do_binary_op(self, buffer); }
    if type = T_SLASH   { return Emitter_do_binary_op(self, buffer); }
    if type = T_STAR    { return Emitter_do_binary_op(self, buffer); }

    # now the first token...
    token = *buffer;
    type = Token_type(token);
    if type = T_AMP   { return Emitter_do_unary_op(self, buffer); }
    if type = T_BANG  { return Emitter_do_unary_op(self, buffer); }
    if type = T_MINUS { return Emitter_do_unary_op(self, buffer); }
    if type = T_STAR  { return Emitter_do_unary_op(self, buffer); }

    char* tmpl = ERR_BAD_EXPRESSION;
    type = 28;
    jnc_panic(tmpl, token, type);
}

fn Emitter_do_call(void* self, void* buffer) {
    void* token = *buffer; # first token is the name of the function
    bool allow_null = true;
    void* symbol = Emitter_lookup_symbol_for(self, token, allow_null);
    char* tmpl;
    if symbol ! null {
        # function pointer - do setup first, as it corrupts x0
        do_address_of(self, token, symbol);
        int nptr = Symbol_nptr(symbol);
        if nptr > 0 {
            do_load_addr(self, token, symbol);
        }
        tmpl = TMPL_CALL_PTR_INTRO;
        printf(tmpl);
    }

    call_params(self, buffer);

    if symbol ! null {
        # call the function pointer
        tmpl = TMPL_CALL_PTR;
        return
        printf(tmpl);
    }
    # anonymous - hope it's there!
    tmpl = TMPL_CALL;
    char* name = Token_value(token);
    printf(tmpl, name);
}

fn call_params(void* self, void* buffer) {
    void* buf_i = buffer + 0x10; # buffer[2] is either first arg or close paren
    void* token;
    int reg_offset = 0;
    char* tmpl = TMPL_CALL_PARAM; # not guaranteed to need this, but likely
    while true {
        token = *buf_i;
        buf_i = buf_i + 0x8;
        int type = Token_type(token);
        if type = T_CPAREN { done; }
        if type = T_COMMA { again; }
        if reg_offset = 8 {
            too_many_params(token);
        }
        if type ! T_ID {
            # only variable derefs
            return non_local_param(token);
        }
        void* symbol = Emitter_lookup_symbol_for(self, token);
        type = Symbol_offset(symbol);
        if type < 1 {
            # and not globals, only locals
            return non_local_param(token);
        }
        type = type * 0x8;
        printf(tmpl, reg_offset, type);
        reg_offset = reg_offset + 1;
    }
}

fn non_local_param(void* token) {
    char* err = ERR_NONLOCAL_PARAM;
    int status = 25;
    jnc_panic(err, token, status);
}

fn too_many_params(void* token) {
    char* err = ERR_TOO_MANY_PARAMS;
    int status = 21;
    jnc_panic(err, token, status);
}

fn Emitter_do_unary_op(void* self, void* buffer) {
    # first token is the operator
    void* token = *buffer;
    int type = Token_type(token);
    # second token is the operand
    token = buffer + 0x8;
    token = *token;

    char* tmpl;
    void* symbol = null;
    if type = T_AMP {
        symbol = Emitter_lookup_symbol_for(self, token);
        return do_address_of(self, token, symbol);
    }

    Emitter_do_token(self, token);
    if type = T_STAR {
        symbol = Emitter_lookup_symbol_for(self, token);
        return do_load_addr(self, token, symbol);
    }
    if type = T_BANG {
        type = Emitter_seqnum(self);
        tmpl = TMPL_UN_NOT;
        return printf(tmpl, type, type, type, type);
    }
    if type = T_MINUS {
        tmpl = TMPL_UN_NEGATE;
        return printf(tmpl);
    }

    tmpl = ERR_BAD_OPERATOR;
    token = *buffer; # want to point at the operator, not the operand
    type = 29;
    jnc_panic(tmpl, token, type);
}

fn Emitter_do_binary_op(void* self, void* buffer) {
    # third token is right operand
    void* token = buffer + 0x10;
    token = *token;
    Emitter_do_token(self, token);
    char* tmpl = TMPL_STASH;
    printf(tmpl);

    # first token is the left operand
    token = *buffer;
    Emitter_do_token(self, token);

    # restore the right operand
    tmpl = TMPL_UNSTASH_X1;
    printf(tmpl);

    # second token is operator
    token = buffer + 0x8;
    token = *token;
    int type = Token_type(token);

    if type = T_PLUS    { tmpl = TMPL_BIN_ADD; return printf(tmpl); }
    if type = T_MINUS   { tmpl = TMPL_BIN_SUB; return printf(tmpl); }
    if type = T_STAR    { tmpl = TMPL_BIN_MUL; return printf(tmpl); }
    if type = T_SLASH   { tmpl = TMPL_BIN_DIV; return printf(tmpl); }
    if type = T_PERCENT { tmpl = TMPL_BIN_MOD; return printf(tmpl); }

    if type = T_EQ   { tmpl = COMP_EQ; return do_binary_op_logical(self, tmpl); }
    if type = T_BANG { tmpl = COMP_NE; return do_binary_op_logical(self, tmpl); }
    if type = T_LT   { tmpl = COMP_LT; return do_binary_op_logical(self, tmpl); }
    if type = T_GT   { tmpl = COMP_GT; return do_binary_op_logical(self, tmpl); }

    char* err = ERR_BAD_OPERATOR;
    int status = 29;
    jnc_panic(err, token, status);
}

fn do_binary_op_logical(void* self, char* comp) {
    int seq = Emitter_seqnum(self);
    char* tmpl = TMPL_BIN_LOGICAL;
    printf(tmpl, comp, seq, seq, seq, seq);
}

fn Emitter_do_token(void* self, void* token) {
    int type = Token_type(token);
    if type = T_BOOL { return do_token_num(self, token); }
    if type = T_CHAR { return do_token_num(self, token); }
    if type = T_INT  { return do_token_num(self, token); }
    if type = T_ID   { return Emitter_do_value_id(self, token); }
    if type = T_STRING {
        char* value = Token_value(token);
        return Emitter_do_value_string(self, value);;
    }
    char* err = ERR_BAD_TOKEN;
    int status = 26;
    jnc_panic(err, token, status);
}

fn do_token_num(void* self, void* token) {
    int value = Token_value(token);
    Emitter_do_value_integer(self, value);
}

fn Emitter_do_value_string(void* self, char* name) {
    int seq = Emitter_seqnum(self);
    char q = '"';
    char* tmpl = TMPL_VALUE_STRING;
    printf(tmpl, seq, q, name, q, seq, seq);
}

fn Emitter_do_value_integer(void* self, int i) {
    # todo: compound expressions sure would be handy...
    if i > 32767 {
        Emitter_do_value_integer_large(self, i);
        return null;
    } # todo: where's my else?!
    if i < -32767 {
        Emitter_do_value_integer_large(self, i);
        return null;
    }
    char* tmpl = TMPL_VALUE_INT;
    printf(tmpl, i);
}

fn Emitter_do_value_integer_large(void* self, int i) {
    int seq = Emitter_seqnum(self);
    char* tmpl = TMPL_VALUE_INT_LARGE;
    printf(tmpl, seq, i, i, seq, seq);
}

fn Emitter_do_value_id(void* self, void* t) {
    void* symbol = Emitter_lookup_symbol_for(self, t);
    int offset = Symbol_offset(symbol);
    char* tmpl;

    if offset > 0 {
        # local
        offset = offset * 0x8;
        tmpl = TMPL_VALUE_OF_LOCAL;
        return printf(tmpl, offset);
    }
    # global
    do_address_of(self, t, symbol);
    int nptr = Symbol_nptr(symbol);
    if nptr = 0 {
        do_load_addr(self, t, symbol);
    }
}

fn do_address_of(void* self, void* token, void* symbol) {
    int offset = Symbol_offset(symbol);
    char* tmpl;
    if offset > 0 {
        # local
        tmpl = TMPL_ADDR_LOCAL;
        offset = offset * 0x8;
        return printf(tmpl, offset);
    }
    # global
    int type = Symbol_type(symbol);
    if type = T_KW_FN {
        tmpl = TMPL_ADDR_FN;
    }
    if type ! T_KW_FN {
        tmpl = TMPL_ADDR_GLOBAL;
    }
    char* name = Token_value(token);
    printf(tmpl, name, name);
}

fn do_load_addr(void* self, void* token, void* symbol) {
    char* tmpl;
    int width = Symbol_width(symbol);
    if width ! 1 {
        tmpl = TMPL_QUAD_AT_ADDR;
        return printf(tmpl);
    }
    int nptr = Symbol_nptr(symbol);
    if nptr > 1 {
        tmpl = TMPL_QUAD_AT_ADDR;
        return printf(tmpl);
    }
    tmpl = TMPL_BYTE_AT_ADDR;
    printf(tmpl);
}
