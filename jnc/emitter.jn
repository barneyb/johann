struct Block;
struct Token;
struct Symbol;

char* JNC_SHORT_VERSION;

void ENV;
bool STRICT;

pub char* NAME_MAIN = "main";

char* ERR_DUPE_DECL         = "ERROR(%i): Duplicate declaration of '%s' at line %i, col %i\n";
char* ERR_UNKNOWN_SYMBOL    ; # shared with parser
char* ERR_INVALID_NESTING   = "ERROR(%i): Invalid nesting %x at line %i, col %i\n";
char* ERR_UNKNOWN_FN        = "ERROR(%i): Unknown function '%s' at line %i, col %i\n";
char* ERR_WRONG_FN_ARGS     = "ERROR(%i): Function call expects %i params (methods expect one fewer) at line %i, col %i\n";

char* TMPL_PRELUDE              = "; Compiled with %s\n    .text\n    .align  3\n    NULL  = 0\n    TRUE  = 1\n    FALSE = 0\n";
char* TMPL_GLOBAL               = ".global __j_%s\n";
char* TMPL_GLOBAL_MAIN          = ".global _main\n";
char* TMPL_MAIN                 = "    _main:\n        bl      __j_main\n        b       __j_exit\n\n";

char* WIDTH_BYTE   = ".byte";
char* WIDTH_QUAD   = ".quad";
char* TMPL_GLOBAL_NUM           = "    .data\n        __j_%s: %s %i\n    .text\n";
char* TMPL_GLOBAL_CHAR          = "    .data\n        __j_%s: %s '%c'\n    .text\n";
char* TMPL_GLOBAL_STRING        = "    .data\n        __j_%s: .asciz %c%s%c\n    .text\n";

char* TMPL_FN_ARG               = "        str     x%i, [fp, -%x]\n";
char* TMPL_FN_INTRO             = "    __j_%s:\n        stp     fp, lr, [sp, -0x10]!\n        mov     fp, sp\n            sub sp, sp, %x ; fn intro\n";
char* TMPL_FN_OUTRO             = "        mov      x0, #0\n        _return_%i:\n            add sp, sp, %x ; fn outro\n        ldp     fp, lr, [sp], 0x10\n        ret\n\n\n";

char* TMPL_RETURN               = "        b       _return_%i\n";

char* TMPL_IF_INTRO             = "        cmp     x0, FALSE\n        b.eq    if_%i_done\n";
char* TMPL_IF_ELSE_INTRO        = "        cmp     x0, FALSE\n        b.eq    if_%i_else\n";
char* TMPL_ELSE_PRELUDE         = "        b       if_%i_done\n        if_%i_else:\n";
char* TMPL_IF_OUTRO             = "        if_%i_done:\n";

char* TMPL_WHILE_PRELUDE        = "        while_%i_again:\n";
char* TMPL_WHILE_INTRO          = "        cmp     x0, FALSE\n        b.eq    while_%i_done\n";
char* TMPL_WHILE_AGAIN          = "        b       while_%i_again\n";
char* TMPL_WHILE_DONE           = "        b       while_%i_done\n";
char* TMPL_WHILE_OUTRO          = "        b     while_%i_again\n        while_%i_done:\n";

char* TMPL_ASSIGN_LOCAL         = "        str     x0, [fp, -%x]\n";
char* TMPL_ASSIGN_GLOBAL_BYTE   = "        adrp    x7, __j_%s@PAGE\n        add     x7, x7, __j_%s@PAGEOFF\n        strb    w0, [x7]\n";
char* TMPL_ASSIGN_GLOBAL_QUAD   = "        adrp    x7, __j_%s@PAGE\n        add     x7, x7, __j_%s@PAGEOFF\n        str     x0, [x7]\n";

char* TMPL_GET_ADDR_LOCAL       = "        ldr     x7, [fp, -%x]\n";
char* TMPL_GET_ADDR_GLOBAL      = "        adrp    x7, __j_%s@PAGE\n        add     x7, x7, __j_%s@PAGEOFF\n";
char* TMPL_GET_ADDR_MEMBER      = "        add     x7, x7, %i\n";
char* TMPL_MOV_Xi_FOR_ASSIGN_PTR= "        mov     x7, x%i\n";
char* TMPL_ASSIGN_PTR_BYTE      = "        strb    w0, [x7]\n";
char* TMPL_ASSIGN_PTR_QUAD      = "        str     x0, [x7]\n";

char* TMPL_CALL_PARAM           = "        ldr     x%i, [fp, -%x]\n";
char* TMPL_CALL                 = "        bl      __j_%s\n";
char* TMPL_CALL_PTR_INTRO       = "        str     x0, [sp, -0x10]!\n";
char* TMPL_CALL_PTR             = "        ldr     x16, [sp], 0x10\n        blr     x16\n";
char* TMPL_READ_MEMBER_QUAD     = "        ldr     x0, [x0, %x]\n";
char* TMPL_READ_MEMBER_BYTE     = "        ldrb    w0, [x0, %x]\n";

char* TMPL_UN_NOT               = "        cmp     x0, FALSE\n        b.ne    expr_%i_was_true\n        mov     x0, TRUE\n        b       expr_%i_end\n        expr_%i_was_true:\n        mov     x0, FALSE\n        expr_%i_end:\n";
char* TMPL_UN_NEGATE            = "        neg     x0, x0\n";

char* TMPL_STASH                = "        str     x0, [sp, -0x10]! ; stash!\n";
char* TMPL_UNSTASH_X1           = "        ldr     x1, [sp], 0x10 ; unstash!\n";
char* TMPL_UNSTASH_Xi           = "        ldr     x%i, [sp], 0x10 ; targeted unstash!\n";

char* TMPL_BIN_ADD              = "        add     x0, x0, x1\n";
char* TMPL_BIN_SUB              = "        sub     x0, x0, x1\n";
char* TMPL_BIN_MUL              = "        mul     x0, x0, x1\n";
char* TMPL_BIN_DIV              = "        sdiv    x0, x0, x1\n";
char* TMPL_BIN_MOD              = "        sdiv    x2, x0, x1\n        msub    x0, x2, x1, x0\n";
char* TMPL_BIN_LSL              = "        lsl     x0, x0, x1\n";
char* TMPL_BIN_LSR              = "        lsr     x0, x0, x1\n";

char* COMP_EQ = "eq";
char* COMP_GE = "ge";
char* COMP_GT = "gt";
char* COMP_LE = "le";
char* COMP_LT = "lt";
char* COMP_NE = "ne";
char* TMPL_BIN_LOGICAL          = "        cmp     x0, x1\n        b.%s    expr_%i\n        mov     x0, FALSE\n        b       expr_%i_end\n        expr_%i:\n        mov     x0, TRUE\n        expr_%i_end:\n";

char* TMPL_VALUE_STRING         = "        .data\n          _j_str_%i: .asciz %c%s%c\n        .text\n        adrp    x0, _j_str_%i@PAGE\n        add     x0, x0, _j_str_%i@PAGEOFF\n";
char* TMPL_VALUE_INT            = "        mov     x0, #%i\n";
char* TMPL_VALUE_Xi_INT         = "        mov     x%i, #%i\n";
char* TMPL_VALUE_INT_LARGE      = "        .data\n          _j_int_%i: .quad %x ; %i\n        .text\n        adrp    x0, _j_int_%i@PAGE\n        add     x0, x0, _j_int_%i@PAGEOFF\n        ldr     x0, [x0]\n";
char* TMPL_VALUE_OF_LOCAL       = "        ldr     x0, [fp, -%x]\n";

# "add-a-negative" so it matches the addressing offsets
char* TMPL_ADDR_LOCAL           = "        add     x0, fp, -%x\n";
char* TMPL_ADDR_GLOBAL          = "        adrp    x0, __j_%s@PAGE\n        add     x0, x0, __j_%s@PAGEOFF\n";

char* TMPL_BYTE_AT_ADDR         = "        ldrb    w0, [x0]\n";
char* TMPL_QUAD_AT_ADDR         = "        ldr     x0, [x0]\n";

struct Emitter {
    int seq,        # sequence for unique label names
    int depth,
    Block* blocks,  # array/stack of "lexical" Blocks
}

int SIZEOF_BLOCK;
int BLOCKS_CAP = 10;

pub fn Emitter__new() {
    int bytes = SIZEOF_BLOCK * BLOCKS_CAP;
    bytes = bytes + 0x10;
    Emitter* self = malloc(bytes);
    self.seq = 0;
    self.depth = 0;
    int type = null;
    Emitter_enter_block(self, type);
    char* tmpl = TMPL_PRELUDE;
    char* ver = JNC_SHORT_VERSION;
    printf(tmpl, ver);
    return self;
}

pub fn Emitter_drop(void* self) {
    void* block = Emitter_leave_block(self);
    Block_drop(block);
    free(self);
}

fn Emitter_seqnum(Emitter* self) {
    self.seq = self.seq + 1;
    return self.seq;
}

fn Emitter_enter_block(void* self, int type) {
    int id = Emitter_seqnum(self);
    self = self + 0x8;             # -> depth
    int depth = *self;
    void* blocks = self + 0x8;
    depth = depth * SIZEOF_BLOCK;
    void* block = blocks + depth;
    Block_init(block, type, id);
    depth = *self;
    depth = depth + 1;
    *self = depth;
    return block;
}

fn Emitter_current_block(void* self) {
    void* blocks = self + 0x10;
    self = self + 0x8;             # -> depth
    int depth = *self;
    depth = depth - 1;
    depth = depth * SIZEOF_BLOCK;
    blocks = blocks + depth;
    return blocks;
}

fn Emitter_is_global(Emitter* self) {
    return self.depth == 1;
}

fn Emitter_innermost_block_of(void* self, int type, void* token) {
    self = self + 0x8;             # -> depth
    int depth = *self;
    void* blocks = self + 0x8;
    while depth > 0 {
        depth = depth - 1;
        void* block = depth * SIZEOF_BLOCK;
        block = block + blocks;
        int t = Block_type(block);
        if type == t {
            return block;
        }
    }

    # out of blocks
    char* err = ERR_INVALID_NESTING;
    depth = 37;
    jnc_panic(err, token, depth);
}

fn Emitter_leave_block(void* self) {
    self = self + 0x8;             # -> depth
    int depth = *self;
    depth = depth - 1;
    *self = depth;
    self = self + 0x8;             # -> blocks
    void* block = depth * SIZEOF_BLOCK;
    block = block + self;
    return block;
}

fn Emitter_lookup_symbol_for(void* self, void* id_token) {
    char* name = Token_value(id_token);
    bool allow_null = false;
    return Emitter_lookup_symbol_by_name_and_token(self, name, id_token, allow_null);
}

fn Emitter_try_lookup_symbol_for(void* self, void* id_token) {
    char* name = Token_value(id_token);
    bool allow_null = true;
    return Emitter_lookup_symbol_by_name_and_token(self, name, id_token, allow_null);
}

fn Emitter_lookup_symbol_by_name_and_token(Emitter* self, char* name, void* t, bool allow_null) {
    int depth = self.depth;
    void* blocks = self + 0x10; # &self.blocks;
    while depth > 0 {
        depth = depth - 1;
        Block* block = blocks + (depth * SIZEOF_BLOCK);
        void* sym = block.get_symbol(name);
        if sym != null {
            return sym;
        }
    }

    # out of blocks
    if allow_null {
        return null;
    }
    Token_set_type(t, name);
    jnc_panic(ERR_UNKNOWN_SYMBOL, t, 23);
}

pub fn Emitter_mark_global(void* nameT) {
    char* name = Token_value(nameT);
    printf(TMPL_GLOBAL, name);
    if strcmp(NAME_MAIN, name) == 0 {
        printf(TMPL_GLOBAL_MAIN);
    }
}

# This is both declare and define, based on whether `expr` is null.
pub fn Emitter_do_decl(void* self, Token* nameT, int type, int nptr, void* expr) {
    # First, find the relevant block.
    Block* block;
    bool global = Emitter_is_global(self);
    if global {
        block = Emitter_current_block(self);
    }
    if !global {
        # local vars have function scope, not block scope
        block = Emitter_innermost_block_of(self, T_KW_FN, nameT);
    }

    # Ignore redeclarations.
    char* name = nameT.value();
    if expr == null { if block.contains_symbol(name) {
        return;
    } }

    # Set the offset and register
    Symbol* symbol = Symbol__new(type, nptr);
    if !global {
        # local vars are one-indexed (zero is global symbols' sentinel)
        symbol.set_offset(block.symbol_count() + 1);
    }
    block.put_symbol(name, symbol);

    # Define/initialize
    if expr == null { return; }
    if !global {
        return Emitter_do_assign(self, nameT, expr);
    }
    decl_global(self, nameT, expr, symbol);
}

fn decl_global(void* self, Token* nameT, void* expr, Symbol* symbol) {
    char* name = nameT.value();
    int val_type = *expr;

    # strings are easy, storage and value must both be strings
    if val_type == AST_LIT_STRING {
        return printf(TMPL_GLOBAL_STRING, name, '"', expr[1], '"');
    }

    # the rest are messy, as any type of value can initialize any size of storage
    int var_width = symbol.width();
    char* width;
    if var_width == 1 {
        width = WIDTH_BYTE;
    }
    if var_width != 1 {
        width = WIDTH_QUAD;
    }
    char* tmpl;
    if val_type == T_CHAR {
        tmpl = TMPL_GLOBAL_CHAR;
    }
    if val_type != T_CHAR {
        tmpl = TMPL_GLOBAL_NUM;
    }
    expr = Emitter_eval_const(self, expr);
    printf(tmpl, name, width, expr);
}

pub fn Emitter_do_fn_intro(void* self, void* nameT, int lbytes, void* args) {
    char* name = Token_value(nameT);

    introduce_fn(self, name, lbytes);

    if args == null { return; }
    int reg_offset = 0;
    while true {
        if *args == null { done; }
        int offset = (reg_offset + 1) * 0x8;
        printf(TMPL_FN_ARG, reg_offset, offset);
        reg_offset = reg_offset + 1;
        args = args + 0x8;
    }
}

pub fn Emitter_do_fn_outro(void* self, void* nameT, int lbytes) {
    void* block = Emitter_leave_block(self);
    int id = Block_id(block);
    int type = Block_type(block);
    Block_drop(block);
    printf(TMPL_FN_OUTRO, id, lbytes);
}

fn introduce_fn(void* self, char* name, int lbytes) {
    Emitter_enter_block(self, T_KW_FN);
    if strcmp(NAME_MAIN, name) == 0 {
        printf(TMPL_MAIN);
    }
    printf(TMPL_FN_INTRO, name, lbytes);
}

pub fn Emitter_do_close_block(void* self) {
    void* block = Emitter_leave_block(self);
    int id = Block_id(block);
    int type = Block_type(block);
    Block_drop(block);
    if type == null { return; }
    if type == T_KW_IF {
        return printf(TMPL_IF_OUTRO, id);
    }
    if type == T_KW_WHILE {
        return printf(TMPL_WHILE_OUTRO, id, id);
    }
    eprintf("Cannot close block of type %x\n", type);
    exit(97);
}

pub fn Emitter_do_return(void* self, void* token) {
    int kw = T_KW_FN;
    void* block = Emitter_innermost_block_of(self, kw, token);
    int id = Block_id(block);
    printf(TMPL_RETURN, id);
}

pub fn Emitter_do_if(void* self, void* cond) {
    do_conditional(self, T_KW_IF, null, TMPL_IF_INTRO, cond);
}

pub fn Emitter_do_if_else(void* self, void* cond) {
    do_conditional(self, null, null, TMPL_IF_ELSE_INTRO, cond);
}

pub fn Emitter_do_else(void* self, void* cond) {
    Block* block = Emitter_current_block(self);
    int ifid = block.id();
    Emitter_do_close_block(self);
    block = Emitter_enter_block(self, T_KW_IF);
    int elseid = block.id();
    printf(TMPL_ELSE_PRELUDE, elseid, ifid);
}

pub fn Emitter_do_while(void* self, void* cond) {
    int type = T_KW_WHILE;
    char* prelude = TMPL_WHILE_PRELUDE;
    char* intro = TMPL_WHILE_INTRO;
    do_conditional(self, type, prelude, intro, cond);
}

fn do_conditional(void* self, int type, char* prelude, char* intro, void* cond) {
    void* block = Emitter_enter_block(self, type);
    int id = Block_id(block);
    if prelude != null { printf(prelude, id); }
    Emitter_eval_expr(self, cond);
    if intro != null { printf(intro, id); }
}

pub fn Emitter_do_again(void* self, void* token) {
    char* tmpl = TMPL_WHILE_AGAIN;
    loop_control_flow(self, token, tmpl);
}

pub fn Emitter_do_done(void* self, void* token) {
    char* tmpl = TMPL_WHILE_DONE;
    loop_control_flow(self, token, tmpl);
}

fn loop_control_flow(void* self, void* token, char* tmpl) {
    char* kw = T_KW_WHILE;
    void* block = Emitter_innermost_block_of(self, kw, token);
    int id = Block_id(block);
    printf(tmpl, id);
}

pub fn Emitter_do_assign(void* self, void* nameT, void* expr) {
    Emitter_eval_expr(self, expr);

    void* symbol = Emitter_lookup_symbol_for(self, nameT);
    int offset = Symbol_offset(symbol);
    char* tmpl;
    if offset > 0 {
        # local
        return printf(TMPL_ASSIGN_LOCAL, offset * 0x8);
    }
    # global
    char* name = Token_value(nameT);
    int width = Symbol_width(symbol);
    if width == 1 {
        tmpl = TMPL_ASSIGN_GLOBAL_BYTE;
    }
    if width != 1 {
        tmpl = TMPL_ASSIGN_GLOBAL_QUAD;
    }
    printf(tmpl, name, name);
}

# [AST_MEMBER, rcvr, offset, width]
pub fn Emitter_do_assign_member(void* self, void* member, void* expr) {
    Emitter_eval_expr(self, expr);

    void* rcvr = member[1];
    # rcvr[1] -> nameT - guaranteed to be AST_ID
    get_symbol_with_addr_in_x7(self, rcvr[1]);

    printf(TMPL_GET_ADDR_MEMBER, member[2]);

    char* tmpl = TMPL_ASSIGN_PTR_QUAD;
    if member[3] == 1 {
        tmpl = TMPL_ASSIGN_PTR_BYTE;
    }
    printf(tmpl);
}

# [AST_INDEX, rcvr, off_expr, width]
pub fn Emitter_do_assign_index(void* self, void* ast, void* rhs) {
    Emitter_eval_expr(self, rhs);
    puts(TMPL_STASH);

    void* rcvr = ast[1];
    void* off_expr = ast[2];

    Emitter_get_index_with_addr_in_x0(self, rcvr, off_expr);

    printf(TMPL_MOV_Xi_FOR_ASSIGN_PTR, 0);
    printf(TMPL_UNSTASH_Xi, 0);
    char* tmpl = TMPL_ASSIGN_PTR_QUAD;
    if ast[3] == 1 {
        tmpl = TMPL_ASSIGN_PTR_BYTE;
    }
    puts(tmpl);
}

fn get_symbol_with_addr_in_x7(void* self, void* nameT) {
    void* symbol = Emitter_lookup_symbol_for(self, nameT);
    int offset = Symbol_offset(symbol);
    if offset > 0 {
        # local
        printf(TMPL_GET_ADDR_LOCAL, offset * 0x8);
    }
    if offset <= 0 {
        # global
        char* name = Token_value(nameT);
        printf(TMPL_GET_ADDR_GLOBAL, name, name);
    }
    return symbol;
}

pub fn Emitter_do_assign_pointer(void* self, void* nameT, void* expr) {
    Emitter_eval_expr(self, expr);

    void* symbol = get_symbol_with_addr_in_x7(self, nameT);

    # now write to address
    char* tmpl = TMPL_ASSIGN_PTR_BYTE;
    int n = Symbol_width(symbol);
    if n != 1 {
        tmpl = TMPL_ASSIGN_PTR_QUAD;
    }
    n = Symbol_nptr(symbol);
    if n > 1 {
        tmpl = TMPL_ASSIGN_PTR_QUAD;
    }
    printf(tmpl);
}

pub fn Emitter_eval_const(void* self, void* expr) {
    int t = *expr;
    int v = expr + 0x8;             # -> val
    v = *v;
    if t == AST_LIT_BOOL { return v; }
    if t == AST_LIT_CHAR { return v; }
    if t == AST_LIT_INT { return v; }

    char* f = "Expr type %i isn't constant.\n";
    printf(f, t);
    eprintf(f, t);
    t = 14;
    panic(t);
}

pub fn Emitter_eval_expr(void* self, void* expr) {
    int t = *expr;
    if t == AST_LIT_BOOL { # [AST_LIT_BOOL, val]
        expr = expr + 0x8;          # -> val
        expr = *expr;
        return Emitter_do_value_integer(self, expr);
    }
    if t == AST_LIT_CHAR { # [AST_LIT_CHAR, val]
        expr = expr + 0x8;          # -> val
        expr = *expr;
        return Emitter_do_value_integer(self, expr);
    }
    if t == AST_LIT_INT { # [AST_LIT_INT, val]
        expr = expr + 0x8;          # -> val
        expr = *expr;
        return Emitter_do_value_integer(self, expr);
    }
    if t == AST_LIT_STRING { # [AST_LIT_STRING, value]
        expr = expr + 0x8;          # -> val
        expr = *expr;
        return Emitter_do_value_string(self, expr);
    }
    if t == AST_BINARY { # [AST_BINARY, op, left, right]
        return Emitter_eval_expr_binary(self, expr);
    }
    if t == AST_UNARY { # [AST_UNARY, op, operand]
        return Emitter_eval_expr_unary(self, expr);
    }
    if t == AST_ADDR_OP { # [AST_ADDR_OP, op, nameT]
        return Emitter_eval_expr_addr(self, expr);
    }
    if t == AST_ID { # [AST_ID, nameT]
        expr = expr + 0x8;          # -> nameT
        expr = *expr;
        return Emitter_do_value_id(self, expr);
    }
    if t == AST_CALL { # [AST_CALL, callee, params[]]
        void* callee = expr + 0x8;  # -> callee
        callee = *callee;
        void* args = expr + 0x10;   # -> args
        args = *args;
        return Emitter_do_call_but_sillier(self, callee, args);
    }
    void* rcvr;
    int width;
    if t == AST_MEMBER { # [AST_MEMBER, rcvr, offset, width]
        expr = expr + 0x8;          # -> rcvr
        rcvr = *expr;
        expr = expr + 0x10;         # -> width
        width = *expr;
        expr = expr - 0x8;          # -> offset
        return Emitter_do_read_member(self, rcvr, *expr, width);
    }
    if t == AST_INDEX { # [AST_INDEX, rcvr, off_expr]
        expr = expr + 0x8;          # -> rcvr
        rcvr = *expr;
        expr = expr + 0x10;         # -> width
        width = *expr;
        expr = expr - 0x8;          # -> off_expr
        return Emitter_do_read_index(self, rcvr, *expr, width);
    }

    char* f = "Can't eval expr of type %i\n";
    printf(f, t);
    eprintf(f, t);
    t = 13;
    panic(t);
}

fn Emitter_get_index_with_addr_in_x0(void* self, void* rcvr, void* idx_expr) {
    if *idx_expr == AST_LIT_INT {
        # if it's a literal index, save some shenanigans
        Emitter_eval_expr(self, rcvr);
        printf(TMPL_VALUE_Xi_INT, 1, idx_expr[1]);
        puts(TMPL_BIN_ADD);
        return;
    }
    # compute the index
    Emitter_eval_expr(self, idx_expr);
    puts(TMPL_STASH);
    # compute the receiver
    Emitter_eval_expr(self, rcvr);
    # compute address
    puts(TMPL_UNSTASH_X1);
    puts(TMPL_BIN_ADD);
}

fn Emitter_do_read_index(void* self, void* rcvr, void* idx_expr, int width) {
    if *idx_expr == AST_LIT_INT {
        Emitter_do_read_member(self, rcvr, idx_expr[1], width);
        return;
    }
    Emitter_get_index_with_addr_in_x0(self, rcvr, idx_expr);
    if width == 1 {
        return puts(TMPL_BYTE_AT_ADDR);
    }
    puts(TMPL_QUAD_AT_ADDR);
}

fn Emitter_do_read_member(void* self, void* rcvr, int offset, int width) {
    Emitter_eval_expr(self, rcvr);
    if width == 1 {
        return printf(TMPL_READ_MEMBER_BYTE, offset);
    }
    printf(TMPL_READ_MEMBER_QUAD, offset);
}

fn Emitter_do_call_but_sillier(void* self, void* callee, void* args) {
    void* nameT = callee + 0x8;       # -> nameT
    nameT = *nameT;
    # If ENV knows about it, it's a declared function, so check args
    # todo: this belongs in typechecking
    void* tast = Env_opt_typeof_symbol(ENV, nameT);
    if tast != null {
        if *tast == AST_FN {
            # if tast is AST_FN, we know about the function
            int fl = 0; # assume zero-arg for now
            tast = tast + 0x10;         # -> params
            if *tast != null {
                # if params is not null, the function has formal args
                fl = arrlen(*tast);
            }
            int pl = 0;
            if args != null {
                pl = arrlen(args);
            }
            if pl != fl {
                # munge for panic
                Token_set_type(nameT, fl);
                jnc_panic(ERR_WRONG_FN_ARGS, nameT, 101);
            }
            # todo: check types too, not just count (once exprs have types)
        }
    }
    # If Emitter knows about it, it's a fn* local
    Symbol* symbol = Emitter_try_lookup_symbol_for(self, nameT);
    # if not declared nor a variable, something's wrong
    if symbol == null { if tast == null { if STRICT {
        # Since these two are currently inexpressable in Johann, they HAVE to
        # be unknown, and just rely on the linker to do its thing.
        if strcmp(nameT[3], "printf") != 0 { if strcmp(nameT[3], "eprintf") != 0 {
            # munge for panic
            Token_set_type(nameT, Token_value(nameT));
            jnc_panic(ERR_UNKNOWN_FN, nameT, 100);
        } }
    } } }
    if symbol != null {
        # fn* setup corrupts x0, so do it before params
        do_address_of(self, nameT, symbol);
        if symbol.nptr() > 0 {
            do_load_addr(self, nameT, symbol);
        }
        printf(TMPL_CALL_PTR_INTRO);
    }

    call_params_but_sillier(self, args);

    if symbol != null {
        # call the function pointer
        return printf(TMPL_CALL_PTR);
    }
    # anonymous - hope it's there!
    printf(TMPL_CALL, Token_value(nameT));
}

fn call_params_but_sillier(void* self, void* args) {
    # todo: this is a ridiculous way to do params
    void* it;
    char* tmpl = TMPL_STASH;
    int n = 0;
    while args != null {
        it = *args;
        if it == null { done; }
        Emitter_eval_expr(self, it);
        printf(tmpl);
        args = args + 0x8;
        n = n + 1;
    }
    tmpl = TMPL_UNSTASH_Xi;
    while n > 0 {
        n = n - 1;
        printf(tmpl, n);
    }
}

# [AST_BINARY, op, left, right]
fn Emitter_eval_expr_binary(void* self, void* expr) {
    void* e = expr + 0x18;          # -> right
    e = *e;
    Emitter_eval_expr(self, e);
    printf(TMPL_STASH);

    e = expr + 0x10;                # -> left
    e = *e;
    Emitter_eval_expr(self, e);

    # restore the right operand
    printf(TMPL_UNSTASH_X1);

    # and the operator
    int op = expr + 0x8;            # -> op
    op = *op;
    if op == T_MINUS   { return printf(TMPL_BIN_SUB); }
    if op == T_PLUS    { return printf(TMPL_BIN_ADD); }
    if op == T_STAR    { return printf(TMPL_BIN_MUL); }
    if op == T_SLASH   { return printf(TMPL_BIN_DIV); }
    if op == T_PERCENT { return printf(TMPL_BIN_MOD); }
    if op == T_BIT_LSL { return printf(TMPL_BIN_LSL); }
    if op == T_BIT_LSR { return printf(TMPL_BIN_LSR); }

    if op == T_EQ  { return do_binary_op_logical(self, COMP_EQ); }
    if op == T_GT  { return do_binary_op_logical(self, COMP_GT); }
    if op == T_GTE { return do_binary_op_logical(self, COMP_GE); }
    if op == T_LT  { return do_binary_op_logical(self, COMP_LT); }
    if op == T_LTE { return do_binary_op_logical(self, COMP_LE); }
    if op == T_NEQ { return do_binary_op_logical(self, COMP_NE); }

    char* f = "Can't eval binary operator %x (%c)\n";
    printf(f, op, op);
    eprintf(f, op, op);
    panic(13);
}

# [AST_ADDR_OP, op, nameT]
fn Emitter_eval_expr_addr(void* self, void* expr) {
    void* nameT = expr + 0x10;      # -> nameT
    nameT = *nameT;
    void* symbol;

    int op = expr + 0x8;            # -> op
    op = *op;
    if op == T_AMP  {
        # best effort - jump on blind faith to unknown names
        symbol = Emitter_try_lookup_symbol_for(self, nameT);
        return do_address_of(self, nameT, symbol);
    }
    if op == T_STAR {
        symbol = Emitter_lookup_symbol_for(self, nameT);
        Emitter_do_value_id(self, nameT);
        return do_load_addr(self, nameT, symbol);
    }

    char* f = "Can't eval address operator %x (%c)\n";
    printf(f, op, op);
    eprintf(f, op, op);
    op = 13;
    panic(op);
}

# [AST_UNARY, op, operand]
fn Emitter_eval_expr_unary(void* self, void* expr) {
    void* operand = expr + 0x10;    # -> operand
    operand = *operand;

    Emitter_eval_expr(self, operand);

    int op = expr + 0x8;            # -> op
    op = *op;
    char* tmpl;
    if op == T_BANG {
        op = Emitter_seqnum(self);
        tmpl = TMPL_UN_NOT;
        return printf(tmpl, op, op, op, op);
    }
    if op == T_MINUS { tmpl = TMPL_UN_NEGATE; return printf(tmpl); }
    if op == T_PLUS  { return; } # no code

    char* f = "Can't eval unary operator %x (%c)\n";
    printf(f, op, op);
    eprintf(f, op, op);
    op = 13;
    panic(op);
}

fn do_binary_op_logical(void* self, char* comp) {
    int seq = Emitter_seqnum(self);
    char* tmpl = TMPL_BIN_LOGICAL;
    printf(tmpl, comp, seq, seq, seq, seq);
}

fn Emitter_do_value_string(void* self, char* value) {
    int seq = Emitter_seqnum(self);
    char q = '"';
    char* tmpl = TMPL_VALUE_STRING;
    printf(tmpl, seq, q, value, q, seq, seq);
}

fn Emitter_do_value_integer(void* self, int i) {
    # todo: compound expressions sure would be handy...
    if i > 32767 {
        Emitter_do_value_integer_large(self, i);
        return null;
    } # todo: where's my else?!
    if i < -32767 {
        Emitter_do_value_integer_large(self, i);
        return null;
    }
    char* tmpl = TMPL_VALUE_INT;
    printf(tmpl, i);
}

fn Emitter_do_value_integer_large(void* self, int i) {
    int seq = Emitter_seqnum(self);
    char* tmpl = TMPL_VALUE_INT_LARGE;
    printf(tmpl, seq, i, i, seq, seq);
}

fn Emitter_do_value_id(void* self, void* t) {
    void* symbol = Emitter_lookup_symbol_for(self, t);
    int offset = Symbol_offset(symbol);
    char* tmpl;

    if offset > 0 {
        # local
        offset = offset * 0x8;
        tmpl = TMPL_VALUE_OF_LOCAL;
        return printf(tmpl, offset);
    }
    # global
    do_address_of(self, t, symbol);
    int nptr = Symbol_nptr(symbol);
    if nptr == 0 {
        do_load_addr(self, t, symbol);
    }
}

fn do_address_of(void* self, void* token, void* symbol) {
    if symbol != null {
        int offset = Symbol_offset(symbol);
        if offset > 0 {
            # local
            offset = offset * 0x8;
            return printf(TMPL_ADDR_LOCAL, offset);
        }
    }
    # global or unknown
    char* name = Token_value(token);
    printf(TMPL_ADDR_GLOBAL, name, name);
}

fn do_load_addr(void* self, void* token, void* symbol) {
    int width = Symbol_width(symbol);
    if width != 1 {
        return printf(TMPL_QUAD_AT_ADDR);
    }
    int nptr = Symbol_nptr(symbol);
    if nptr > 1 {
        return printf(TMPL_QUAD_AT_ADDR);
    }
    printf(TMPL_BYTE_AT_ADDR);
}
