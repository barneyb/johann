pub fn print_seven_longs(int a, int b, int c, int d, int e, int f, int g) {
    printf("J: %d, %d, %d, %d, %d, %d, and %d\n",
                a,  b,  c,  d,  e,  f,      g);
    flush_stdout__();
}

