char* JNC_SHORT_VERSION;
char* JNC_LONG_VERSION;

char* OPT_V = "-v";
char* OPT_VERSION = "--version";

pub fn main(int argc, char** argv) {
    int i = 1; # argv[0] is the command name
    char* v = OPT_V;
    char* version = OPT_VERSION;
    while i < argc {
        argv = argv + 0x8;
        char* arg = *argv;
        i = i + 1;
        bool cmp = strcmp(arg, v);
        if cmp == 0 {
            v = JNC_SHORT_VERSION;
            puts(v);
            return 0;
        }
        cmp = strcmp(arg, version);
        if cmp == 0 {
            v = JNC_LONG_VERSION;
            puts(v);
            return 0;
        }
    }
    return jnc_compile();
}

fn jnc_compile() {
    void* lex = Lexer__new();
    void* ast = parse_program(lex);
    Lexer_drop(lex);

    void* emitter = Emitter__new();
    to_emitter(emitter, ast);
    drop_ast(ast);
    Emitter_drop(emitter);
}

# token is a [val, line, char] tuple to dissect for the format
pub fn jnc_panic(char* format, void* token, int status) {
    # todo: array indexing (or destructuring!) would be nice...
    int val = *token;
    token = token + 0x8;            # -> line
    int ln = *token;
    token = token + 0x8;            # -> char
    int ch = *token;
    # to StdErr
    eprintf(format, status, val, ln, ch);
    # to the output file
    printf(format, status, val, ln, ch);
    # panic!
    format = "Compilation error\n";
    ln = strlen(format);
    panic(status, format, ln);
}
