char* JNC_SHORT_VERSION;
char* JNC_LONG_VERSION;

char* KW_BOOL;
char* KW_CHAR;
char* KW_INT;
char* KW_VOID;

int AST_TYPE_BOOL;
int AST_TYPE_CHAR;
int AST_TYPE_INT;
int AST_TYPE_VOID;

char* OPT_V = "-v";
char* OPT_VERSION = "--version";
char* OPT_HEADER = "--header";

pub fn main(int argc, char** argv) {
    int i = 1; # argv[0] is the command name
    while i < argc {
        char* arg = argv[i];
        i = i + 1;
        if strcmp(arg, OPT_V) == 0 {
            puts(JNC_SHORT_VERSION);
            return 0;
        }
        if strcmp(arg, OPT_VERSION) == 0 {
            puts(JNC_LONG_VERSION);
            return 0;
        }
        if strcmp(arg, OPT_HEADER) == 0 {
            return jnc_header();
        }
        eprintf("Unrecognized argument: '%s'\n", arg);
        exit(1);
    }
    return jnc_compile();
}

pub void ENV = null;

fn jnc_header() {
    void* ast = parse_ast();
    to_header(ast);
    drop_ast(ast);
    Env_drop(ENV);
}

fn jnc_compile() {
    void* ast = parse_ast();
    void* emitter = Emitter__new();
    to_emitter(emitter, ast);
    drop_ast(ast);
    Emitter_drop(emitter);
    Env_drop(ENV);
}

fn parse_ast() {
    ENV = Env__new(null);
    Env_seed_type(ENV, KW_BOOL, ast1(AST_TYPE_BOOL));
    Env_seed_type(ENV, KW_CHAR, ast1(AST_TYPE_CHAR));
    Env_seed_type(ENV, KW_INT , ast1(AST_TYPE_INT));
    Env_seed_type(ENV, KW_VOID, ast1(AST_TYPE_VOID));
    void* lex = Lexer__new();
    void* ast = parse_program(lex);
    Lexer_drop(lex);
    return ast;
}

# `token` is a `[val, line, col]` tuple to dissect for the format, which will
# be passed four values: `status`, `val`, `line`, and `col`.
pub fn jnc_panic(char* format, void* token, int status) {
    # todo: array indexing (or destructuring!) would be nice...
    int val = *token;
    token = token + 0x8;            # -> line
    int ln = *token;
    token = token + 0x8;            # -> char
    int ch = *token;
    # to StdErr
    eprintf(format, status, val, ln, ch);
    # to the output file
    printf(format, status, val, ln, ch);
    # panic!
    format = "Compilation error\n";
    ln = strlen(format);
    panic(status, format, ln);
}
