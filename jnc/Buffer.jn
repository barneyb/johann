# I am a character buffer, with the given initial capacity.
pub fn Buffer__new(int capacity) {
    if capacity < 0x10 {
        # can't allocate less, so may as well use it
        capacity = 0x10;
    }
    int bytes = 0x18; # [int capacity, char* size, char** buf]
    void* buf = malloc(bytes);
    *buf = capacity;
    buf = buf + 0x8;                    # -> size
    *buf = 0;
    buf = buf + 0x8;                    # -> buf
    *buf = malloc(capacity);
    buf = buf - 0x10;                   # -> capacity
    return buf;
}

# Push a single character into the buffer, which will be automatically extended
# if the character won't fit.
pub fn Buffer_push(void* buf, char c) {
    int capacity = *buf;
    buf = buf + 0x10;                   # -> buffer
    char* chars = *buf;
    buf = buf - 0x8;                    # -> size
    int size = *buf;
    if size = capacity {
        # need more!
        capacity = capacity * 2;
        char* next = malloc(capacity);
        memcpy(next, chars, size);
        free(chars);
        chars = next;
        buf = buf - 0x8;                # -> capacity
        *buf = capacity;
        buf = buf + 0x10;               # -> buf
        *buf = chars;
        buf = buf - 0x8;                # -> size
    }
    char* chars_i = chars + size;
    *chars_i = c;
    *buf = size + 1;
}

# Convert the buffer into a null-terminated byte string.
pub fn Buffer_into_chars(void* buf) {
    # add the null terminator
    char c = null;
    Buffer_push(buf, c);
    buf = buf + 0x10;                   # -> buf
    char* chars = *buf;
    buf = buf - 0x10;                   # -> capacity
    free(buf);
    return chars;
}
