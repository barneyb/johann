# [AST_RETURN, expr?, null, null]
fn parse_return(void* lex, void* emitter) {
    int t = T_KW_RETURN;
    void* ret_tkn = consume_token(lex, t);
    void* expr = null;
    void* tkn = peek_token(lex);
    t = Token_type(tkn);
    if t ! T_SEMI {
        expr = parse_expr(lex, emitter);
        Emitter_eval_expr(emitter, expr);
    }
    t = T_SEMI;
    consume_token(lex, t);
    Emitter_do_return(emitter, ret_tkn);
    t = AST_RETURN;
    return node_a(t, expr);
}

# [AST_EVAL, expr, null, null]
# [AST_ASSIGN, rhs, expr, null]
fn parse_eval_or_assign(void* lex, void* emitter) {
    int t = AST_ASSIGN;
    void* expr = parse_expr(lex);
    void* rhs = parse_opt_assign(lex);
#    if rhs = null {
#        # see if "a EQ b" should be reparsed as "a ASSIGN b"
#        t = *expr;
#        if t = AST_BINARY {
#            t = expr + 0x8;
#            t = *t;
#            if t = T_ASSIGN { # previously interpreted as T_EQ
#                t = expr + 0x18;
#                rhs = *t;
#                t = expr + 0x10;
#                drop_node(expr);
#                expr = *t;
#            }
#        }
#    }
    if rhs = null {
        # just bare evaluation
        t = AST_EVAL;
        Emitter_eval_expr(emitter, expr);
        return node_a_b(t, expr);
    }
    # right now, the lhs MUST be AST_ID, so unwrap
    t = *expr;
    if t ! AST_ID {
        rhs = "Can't assign to a %i node\n";
        eprintf(rhs, t);
        t = 14;
        panic(t);
    }
    t = expr + 0x8;                 # -> name
    char* name = *t;
    Emitter_do_assign(emitter, name, rhs);
    t = AST_ASSIGN;
        char*f = "                  ; rewrite %i w/ %x = %x\n";
        printf(f, t, expr, rhs);
    return node_a_b(t, expr, rhs);
}

