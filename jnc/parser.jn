char* ERR_MISSING_TOKEN = "ERROR(%i): Expected token %x at EOF\n";

pub int AST_BOOL = 1;
pub int AST_CHAR = 2;
pub int AST_INT = 3;
# static eval is possible <10, largest type is (promoted) result type
pub int AST_STRING = 50;
pub int AST_ID = 75;
pub int AST_UNARY = 101;
pub int AST_BINARY = 102;
pub int AST_CALL = 103;
pub int AST_VAR = 300;
pub int AST_FN = 301;
pub int AST_NAMETYPE = 402;
pub int AST_EVAL = 403;
pub int AST_ASSIGN = 404;
pub int AST_IF = 405;
pub int AST_WHILE = 406;
pub int AST_DONE = 407;
pub int AST_AGAIN = 408;
pub int AST_RETURN = 409;

# [type, a, b, c] 4-tuple
fn node(int type) {
    void n = null;
    return node_a_b_c(type, n, n, n);
}

fn node_a(int type, void value) {
    void n = null;
    return node_a_b_c(type, value, n, n);
}

fn node_a_b(int type, void value, void left) {
    void n = null;
    return node_a_b_c(type, value, left, n);
}

fn node_a_b_c(int type, void value, void left, void right) {
    int bytes = 0x20;
    void* ast = malloc(bytes);
    *ast = type;
    ast = ast + 0x8;
    *ast = value;
    ast = ast + 0x8;
    *ast = left;
    ast = ast + 0x8;
    *ast = right;
    ast = ast - 0x18;
    return ast;
}

fn drop_node(void* node) {
    if node = null { return; }
    int type = *node;
    void* it;

    if type = AST_INT {
        return free(node);
    }
    if type = AST_STRING {
        it = node + 0x8;            # -> value
        it = *it;
        free(it);
        return free(node);
    }
    if type = AST_BINARY {
        it = node + 0x10;           # -> left
        it = *it;
        drop_node(it);
        it = node + 0x18;           # -> right
        it = *it;
        drop_node(it);
        return free(node);
    }
    if type = AST_UNARY {
        it = node + 0x10;           # -> operand
        it = *it;
        drop_node(it);
        return free(node);
    }
    if type = AST_FN {
        it = node + 0x8;            # -> name_token
        it = *it;
        Token_drop(it);
        it = node + 0x10;           # -> args
        it = *it;
        drop_node_array(it);
        it = node + 0x18;           # -> stmts
        it = *it;
        drop_node_array(it);
        return free(node);
    }
    if type = AST_NAMETYPE {
        it = node + 0x8;            # -> name_token
        it = *it;
        Token_drop(it);
        return free(node);
    }
    if type = AST_RETURN {
        it = node + 0x8;            # -> expr
        it = *it;
        drop_node(it);
        return free(node);
    }
    if type = AST_EVAL {
        it = node + 0x8;            # -> expr
        it = *it;
        drop_node(it);
        return free(node);
    }
    if type = AST_VAR {
        it = node + 0x8;            # -> name_and_type
        it = *it;
        drop_node(it);
        it = node + 0x10;           # -> expr
        it = *it;
        drop_node(it);
        return free(node);
    }
    if type = AST_ID {
        it = node + 0x8;            # -> name_and_type
        it = *it;
        Token_drop(it);
        return free(node);
    }
    if type = AST_CALL {
        it = node + 0x8;            # -> rcvr
        it = *it;
        drop_node(it);
        it = node + 0x10;           # -> args
        it = *it;
        drop_node_array(it);
        return free(node);
    }
    if type = AST_ASSIGN {
        it = node + 0x8;            # -> lhs
        it = *it;
        drop_node(it);
        it = node + 0x10;           # -> rhs
        it = *it;
        drop_node(it);
        return free(node);
    }

    char* f = "Can't drop node of type %i\n";
    eprintf(f, type);
    panic(type);
}

fn drop_node_array(void* nodes) {
    if nodes = null { return; }
    void* n = nodes;
    while true {
        void it = *n;
        if it = null { done; }
        drop_node(it);
        n = n + 0x8;
    }
    free(nodes);
}

fn is_type_kw(int t) {
    if t = T_KW_BOOL { return true; }
    if t = T_KW_CHAR { return true; }
    if t = T_KW_INT  { return true; }
    if t = T_KW_VOID { return true; }
    return false;
}

fn dump__(char* action, void* token) {
    int val = *token;
    token = token + 0x8;            # -> line
    int ln = *token;
    token = token + 0x8;            # -> char
    int ch = *token;
    char* tmpl = "; %i:%i %s";
    printf(tmpl, ln, ch, action);
    tmpl = " %x (%c)\n";
    if val < 128 { if val > 31 {
        tmpl = " '%c'\n";
    } }
    printf(tmpl, val, val);
}

int PEEKED_AT = null;
int PEEK_COUNT = 0;
fn peek_token(void* lex) {
    void* token = Lexer_peek(lex);
    if token = null { return token; }
    char* action = "   PEEK";
    dump__(action, token);
    if token = PEEKED_AT {
        PEEK_COUNT = PEEK_COUNT + 1;
        if PEEK_COUNT > 50 {
            char* err = "... and not advancing\n";
            int status = 57;
            jnc_panic(err, token, status);
        }
    }
    if token ! PEEKED_AT {
        PEEKED_AT = token;
        PEEK_COUNT = 0;
    }
    return token;
}

fn next_token(void* lex) {
    void* token = Lexer_token(lex);
    char* action = "CONSUME";
    dump__(action, token);
    return token;
}

fn consume_token(void* lex, int type) {
    void* tkn = next_token(lex);
    int t;
    char* err;
    if tkn = null {
        err = ERR_MISSING_TOKEN;
        t = 20;
        eprintf(err, t, type);
        printf(err, t, type);
        panic(t);
    }
    t = Token_type(tkn);
    if t ! type { bad_token(tkn); }
    drop_token(tkn);
}

fn drop_token(void* token) {
    if token = null { return; }
    Token_drop(token);
}

fn bad_token(void* tkn) {
    char* err = ERR_BAD_TOKEN;
    int status = 26;
    jnc_panic(err, tkn, status);
}

pub fn parse_program(void* lex, void* emitter) {
    void* tkn;
    while true {
        tkn = peek_token(lex);
        if tkn = null { done; }
        int t = Token_type(tkn);
        IS_PUB = false;
        if t = T_KW_PUB {
            IS_PUB = true;
            consume_token(lex, t);  # skip it
            tkn = peek_token(lex);  # new "first" token
            t = Token_type(tkn);
        }
        void* ast = null;
        if is_type_kw(t) { ast = parse_vardecl(lex, emitter); }
        if t = T_KW_FN { ast = parse_function_declaration(lex, emitter); }
        if ast = null { done; }
        drop_node(ast);
    }
    if tkn ! null {
        bad_token(tkn);
    }
}

# [AST_FN, nameT, args[], block?]
fn parse_function_declaration(void* lex, void* emitter) {
    int t = T_KW_FN;
    consume_token(lex, t);
    void* nameT = id_token(lex);
    t = T_OPAREN;
    consume_token(lex, t);
    void* tkn = peek_token(lex);
    t = Token_type(tkn);
    void args = null;
    if t ! T_CPAREN {
        args = parse_param_list(lex);
    }
    t = T_CPAREN;
    consume_token(lex, t);
    tkn = peek_token(lex);
    t = Token_type(tkn);
    if t = T_SEMI {
        consume_token(lex, t);
        Emitter_do_fn_proto(emitter, nameT, args);
        t = AST_FN;
        return node_a_b(t, nameT, args);
    }
    if t = T_OBRACE {
        Emitter_do_fn_intro(emitter, nameT, args);
        void* block = parse_block(lex, emitter);
        Emitter_do_fn_outro(emitter, nameT);
        t = AST_FN;
        return node_a_b_c(t, nameT, args, block);
    }
    bad_token(tkn);
}

# [[AST_NAMETYPE, nameT?, T_type, nptr]*]
fn parse_param_list(void* lex) {
    void bytes = 0x8 * 9; # todo: can't have more than eight at the moment...
    void* params = malloc(bytes);
    void* curr = params;
    *curr = parse_name_opt_type(lex);
    curr = curr + 0x8;
    while true {
        void* tkn = peek_token(lex);
        int t = Token_type(tkn);
        if t ! T_COMMA { done; }
        consume_token(lex, t);
        *curr = parse_name_opt_type(lex);
        curr = curr + 0x8;
    }
    *curr = null;
    return params;
}

# [AST_NAMETYPE, nameT?, T_type, nptr]
fn parse_name_opt_type(void* lex) {
    bool req_name = false;
    return parse_name_type_internal(lex, req_name);
}

# [AST_VAR, name_and_type, init?, null]
fn parse_vardecl(void* lex, void* emitter) {
    void* name_and_type = parse_name_and_type(lex);
    void* init = parse_opt_assign(lex);
    void* nameT = name_and_type + 0x8;
    nameT = *nameT;
    int type = name_and_type + 0x10;
    type = *type;
    int nptr = name_and_type + 0x18;
    nptr = *nptr;
    Emitter_do_decl(emitter, nameT, type, nptr, init);
    int t = AST_VAR;
    return node_a_b(t, name_and_type, init);
}

# [AST_NAMETYPE, nameT, T_type, nptr]
fn parse_name_and_type(void* lex) {
    bool req_name = true;
    return parse_name_type_internal(lex, req_name);
}

# [AST_NAMETYPE, nameT?, T_type, nptr]
fn parse_name_type_internal(void* lex, bool req_name) {
    void* base_tkn = next_token(lex);
    int nptr = 0;
    void* tkn;
    int type;
    while true {
        tkn = peek_token(lex);
        type = Token_type(tkn);
        if type ! T_STAR { done; }
        consume_token(lex, type);
        nptr = nptr + 1;
    }
    void* nameT = null;
    tkn = peek_token(lex);
    if tkn ! null {
        type = Token_type(tkn);
        if type = T_ID {
            nameT = id_token(lex);
        }
    }
    type = AST_NAMETYPE;
    int base_type = Token_into_type(base_tkn);
    return node_a_b_c(type, nameT, base_type, nptr);
}

# null OR expr
fn parse_opt_assign(void* lex) {
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);
    void* expr = null;
    if t = T_ASSIGN {
        consume_token(lex, t);
        expr = parse_expr(lex);
    }
    t = T_SEMI;
    consume_token(lex, t);
    return expr;
}

# [[AST_stmt, ?, ?, ?]*]
fn parse_block(void* lex, void* emitter) {
    int t = T_OBRACE;
    consume_token(lex, t);
    void bytes = 0x8 * 150; # todo: need an auto-grow type
    void* stmts = malloc(bytes);
    void* curr = stmts;
    void* tkn;
    while true {
        tkn = peek_token(lex);
        t = Token_type(tkn);
        if t = T_CBRACE {
            consume_token(lex, t);
            done;
        }
        void* stmt = parse_statement(lex, emitter);
        if stmt ! null {
            *curr = stmt;
            curr = curr + 0x8;
        }
    }
    return stmts;
}

# [AST_VAR, name_and_type, init?, null]
# [AST_RETURN, expr?, null, null]
# [AST_EVAL, expr, null, null]
# [AST_ASSIGN, rhs, expr, null]
fn parse_statement(void* lex, void* emitter) {
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);
    if is_type_kw(t) { return parse_vardecl(lex, emitter); }
#    if t = T_KW_IF { return parse_if(lex); }
#    if t = T_KW_WHILE { return parse_while(lex); }
#    if t = T_KW_DONE { return parse_done(lex); }
#    if t = T_KW_AGAIN { return parse_again(lex); }
    if t = T_KW_RETURN { return parse_return(lex, emitter); }
    if t = T_SEMI {
        # silly, but legal
        consume_token(lex, t);
        return null;
    }
    # a bare expression eval or an assignment
    return parse_eval_or_assign(lex, emitter);
}

