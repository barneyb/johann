void ENV;

fn strcmp(char*, char*);
fn drop_ast(void*);
fn Env_push(void*);
fn Env_pop(void*);

char* ERR_ZERO_MEMBER_STRUCT = "ERROR(%i): Struct '%s' must declare at least one member at line %i, char %i\n";
char* ERR_DUPE_STRUCT_MEMBER = "ERROR(%i): duplicate '%s' member\n";
char* ERR_BAD_TYPE           = "ERROR(%i): Bad type %x at line %i, char %i\n";
char* ERR_BAD_EXPRESSION     = "ERROR(%i): Bad expression %x at line %i, char %i\n";
char* ERR_EXPECTED_TOKEN     = "ERROR(%i): Expected %x token at line %i, char %i\n";
char* ERR_UNEXPECTED_TOKEN   = "ERROR(%i): Unexpected token %x at line %i, char %i\n";
char* ERR_TOO_MANY_PARAMS    = "ERROR(%i): Only eight call params are allowed; '%s' is a ninth at line %i, char %i\n";
char* ERR_MISSING_MISC_TOKEN = "ERROR(%i): Expected a token at EOF\n";
char* ERR_MISSING_TOKEN      = "ERROR(%i): Expected token %x at EOF\n";
char* ERR_MISSING_PARAM_NAME = "ERROR(%i): missing parameter name on %x at line %i\n";

fn is_type_kw(void* token) {
    int t = Token_type(token);
    if t == T_KW_BOOL { return true; }
    if t == T_KW_CHAR { return true; }
    if t == T_KW_INT  { return true; }
    if t == T_KW_VOID { return true; }
    if t != T_ID { return false; }
    return Env_is_type(ENV, Token_value(token));
}

pub fn print_token(void* t) {
    if t == null {
        printf("; null token\n");
        return;
    }
    int type = Token_type(t);
    int ln = Token_line(t);
    int ch = Token_char(t);
    char* f;
    if type >= 0x80 {
        f = "; %i/%c %i,%i";
        int i = type / 256;
        printf(f, i, type, ln, ch);
    }
    if type < 0x80 {
        f = "; %c %i,%i";
        printf(f, type, ln, ch);
    }
    f = null;
    if type == T_INT { f = ": %i"; }
    if type == T_ID { f = ": %s"; }
    if type == T_CHAR { f = ": '%c'"; }
    if type == T_STRING {
        printf(": %c%s%c\n", '"', Token_value(t), '"');
        return;
    }
    if type == T_BOOL { f = ": %b"; }
    if type >= 0x300 { f = ": %s"; }
    if f != null {
        printf(f, Token_value(t));
    }
    putchar(0xa);
}

int PEEKED_AT = null;
int PEEK_COUNT = 0;
fn peek_token(void* lex) {
    void* token = Lexer_peek(lex);
    if token == null { return token; }
#    printf("            ");
#    print_token(token);
    if token == PEEKED_AT {
        PEEK_COUNT = PEEK_COUNT + 1;
        if PEEK_COUNT > 50 {
            char* err = "... and not advancing\n";
            int status = 57;
            jnc_panic(err, token, status);
        }
    }
    if token != PEEKED_AT {
        PEEKED_AT = token;
        PEEK_COUNT = 0;
    }
    return token;
}

fn next_token(void* lex) {
    void* token = Lexer_token(lex);
#    print_token(token);
    return token;
}

fn consume_opt_token(void* lex, int type) {
    void* tkn = peek_token(lex);
    if tkn == null { return; }
    if Token_type(tkn) != type { return; }
    Token_drop(next_token(lex));
}

fn consume_token(void* lex, int type) {
    void* tkn = next_token(lex);
    int t;
    char* err;
    if tkn == null {
        err = ERR_MISSING_TOKEN;
        t = 20;
        eprintf(err, t, type);
        printf(err, t, type);
        panic(t);
    }
    expected_token(tkn, type);
    Token_drop(tkn);
}

fn expected_token(void* tkn, int type) {
    if Token_type(tkn) != type {
        Token_set_type(tkn, type);
        jnc_panic(ERR_EXPECTED_TOKEN, tkn, 26);
    }
}

fn unexpected_token(void* tkn) {
    jnc_panic(ERR_UNEXPECTED_TOKEN, tkn, 26);
}

pub fn parse_program(void* lex) {
    void* decls = ArrayList__new(8);
    while peek_token(lex) != null {
        ArrayList_push(decls, parse_declaration(lex));
    }
    return ast2(AST_PROGRAM, ArrayList_into_array(decls));
}

fn parse_function_declaration(void* lex) {
    consume_token(lex, T_KW_FN);
    void* nameT = id_token(lex);
    ENV = Env_push(ENV);
    void params = parse_parameter_list(lex);
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);
    if t == T_SEMI {
        consume_token(lex, t);
        ENV = Env_pop(ENV);
        return ast3(AST_FN, nameT, params);
    }
    if t == T_OBRACE {
        set_up_params_as_args(nameT, params);
        void* block = parse_block(lex);
        ENV = Env_pop(ENV);
        return ast4(AST_FN, nameT, params, block);
    }
    unexpected_token(tkn);
}

fn set_up_params_as_args(void* nameT, void* args) {
    if args == null { return; }
    # as well as human-y, one-indexing ensures non-zero exit if
    # the first param is anonymous
    int i = 1;
    while true {
        void arg = *args;
        if arg == null { done; }
        void* nt = arg + 0x10;      # -> nameT
        if *nt == null {
            char* err = "Function %s's parameter %i must be named.\n";
            char* name = Token_value(nameT);
            printf(err, name, i);
            eprintf(err, name, i);
            jnc_panic(ERR_MISSING_PARAM_NAME, nameT, i);
        }
        arg = arg + 0x8;            # -> type
        Env_register_symbol(ENV, *nt, *arg);
        args = args + 0x8;
        i = i + 1;
    }
}

# [[AST_VARIABLE, type, nameT?]*]
fn parse_parameter_list(void* lex) {
    consume_token(lex, T_OPAREN);
    if Token_type(peek_token(lex)) == T_CPAREN {
        consume_token(lex, T_CPAREN);
        return null;
    }
    void* params = ArrayList__new(8);
    ArrayList_push(params, parse_param_variable_member(lex, false));
    while true {
        void* tkn = peek_token(lex);
        int t = Token_type(tkn);
        if t != T_COMMA { done; }
        consume_token(lex, t);
        ArrayList_push(params, parse_param_variable_member(lex, false));
    }
    consume_token(lex, T_CPAREN);
    return ArrayList_into_array(params);
}

fn parse_param_variable_member(void* lex, bool allow_init) {
    void* type = parse_type_spec(lex);
    void* nameT = null;
    void* init = null;
    if Token_type(peek_token(lex)) == T_ID {
        nameT = id_token(lex);
        if allow_init { if Token_type(peek_token(lex)) == T_ASSIGN {
            consume_token(lex, T_ASSIGN);
            init = parse_expr(lex);
        } }
    }
    return ast4(AST_VARIABLE, type, nameT, init);
}

fn parse_declaration(void* lex) {
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);
    bool is_pub = false;
    if t == T_KW_PUB {
        is_pub = true;
        consume_token(lex, t);  # skip it
        tkn = peek_token(lex);  # new "first" token
        if tkn == null {
            t = 20;
            eprintf(ERR_MISSING_MISC_TOKEN, t);
            printf(ERR_MISSING_MISC_TOKEN, t);
            panic(t);
        }
        t = Token_type(tkn);
    }
    void* ast = null;
    if is_type_kw(tkn)  {
        ast = parse_param_variable_member(lex, true);
        consume_token(lex, T_SEMI);
    }
    if t == T_KW_FN     { ast = parse_function_declaration(lex); }
    if t == T_KW_STRUCT { ast = parse_struct_declaration(lex); }
    if ast == null {
        unexpected_token(tkn);
    }
    return ast3(AST_DECL, is_pub, ast);
}

fn parse_struct_declaration(void* lex) {
    consume_token(lex, T_KW_STRUCT);
    void* nameT = id_token(lex);
    void* ast;
    if Token_type(peek_token(lex)) == T_SEMI {
        # bring name into scope, but incomplete.
        consume_token(lex, T_SEMI);
        ast = ast3(AST_STRUCT, nameT, null);
        Env_register_type(ENV, nameT, build_struct_type(ast));
        return ast;
    }
    consume_token(lex, T_OBRACE);
    void* members = ArrayList__new(8);
    ArrayList_push(members, parse_param_variable_member(lex, false));
    while Token_type(peek_token(lex)) == T_COMMA {
        consume_token(lex, T_COMMA);
        if Token_type(peek_token(lex)) == T_CBRACE { done; }
        ArrayList_push(members, parse_param_variable_member(lex, false));
    }
    consume_token(lex, T_CBRACE);
    consume_opt_token(lex, T_SEMI);
    ast = ast3(AST_STRUCT,
               nameT,
               ArrayList_into_array(members));
    Env_register_type(ENV, nameT, build_struct_type(ast));
    return ast;
}

fn build_struct_type(void* ast) {
    void* members = TreeMap__new_owned(&strcmp, null, &drop_ast);
    int total_size = 0;
    int total_align = 0;
    void* kids = ast + 0x10;
    kids = *kids;
    while true {
        void* kid = *kids;
        if kid == null { done; }
        if *kid != AST_VARIABLE {
            eprintf("Expected a variable node (%i) building type info, but got a %i\n", AST_VARIABLE, *kid);
            exit(84);
        }
        kids = kids + 0x8;
        kid = kid + 0x10;           # -> nameT
        if *kid == null {
            eprintf("Anonymous struct members are not allowed\n");
            exit(87);
        }
        char* name = Token_value(*kid);
        if TreeMap_contains(members, name) {
            eprintf(ERR_DUPE_STRUCT_MEMBER, 36, name);
            exit(36);
        }
        kid = kid - 0x8;            # -> type
        int i = ast_alignment(*kid);
        total_align = imax(total_align, i);
        # add padding to align the member
        total_size = round_up_to_mod(total_size, i);
        i = ast_sizeof(*kid);
        name = strclone(name);
        TreeMap_put(members, name, ast4(AST_TYPE_MEMBER, name, total_size, i));
        total_size = total_size + i;
    }
    total_size = round_up_to_mod(total_size, total_align);
    return ast4(AST_TYPE_STRUCT, total_align, total_size, members);
}

fn round_up_to_mod(int value, int modulus) {
    int overage = value % modulus;
    if overage != 0 {
        value = value + (modulus - overage);
    }
    return value;
}

fn parse_type_spec(void* lex) {
    void* tkn = next_token(lex);
    int t = Token_type(tkn);
    void* ast = null;
    if t == T_KW_BOOL { Token_drop(tkn); ast = ast1(AST_TYPE_BOOL); }
    if t == T_KW_CHAR { Token_drop(tkn); ast = ast1(AST_TYPE_CHAR); }
    if t == T_KW_INT  { Token_drop(tkn); ast = ast1(AST_TYPE_INT); }
    if t == T_KW_VOID { Token_drop(tkn); ast = ast1(AST_TYPE_VOID); }
    if t == T_ID      { ast = ast2(AST_TYPE_NAMED, tkn); }
    if ast == null {
        jnc_panic(ERR_BAD_TYPE, tkn, 25);
    }
    while Token_type(peek_token(lex)) == T_STAR {
        consume_token(lex, T_STAR);
        ast = ast2(AST_TYPE_PTR, ast);
    }
    return ast;
}

fn parse_block(void* lex) {
    int t = T_OBRACE;
    consume_token(lex, t);
    void* stmts = ArrayList__new(4); # many blocks will be four or fewer statements
    while Token_type(peek_token(lex)) != T_CBRACE {
        void* stmt = parse_block_item(lex);
        if stmt != null {
            ArrayList_push(stmts, stmt);
        }
    }
    consume_token(lex, T_CBRACE);
    return ArrayList_into_array(stmts);
}

fn parse_block_item(void* lex) {
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);
    if is_type_kw(tkn)  {
        void* ast = parse_param_variable_member(lex, true);
        void* nt = ast + 0x10;      # -> nameT
        if *nt == null {
            jnc_panic("ERR(%i) Anonymous declaration (%x) at line %i, char %i?!\n", tkn, 89);
        }
        void* type = ast + 0x8;            # -> type
        Env_register_symbol(ENV, *nt, *type);
        consume_token(lex, T_SEMI);
        return ast;
    }
    if t == T_KW_STRUCT { return parse_struct_declaration(lex); }
    if t == T_KW_IF     { return parse_if(lex); }
    if t == T_KW_WHILE  { return parse_while(lex); }
    if t == T_KW_DONE   { return parse_done(lex); }
    if t == T_KW_AGAIN  { return parse_again(lex); }
    if t == T_KW_RETURN { return parse_return(lex); }
    if t == T_SEMI {
        # silly, but legal
        consume_token(lex, t);
        return null;
    }
    # a bare expression eval or an assignment
    return parse_eval_or_assign(lex);
}

fn parse_if(void* lex) {
    consume_token(lex, T_KW_IF);
    void* cond = parse_expr(lex);
    void* body = parse_block(lex);
    return ast3(AST_IF, cond, body);
}

fn parse_while(void* lex) {
    consume_token(lex, T_KW_WHILE);
    void* cond = parse_expr(lex);
    void* body = parse_block(lex);
    return ast3(AST_WHILE, cond, body);
}

fn parse_done(void* lex) {
    void* token = next_token(lex);
    consume_token(lex, T_SEMI);
    return ast2(AST_DONE, token);
}

fn parse_again(void* lex) {
    void* token = next_token(lex);
    consume_token(lex, T_SEMI);
    return ast2(AST_AGAIN, token);
}

fn parse_return(void* lex) {
    void* ret_tkn = next_token(lex);
    void* expr = null;
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);
    if t != T_SEMI {
        expr = parse_expr(lex);
    }
    consume_token(lex, T_SEMI);
    return ast3(AST_RETURN, ret_tkn, expr);
}

fn parse_eval_or_assign(void* lex) {
    int line = Token_line(peek_token(lex));
    void* expr = parse_expr(lex);
    void* rhs = null;
    if Token_type(peek_token(lex)) == T_ASSIGN {
        consume_token(lex, T_ASSIGN);
        rhs = parse_expr(lex);
    }
    consume_token(lex, T_SEMI);

    # bare evaluation
    if rhs == null {
        return ast3(AST_EVAL, expr);
    }

    int t = *expr;
    if t == AST_ID {
        return ast3(AST_ASSIGN, expr, rhs);
    }
    if t == AST_MEMBER {
        return ast3(AST_ASSIGN, expr, rhs);
    }
    if t == AST_INDEX {
        return ast3(AST_ASSIGN, expr, rhs);
    }
    if t == AST_ADDR_OP {
        t = expr + 0x8;             # -> op
        if *t == T_STAR {
            return ast3(AST_ASSIGN, expr, rhs);
        }
    }
    if t == AST_BINARY {
        t = expr + 0x8;             # -> op
        if *t == T_STAR {
            t = t + 0x8;            # -> left
            t = *t;
            if *t == AST_ID {
                t = t + 0x8; # -> nameT
                eprintf("Did you forget to declare '%s'?\n", Token_value(*t));
            }
        }
    }

    eprintf("Can't assign to a %i node at line %i\n", *expr, line);
    exit(14);
}

fn parse_expr(void* lex) {
    return parse_expr_cond(lex);
}

fn parse_expr_cond(void* lex) {
    return parse_expr_logic_or(lex);
}

fn parse_expr_logic_or(void* lex) {
    void* expr = parse_expr_logic_and(lex);
#    while true {
#        void* tkn = peek_token(lex);
#        if tkn == null { done; }
#        int t = Token_type(tkn);
#        if t == T_LOG_OR {
#            consume_token(lex, t);
#            void* right = parse_expr_logic_and(lex);
#            expr = join_bin_op(lex, t, expr, right);
#            again;
#        }
#        done;
#    }
    return expr;
}

fn parse_expr_logic_and(void* lex) {
    return parse_expr_bit_or(lex);
}

fn parse_expr_bit_or(void* lex) {
    return parse_expr_bit_xor(lex);
}

fn parse_expr_bit_xor(void* lex) {
    return parse_expr_bit_and(lex);
}

fn parse_expr_bit_and(void* lex) {
    return parse_expr_eq(lex);
}

fn parse_expr_eq(void* lex) {
    void* expr = parse_expr_rel(lex);
    void* right;
    while true {
        void* tkn = peek_token(lex);
        if tkn == null { done; }
        int t = Token_type(tkn);
        bool doit = false;
        if t == T_NEQ  { doit = true; }
        if t == T_EQ   { doit = true; }
        if !doit { done; }
        consume_token(lex, t);
        right = parse_expr_rel(lex);
        expr = join_bin_op(lex, t, expr, right);
    }
    return expr;
}

fn parse_expr_rel(void* lex) {
    void* expr = parse_expr_shift(lex);
    void* right;
    while true {
        void* tkn = peek_token(lex);
        if tkn == null { done; }
        int t = Token_type(tkn);
        bool doit = false;
        if t == T_GT  { doit = true; }
        if t == T_LT  { doit = true; }
        if t == T_GTE { doit = true; }
        if t == T_LTE { doit = true; }
        if !doit { done; }
        consume_token(lex, t);
        right = parse_expr_shift(lex);
        expr = join_bin_op(lex, t, expr, right);
    }
    return expr;
}

fn parse_expr_shift(void* lex) {
    return parse_expr_add(lex);
}

fn parse_expr_add(void* lex) {
    void* expr = parse_expr_mult(lex);
    void* right;
    while true {
        void* tkn = peek_token(lex);
        if tkn == null { done; }
        int t = Token_type(tkn);
        bool doit = false;
        if t == T_MINUS { doit = true; }
        if t == T_PLUS  { doit = true; }
        if !doit { done; }
        consume_token(lex, t);
        right = parse_expr_mult(lex);
        expr = join_bin_op(lex, t, expr, right);
    }
    return expr;
}

fn parse_expr_mult(void* lex) {
    void* expr = parse_expr_cast(lex);
    void* right;
    while true {
        void* tkn = peek_token(lex);
        if tkn == null { done; }
        int t = Token_type(tkn);
        bool doit = false;
        if t == T_PERCENT { doit = true; }
        if t == T_SLASH   { doit = true; }
        if t == T_STAR    { doit = true; }
        if !doit { done; }
        consume_token(lex, t);
        right = parse_expr_cast(lex);
        expr = join_bin_op(lex, t, expr, right);
    }
    return expr;
}

# this will take the left AST and join it with the next AST, into a new AST for
# the given operator. If both sides are literal, the operator will be evaluated
# as its result will be returned as a new literal AST instead.
fn join_bin_op(void* lex, int op, void* left, void* right) {
    int ttl = *left;
    int ttr = *right;

    if ttl < 10 { if ttr < 10 {
        # both literal values, evaluate
        if ttl < ttr { ttl = ttr; }
        ttr = left + 0x8;
        ttr = *ttr;
        drop_ast(left);
        left = ttr;
        ttr = right + 0x8;
        ttr = *ttr;
        drop_ast(right);
        right = ttr;
        bool did_it = false;
        if op == T_EQ      { ttr = left == right; did_it = true; }
        if op == T_NEQ     { ttr = left != right; did_it = true; }
        if op == T_GT      { ttr = left > right; did_it = true; }
        if op == T_LT      { ttr = left < right; did_it = true; }
        if op == T_GTE     { ttr = left >= right; did_it = true; }
        if op == T_LTE     { ttr = left <= right; did_it = true; }
        if op == T_PLUS    { ttr = left + right; did_it = true; }
        if op == T_MINUS   { ttr = left - right; did_it = true; }
        if op == T_STAR    { ttr = left * right; did_it = true; }
        if op == T_SLASH   { ttr = left / right; did_it = true; }
        if op == T_PERCENT { ttr = left % right; did_it = true; }
        if did_it {
            return ast2(ttl, ttr);
        }
        char* tmpl = "Can't statically eval %x (%c) with %i and %i\n";
        printf(tmpl, op, op, left, right);
        eprintf(tmpl, op, op, left, right);
        panic(16);
    } }

    return ast4(AST_BINARY, op, left, right);
}

fn parse_expr_cast(void* lex) {
    return parse_expr_unary(lex);
}

fn parse_expr_unary(void* lex) {
    void* tkn = peek_token(lex);
    if tkn != null {
        int op = Token_type(tkn);
        if op == T_AMP   { return un_addr_op(lex, op); }
        if op == T_STAR  { return un_addr_op(lex, op); }
        if op == T_BANG  { return join_un_op_rtl(lex, op); }
        if op == T_MINUS { return join_un_op_rtl(lex, op); }
        if op == T_PLUS  { return join_un_op_rtl(lex, op); }
        if op == T_KW_SIZEOF {
            consume_token(lex, op);
            consume_token(lex, T_OPAREN);
            void* type_ast = parse_type_spec(lex);
            consume_token(lex, T_CPAREN);
            int size = ast_sizeof(type_ast);
            drop_ast(type_ast);
            return ast2(AST_LIT_INT, size);
        }
    }
    return parse_expr_postfix(lex);
}

fn un_addr_op(void* lex, int op) {
    consume_token(lex, op);
    void* nameT = next_token(lex);
    int tto = *nameT;
    if tto != T_ID {
        jnc_panic(ERR_BAD_EXPRESSION, nameT, 28);
    }
    return ast3(AST_ADDR_OP, op, nameT);
}

fn join_un_op_rtl(void* lex, int op) {
    # If this ends up being called elsewhere than parse_expr_unary, it'll need
    # to be recast along the lines of join_bin_op.
    consume_token(lex, op);
    void operand = parse_expr_unary(lex);
    int tto = *operand;

    if tto < 10 {
        # a literal, evaluate
        int v = operand + 0x8;
        v = *v;
        drop_ast(operand);
        bool did_it = false;
        if op == T_BANG  { v = !v; did_it = true; }
        if op == T_MINUS { v = -v; did_it = true; }
        if op == T_PLUS  {         did_it = true; } # for completeness
        if did_it {
            return ast2(tto, v);
        }
        char* tmpl = "Can't statically eval %x (%c) with %i of %i\n";
        printf(tmpl, op, op, operand, tto);
        eprintf(tmpl, op, op, operand, tto);
        panic(16);
    }

    return ast3(AST_UNARY, op, operand);
}

fn parse_expr_postfix(void* lex) {
    void* expr = parse_expr_primary(lex);
    while true {
        void* tkn = peek_token(lex);
        if tkn == null { done; }
        int t = Token_type(tkn);
        if t == T_OPAREN {
            expr = ast3(AST_CALL, expr, parse_arg_list(lex));
            again;
        }
        if t == T_DOT {
            consume_token(lex, t);
            expr = process_dot(expr, id_token(lex));
            again;
        }
        if t == T_OBRACKET {
            if *expr != AST_ID {
                eprintf("ERR: can't index into a %i at %i:%i\n",
                        *expr,
                        Token_line(t),
                        Token_char(t));
                exit(76);
            }
            consume_token(lex, t);
            expr = process_bracket(expr, parse_expr(lex));
            consume_token(lex, T_CBRACKET);
            return expr;
        }
        done;
    }
    return expr;
}

fn process_bracket(void* rcvr, void* off_expr) {
    rcvr = rcvr + 0x8;              # -> nameT
    char* rname = Token_value(*rcvr);
    void* rat = Env_typeof_symbol(ENV, rname);
    if *rat != AST_TYPE_PTR {
        eprintf("Cannot index a %i node at %i:%i, only a pointer\n",
                *rat,
                Token_line(*rcvr),
                Token_char(*rcvr));
        exit(76);
    }
    rcvr = rcvr - 0x8;              # -> whole AST node
    rat = rat + 0x8;                # -> type
    int width = ast_sizeof(*rat);
    if width != 1 {
        # multiply by width
        void* width_ast = ast2(AST_LIT_INT, width);
        off_expr = join_bin_op(null, T_STAR, off_expr, width_ast);
    }
    return ast4(AST_INDEX, rcvr, off_expr, width);
}

fn process_dot(void* rcvr, void* nameT) {
    if *rcvr != AST_ID {
        eprintf("ERR: can't deref '%s' off a %i at %i:%i\n",
                Token_value(nameT),
                *rcvr,
                Token_line(nameT),
                Token_char(nameT));
        exit(76);
    }
    rcvr = rcvr + 0x8;              # -> nameT
    char* rname = Token_value(*rcvr);
    rcvr = rcvr - 0x8;              # -> whole AST node
    void* rat = Env_typeof_symbol(ENV, rname);
    if *rat != AST_TYPE_PTR {
        eprintf("Cannot deref '%s' off a %i node, only pointer-to-struct\n",
                Token_value(nameT),
                *rat);
        exit(76);
    }
    rat = rat + 0x8;                # -> type
    rat = *rat;
    if *rat != AST_TYPE_NAMED {
        eprintf("Cannot deref '%s' off a pointer-to-%i node, only pointer-to-struct\n",
                Token_value(nameT),
                *rat);
        exit(76);
    }
    rat = rat + 0x8;                # -> nameT
    void* structT = Env_get_type(ENV, Token_value(*rat));
    if *structT != AST_TYPE_STRUCT {
        eprintf("Cannot deref '%s' off a pointer-to-%i node, only pointer-to-struct\n",
                Token_value(nameT),
                *structT);
        exit(76);
    }
    void* member = structT + 0x18;
    member = TreeMap_get(*member, Token_value(nameT));
    if member == null {
        eprintf("Object '%s' (of type '%s') has no member '%s' at line %i, char %i.\n",
                rname,
                Token_value(*rat),
                Token_value(nameT),
                Token_line(nameT),
                Token_char(nameT));
        exit(75);
    }
    Token_drop(nameT); # no longer needed
    member = member + 0x8;          # -> name
    char* name = *member;
    member = member + 0x8;          # -> offset
    int offset = *member;
    member = member + 0x8;          # -> width
#    eprintf("DOT: %s (%i) . %s (%x / %x)\n",
#            rname,
#            *structT,
#            name,
#            offset,
#            *member);
    return ast4(AST_MEMBER, rcvr, offset, *member);
}

# expr[]
fn parse_arg_list(void* lex) {
    consume_token(lex, T_OPAREN);
    if Token_type(peek_token(lex)) == T_CPAREN {
        consume_token(lex, T_CPAREN);
        return null;
    }
    void* args = ArrayList__new(4);
    ArrayList_push(args, parse_expr(lex));
    int i = 0;
    while true {
        void* tkn = peek_token(lex);
        int t = Token_type(tkn);
        if t != T_COMMA { done; }
        consume_token(lex, t);
        i = i + 1;
        if i == 8 { # todo: can't have more than eight at the moment...
            tkn = peek_token(lex);
            if Token_type(tkn) == T_ID {
                char* name = Token_value(tkn);
                Token_set_type(tkn, name);
            }
            jnc_panic(ERR_TOO_MANY_PARAMS, tkn, 21);
        }
        ArrayList_push(args, parse_expr(lex));
    }
    consume_token(lex, T_CPAREN);
    return ArrayList_into_array(args);
}

fn parse_expr_primary(void* lex) {
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);

    if t == T_BOOL   { t = AST_LIT_BOOL;   return parse_val(lex, t); }
    if t == T_CHAR   { t = AST_LIT_CHAR;   return parse_val(lex, t); }
    if t == T_INT    { t = AST_LIT_INT;    return parse_val(lex, t); }
    if t == T_STRING { t = AST_LIT_STRING; return parse_val(lex, t); }
    if t == T_ID     { return parse_id(lex); }
    if t == T_OPAREN {
        consume_token(lex, t);
        void* expr = parse_expr(lex);
        t = T_CPAREN;
        consume_token(lex, t);
        return expr;
    }

    jnc_panic(ERR_BAD_EXPRESSION, tkn, 28);
}

fn parse_val(void* lex, int type) {
    void* tkn = next_token(lex);
    void v = Token_into_value(tkn);
    return ast2(type, v);
}

fn parse_id(void* lex) {
    void* tkn = id_token(lex);
    int type = AST_ID;
    return ast2(type, tkn);
}

fn id_token(void* lex) {
    void* tkn = next_token(lex);
    int t = Token_type(tkn);
    if t == T_ID {
        return tkn;
    }
    expected_token(tkn, T_ID);
}
