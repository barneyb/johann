fn parse_expr_shift(void* lex) {
    return parse_expr_add(lex);
}

fn parse_expr_add(void* lex) {
    void* expr = parse_expr_mult(lex);
    void* right;
    while true {
        void* tkn = peek_token(lex);
        if tkn = null { done; }
        int t = Token_type(tkn);
        bool doit = false;
        if t = T_MINUS { doit = true; }
        if t = T_PLUS  { doit = true; }
        if !doit { done; }
        consume_token(lex, t);
        right = parse_expr_mult(lex);
        expr = join_bin_op(lex, t, expr, right);
    }
    return expr;
}

fn parse_expr_mult(void* lex) {
    void* expr = parse_expr_cast(lex);
    void* right;
    while true {
        void* tkn = peek_token(lex);
        if tkn = null { done; }
        int t = Token_type(tkn);
        bool doit = false;
        if t = T_PERCENT { doit = true; }
        if t = T_SLASH   { doit = true; }
        if t = T_STAR    { doit = true; }
        if !doit { done; }
        consume_token(lex, t);
        right = parse_expr_cast(lex);
        expr = join_bin_op(lex, t, expr, right);
    }
    return expr;
}

# this will take the left AST and join it with the next AST, into a new AST for
# the given operator. If both sides are literal, the operator will be evaluated
# as its result will be returned as a new literal AST instead.
fn join_bin_op(void* lex, int op, void* left, void* right) {
    int ttl = *left;
    int ttr = *right;

    if ttl < 10 { if ttr < 10 {
        # both literal values, evaluate
        if ttl < ttr { ttl = ttr; }
        ttr = left + 0x8;
        ttr = *ttr;
        drop_node(left);
        left = ttr;
        ttr = right + 0x8;
        ttr = *ttr;
        drop_node(right);
        right = ttr;
        bool did_it = false; # todo: remove
#        if op = T_EQ      { ttr = left = right; did_it = true; }
#        if op = T_BANG    { ttr = left ! right; did_it = true; }
#        if op = T_LT      { ttr = left < right; did_it = true; }
#        if op = T_GT      { ttr = left > right; did_it = true; }
        if op = T_PLUS    { ttr = left + right; did_it = true; }
        if op = T_MINUS   { ttr = left - right; did_it = true; }
        if op = T_STAR    { ttr = left * right; did_it = true; }
        if op = T_SLASH   { ttr = left / right; did_it = true; }
        if op = T_PERCENT { ttr = left % right; did_it = true; }
        if did_it {
            return node_a(ttl, ttr);
        }
        char* tmpl = "Can't statically eval %x (%c) with %i and %i\n";
        printf(tmpl, op, op, left, right);
        eprintf(tmpl, op, op, left, right);
        ttl = 16;
        panic(ttl);
    } }

    ttl = AST_BINARY;
    return node_a_b_c(ttl, op, left, right);
}

fn parse_expr_cast(void* lex) {
    return parse_expr_unary(lex);
}

fn parse_expr_unary(void* lex) {
    void* tkn = peek_token(lex);
    if tkn ! null {
        int t = Token_type(tkn);
#        if t = T_AMP   { return join_un_op_rtl(lex, t); }
#        if t = T_BANG  { return join_un_op_rtl(lex, t); }
        if t = T_MINUS { return join_un_op_rtl(lex, t); }
        if t = T_PLUS  { return join_un_op_rtl(lex, t); }
#        if t = T_STAR  { return join_un_op_rtl(lex, t); }
    }
    return parse_expr_postfix(lex);
}

fn join_un_op_rtl(void* lex, int op) {
    # If this ends up being called elsewhere than parse_expr_unary, it'll need
    # to be recast along the lines of join_bin_op.
    consume_token(lex, op);
    void operand = parse_expr_unary(lex);
    int tto = *operand;

    if tto < 10 {
        # a literal, evaluate
        int v = operand + 0x8;
        v = *v;
        drop_node(operand);
        if op = T_MINUS { v = -v; }
        if op = T_PLUS {} # for completeness
        return node_a(tto, v);
    }

    int type = AST_UNARY;
    return node_a_b(type, op, operand);
}

# [AST_CALL, rcvr, args[], null]
fn parse_expr_postfix(void* lex) {
    void* expr = parse_expr_primary(lex);
    void* tkn = peek_token(lex);
    if tkn ! null {
        int t = Token_type(tkn);
        if t = T_OPAREN {
            # function call
            consume_token(lex, t);
            void* args = null;
            tkn = peek_token(lex);
            t = Token_type(tkn);
            if t ! T_CPAREN {
                args = parse_arg_list(lex);
            }
            t = T_CPAREN;
            consume_token(lex, t);
            t = AST_CALL;
            expr = node_a_b(t, expr, args);
        }
    }
    return expr;
}

# expr[]
fn parse_arg_list(void* lex) {
    void bytes = 0x8 * 9; # todo: can't have more than eight at the moment...
    void* args = malloc(bytes);
    void* curr = args;
    *curr = parse_expr(lex);
    curr = curr + 0x8;
    while true {
        void* tkn = peek_token(lex);
        int t = Token_type(tkn);
        if t ! T_COMMA { done; }
        consume_token(lex, t);
        *curr = parse_expr(lex);
        curr = curr + 0x8;
    }
    *curr = null;
    return args;
}

fn parse_expr_primary(void* lex) {
    void* tkn = peek_token(lex);
    int t = Token_type(tkn);

#    if t = T_BOOL   { t = AST_BOOL;   return parse_val(lex, t); }
#    if t = T_CHAR   { t = AST_CHAR;   return parse_val(lex, t); }
    if t = T_INT    { t = AST_INT;    return parse_val(lex, t); }
    if t = T_STRING { t = AST_STRING; return parse_val(lex, t); }
    if t = T_ID     { return parse_id(lex); }
#    if t = T_OPAREN {
#        tkn = next_token(lex);
#        void* expr = parse_expr(lex);
#        tkn = next_token(lex);
#        t = Token_type(tkn);
#        if t = T_CPAREN { return expr; }
#    }

    char* err = ERR_BAD_EXPRESSION;
    t = 28;
    jnc_panic(err, tkn, t);
}

# [AST_type, val, null, null]
fn parse_val(void* lex, int type) {
    void* tkn = next_token(lex);
    void v = Token_into_value(tkn);
    return node_a(type, v);
}

# [AST_ID, nameT, null, null]
fn parse_id(void* lex) {
    void* tkn = id_token(lex);
    int type = AST_ID;
    return node_a(type, tkn);
}

fn id_token(void* lex) {
    void* tkn = next_token(lex);
    int t = Token_type(tkn);
    if t = T_ID {
        return tkn;
    }
    bad_token(tkn);
}
