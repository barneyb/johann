int T_BOOL      = 0x162; # 0x100 + 'b';
int T_CHAR      = 0x163; # 0x100 + 'c';
int T_ID        = 0x169; # 0x100 + 'i';
int T_INT       = 0x16e; # 0x100 + 'n';  # not 'i'
int T_STRING    = 0x173; # 0x100 + 's';

int T_KW_AGAIN  = 0x241; # 0x200 + 'A';
int T_KW_BOOL   = 0x342; # 0x300 + 'B';
int T_KW_CHAR   = 0x343; # 0x300 + 'C';
int T_KW_CONST  = 0x443; # 0x400 + 'C';
int T_KW_DONE   = 0x244; # 0x200 + 'D';
int T_KW_FN     = 0x446; # 0x400 + 'F';
int T_KW_IF     = 0x249; # 0x200 + 'I';
int T_KW_INT    = 0x349; # 0x300 + 'I';
int T_KW_LET    = 0x44c; # 0x400 + 'L';
int T_KW_PUB    = 0x450; # 0x400 + 'P';
int T_KW_RETURN = 0x252; # 0x200 + 'R';
int T_KW_VOID   = 0x356; # 0x300 + 'V';
int T_KW_WHILE  = 0x257; # 0x200 + 'W';

char* KW_AGAIN  = "again";
char* KW_BOOL   = "bool";
char* KW_CHAR   = "char";
char* KW_CONST  = "const";
char* KW_DONE   = "done";
char* KW_FALSE  = "false";
char* KW_FN     = "fn";
char* KW_IF     = "if";
char* KW_INT    = "int";
char* KW_LET    = "let";
char* KW_NULL   = "null";
char* KW_PUB    = "pub";
char* KW_RETURN = "return";
char* KW_TRUE   = "true";
char* KW_VOID   = "void";
char* KW_WHILE  = "while";

pub fn Lexer_bad_char(void* self, int ch) { # todo: private
    char* f = "\n; ERROR(%i): Unrecognized char '%c' at line %i, char %i\n";
    void* token = new_token(self, ch);
    int status = 17;
    jnc_panic(f, token, status);
}

fn new_token(void* self, int type) {
    int line_num = *self;
    self = self + 0x8;
    int char_pos = *self;
    void* token = Token__new(type);
    Token_set_coords(token, line_num, char_pos);
    return token;
}

pub fn token_punct(void* self, int type) { # todo: not public
    return new_token(self, type);
}

pub fn token_int(void* self, int first_char) { # todo: not public
    int type = T_INT;
    void* token = new_token(self, type);
    int value = lex_digits(self, first_char);
    Token_set_value(token, value);
    return token;
}

pub fn token_id(void* self, int first_char) { # todo: not public
    int type = T_ID;
    void* token = new_token(self, type);
    char* name = lex_id(self, first_char);
    Token_set_value(token, name);
    convert_keyword(token);
    return token;
}

pub fn token_char(void* self, int first_char) { # todo: not public
    first_char = T_CHAR;
    void* token = new_token(self, first_char);
    char c = next_char(); # the actual char
    # todo: escape sequences
    Token_set_value(token, c);
    next_char(); # close quote
    return token;
}

pub fn token_string(void* self, int first_char) { # todo: not public
    first_char = T_STRING;
    void* token = new_token(self, first_char);
    char* name = lex_string(self);
    Token_set_value(token, name);
    return token;
}

fn next_char(void* self) {
    int c = getchar();
    self = self + 0x8;
    int char_pos = *self;
    char_pos = char_pos + 1;
    *self = char_pos;
    return c;
}

fn lex_digits(void* self, char first_char) {
    bool is_negative = false;
    int n;
    # deal with negatives first
    if first_char = '-' {
        is_negative = true;
        first_char = next_char(self);
    }
    int val = 12345;
    if first_char ! '0' {
        # decimal
        val = lex_digits_dec(self, first_char);
    }
    if first_char = '0' {
        # might be zero, might be hex
        char c = peekchar();
        bool d;
        if c = 'x' {
            # hex
            next_char(self); # soak up the 'x'
            first_char = next_char(self);
            d = isxdigit(first_char);
            if !d {
                n = 16;
                panic(n); # todo: issue a proper error
            }
            val = lex_digits_hex(self, first_char);
        } # todo: else would be nice...
        if c ! 'x' {
            d = isdigit(c);
            if d {
                # malformed
                n = 10;
                panic(n); # todo: issue a proper error
            }
            # zero
            val = 0;
        }
    }
    if is_negative {
        val = 0 - val;
    }
    return val;
}

fn lex_digits_dec(void* self, char first_char) {
    int val = first_char - '0';
    char c = peekchar();
    bool d = isdigit(c);
    int n;
    while d {
        c = next_char(self);
        n = c - '0';
        val = val * 10;
        val = val + n;
        c = peekchar();
        d = isdigit(c);
    }
    return val;
}

fn lex_digits_hex(void* self, char first_char) {
    int val = parse_hex_digit(first_char);
    char c = peekchar();
    bool d = isxdigit(c);
    int n;
    while d {
        c = next_char(self);
        n = parse_hex_digit(c);
        val = val * 16;
        val = val + n;
        c = peekchar();
        d = isxdigit(c);
    }
    return val;
}

fn parse_hex_digit(char c) {
    if c > 'Z' {
        return c - 'W'; # 10 before 'a'
    }
    if c > '9' {
        return c - '7'; # 10 before 'A'
    }
    return c - '0';
}

fn lex_string(void* self) {
    int cap = 16;
    void* buf = Buffer__new(cap);

    char c;
    while true {
        c = next_char(self);
        if c = '"' { done; }
        Buffer_push(buf, c);
    }

    return Buffer_into_chars(buf);
}

fn lex_id(void* self, char first_char) {
    int cap = 16;
    void* buf = Buffer__new(cap);
    Buffer_push(buf, first_char);

    char c;
    while true {
        c = peekchar();
        # below zero is bad
        if c < '0' { done; }
        # digits are fin
        if c > '9' { if c < 'A' { done; } }
        # uppercase are fine
        if c > 'Z' { if c < '_' { done; } }
        # _ is fine
        if c = '`' { done; } # single char between '_' and 'a'
        # lowercase are fine
        if c > 'z' { done; }
        # above z is bad

        c = next_char(self);
        Buffer_push(buf, c);
    }

    return Buffer_into_chars(buf);
}

fn to_keyword(void* token, char* name, char* kw, int type) {
    if strcmp(name, kw) { return false; }
    Token_set_value(token, kw);
    free(name);
    Token_set_type(token, type);
    return true;
}

# modifies the token in-place!
fn convert_keyword(void* token) {
    char* name = Token_value(token);
    char* kw;
    int type;
    char c = *name;
    void v;
    if c = 'a' {
        kw = KW_AGAIN;
        type = T_KW_AGAIN;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'b' {
        kw = KW_BOOL;
        type = T_KW_BOOL;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'c' {
        kw = KW_CHAR;
        type = T_KW_CHAR;
        if to_keyword(token, name, kw, type) { return; }
        kw = KW_CONST;
        type = T_KW_CONST;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'd' {
        kw = KW_DONE;
        type = T_KW_DONE;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'f' {
        kw = KW_FALSE;
        type = T_BOOL;
        if to_keyword(token, name, kw, type) {
            v = false;
            Token_set_value(token, v);
            return;
        }
        kw = KW_FN;
        type = T_KW_FN;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'i' {
        kw = KW_IF;
        type = T_KW_IF;
        if to_keyword(token, name, kw, type) { return; }
        kw = KW_INT;
        type = T_KW_INT;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'l' {
        kw = KW_LET;
        type = T_KW_LET;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'n' {
        kw = KW_NULL;
        type = T_INT;
        if to_keyword(token, name, kw, type) {
            v = null;
            Token_set_value(token, v);
            return;
        }
        return;
    }
    if c = 'p' {
        kw = KW_PUB;
        type = T_KW_PUB;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'r' {
        kw = KW_RETURN;
        type = T_KW_RETURN;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 't' {
        kw = KW_TRUE;
        type = T_BOOL;
        if to_keyword(token, name, kw, type) {
            v = true;
            Token_set_value(token, v);
            return;
        }
        return;
    }
    if c = 'v' {
        kw = KW_VOID;
        type = T_KW_VOID;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
    if c = 'w' {
        kw = KW_WHILE;
        type = T_KW_WHILE;
        if to_keyword(token, name, kw, type) { return; }
        return;
    }
}
