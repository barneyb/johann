fn main() {
    char* c = "one: ";
    printf(c);
    int a = -1;
    int b = 2;
    a = add(a, b);
    c = itoa(a);
    puts(c);
    free(c);        # don't leak memory

    c = "one: ";
    printf();
    a = -1;
    a = a + 2;
    c = itoa();
    puts();
    c = c;
    free();        # don't leak memory

    char* f = "one: %i\n";
    a = 1;
    printf(f, a);
}

fn add(int a, int b) {
    return a + b;
}
