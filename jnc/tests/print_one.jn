fn main() {
    char* c = "one: ";
    print(c);
    int a = -1;
    int b = 2;
    a = add(a, b);
    c = itoa(a);
    println(c);
    free(c);        # don't leak memory

    c = "one: ";
    print();
    a = -1;
    a = a + 2;
    c = itoa();
    println();
    c = c;
    free();        # don't leak memory

    char* f = "one: %i\n";
    a = 1;
    printf(f, a);
}

fn add(int a, int b) {
    return a + b;
}
