void nil = null;

struct Cell {
    void car,
    void cdr
}

pub fn main() {
    Cell* l = cons(3, cons(2, cons(1, nil)));
    printf("sum: %i\n", sum(l));
    dump(l);
    drop(l);
}

fn cons(void car, Cell* tail) {
#    return new Cell {
#        car,
#        cdr: tail
#    };
    Cell* l = malloc(sizeof(Cell));
    l.car = car;
    l.cdr = tail;
    return l;
}

fn sum(Cell* c) {
    if c == nil { return 0; }
    return c.car + sum(c.cdr);
}

fn dump(Cell* list) {
    int i = 0;
    while list != nil {
        printf("[%i]: %i\n", i, list.car);
        list = list.cdr;
        i = i + 1;
    }
    printf("%i element(s)\n", i);
}

fn drop(Cell* list) {
    if list == nil { return; }
    drop(list.cdr);
    free(list);
}
