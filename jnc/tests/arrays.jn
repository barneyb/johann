fn five_ints() {
    int* ints = malloc(sizeof(int) * 5);
    int* p = ints;
    *p = 1;
    p = p + sizeof(int);
    *p = 2;
    p = p + sizeof(int);
    *p = 3;
    p = p + sizeof(int);
    *p = 4;
    p = p + sizeof(int);
    *p = 5;
    return ints;
}

fn stringify_five_ints(int* ints) { # todo: length from the type!
    void* sb = StringBuilder__new(0);
    StringBuilder_push(sb, '[');
    int* end = ints + 5 * sizeof(int);
    while ints < end {
        char* s = itoa(*ints);
        StringBuilder_push_str(sb, s);
        free(s);
        StringBuilder_push_str(sb, ", ");
        ints = ints + sizeof(int);
    }
    StringBuilder_push(sb, ']');
    return StringBuilder_into_chars(sb);
}
