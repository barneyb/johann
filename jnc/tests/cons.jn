pub fn main() {
    void* l = empty();
    l = cons(l, 1);
    l = cons(l, 2);
    l = cons(l, 3);
    dump(l);
    drop(l);
}

struct List {
    void value;
    void* next;
}

fn empty() {
    return null;
}

fn cons(void* list, void value) {
#    return new List {
#        value,
#        next: list
#    };
    void* l = malloc(sizeof(List));
#    l.next = list;
    l = l + 0x8;                    # -> next
    *l = list;
#    l.value = value;
    l = l - 0x8;                    # -> value
    *l = value;
    return l;
}

fn dump(void* list) {
    int i = 0;
    while list != null {
#        printf("%i", list.value);
#        list = list.next;
        printf("[%i]: %i\n", i, *list);
        list = list + 0x8;          # -> next
        list = *list;
        i = i + 1;
    }
    printf("%i element(s)\n", i);
}

fn drop(void* list) {
    if list == null { return; }
    list = list + 0x8;              # -> next
    drop(*list);
    list = list - 0x8;                    # -> value
    free(list);
}
