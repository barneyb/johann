# I read a series of integers and add them up, printing each number and the
# running total as they are read.
pub fn main() {
    char* g = "0";
    puts(g);
    int a = 0;          # answer
    int e = -1;         # EOF
    int f = 0;          # accumulator
    bool b = false;     # negative
    char c = read();
    while c > e {
        if c = '-' {
            b = true;
            c = read();
            again;
        }
        bool d = isdigit(c);
        if d {
            c = c - '0'; # subtract ASCII 0 to "parse digit"
            f = f * 10;
            f = f + c;
            if b {
                # negate
                f = f * -1;
                b = false;
            }
        }
        if !d {
            g = "+ %i\n";
            printf(g, f);
            a = add(a, f);  # add to the answer
            f = 0;          # reset
            g = "= %i\n";
            printf(g, a);
        }
        c = read();
    }
}

fn add(int a, int b) {
    return a + b;
}
