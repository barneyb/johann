fn main() -> int {
    int f = zero();
    int e = 0;
    int g = 0;
    char c = read();
    int b = 0 - 1;
    while c > b {
        g = g + 1;
        if c = '(' {
            f = f + 1;
        }
        if c = ')' {
            f = f - 1;
        }
        int d = f + 1;
        if d = 0 {
            d = e = 0;
            if d {
                e = g;
            }
        }
        c = read();
    }
    char* a = "one: ";
    printf();            # implicitly passed a
    f = f;
    a = itoa();         # implicitly passed f
    puts();             # implicitly passed a
    a = a;
    free();             # implicitly passed a
    a = "two: ";
    printf();            # implicitly passed a
    e = e;
    a = itoa();         # implicitly passed e
    puts();             # implicitly passed a
    a = a;
    free();             # implicitly passed a
}

fn zero() {
    return 0;
}
