int ONE = 1;
char C_ZERO = '0';
char* F_START = "%i";
char* F_NEXT_NUM = ", %i";

pub fn main(int argc, char** argv) {
    # skip the command name
    int b = ONE;
    while b < argc {
        int d = b * 8;
        d = argv + d;
        d = *d;
        print_series(d);
        b = b + 1;
    }
}

fn print_series(char* c) {
    int a = read_int(c);
    char* f = F_START;
    printf(f, a);
    f = F_NEXT_NUM;
    while a > 1 {
        int b = a % 2;
        if b == 0 {
            int a; # legal, though pointless, no-op
            a = a / 2;
            printf(f, a);
            again;
        } else {
            a = a * 3;
            a = a + 1;
            printf(f, a);
            again;
        }
        eprintf("um. you did it wrong.\n");
        exit(1);
    }
    f = " !\n";
    printf(f);
}

fn read_int(char* a) {
    int f = 0;          # accumulator
    char c = *a;
    while c > 0 {
        c = c - C_ZERO; # subtract ASCII 0 to "parse digit"
        f = f * 10;
        f = f + c;
        a = a + 1; # todo: use array notation instead of pointer arithmetic
        c = *a;
    }
    return f;
}
