int ONE = 1;
char C_ZERO = '0';
char* START = "%i";
char* NEXT_NUM = ", %i";

fn main(int c, char** a) {
    # skip the command name
    int b = *ONE; # todo: this global isn't SUPPOSED to be a pointer
    while b < c {
        d = b * 8;
        d = a + d;
        d = *d;
        print_series(d);
        b = b + 1;
    }
}

fn print_series(char* a) {
    int a = read_int(a);
    char* f = START;
    printf(f, a);
    f = NEXT_NUM;
    while a > 1 {
        b = a % 2;
        if b = 0 {
            a = a / 2;
        }
        if b = 1 {
            a = a * 3;
            a = a + 1;
        }
        printf(f, a);
    }
    f = " !\n";
    printf(f);
}

fn read_int(char* a) {
    int f = 0;          # accumulator
    c = loadb(a); # todo: icky
    char d = C_ZERO;
    d = loadb(d); # todo: not a pointer
                  # todo: should be inlined
    while c > 0 {
        c = c - d; # subtract ASCII 0 to "parse digit"
        f = f * 10;
        f = f + c;
        a = a + 1; # todo: use array notation
        c = loadb(a); # todo: icky
    }
    return f;
}
