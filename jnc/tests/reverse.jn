char* STRING_A = "no commas here!";
char* STRING_B = "perhaps four, or fewer, commas?";
char* STRING_C = "I am a significantly longer string of characters to examine, but still have a comma.";
char STOP_AT = ',';
int CHARS_SCANNED = 0;

pub fn main() {
    char* str = STRING_A;
    do_string(str);
    scan_stats();

    str = STRING_B;
    do_string(str);
    scan_stats();

    str = STRING_C;
    do_string(str);
    scan_stats();
}

fn scan_stats() {
    char* f = "Scanned %i total chars\n";
    int b = CHARS_SCANNED;
    printf(f, b);
}

fn do_string(char* a) {
    # find the stop char
    char g = STOP_AT;
    int b = strpos(a, g);

    char* f;
    if b < 0 {
        f = "Didn't find stop char '%c' anywhere in '%s'?!\n";
        printf(f, g, a);
        return b;
    }
    f = "Found '%c' at position %i of '%s'.\n";
    printf(f, g, b, a);
    char* d = strcpy(a);
    strrev(d, b);
    b = strpos(d, g);
    printf(f, g, b, d);
    free(d);
}

fn strpos(char* a, char b) {
    char* d = a;
    char c = scan(d);
    while c ! b {
        if c = 0 {
            return -1;
        }
        d = d + 1;
        c = scan(d);
    }
    d = d - a;
    return d;
}

fn scan(char* a) {
    char c = *a;
    CHARS_SCANNED = CHARS_SCANNED + 1;
    return c;
}

fn strcpy(char* a) {
    int d = strlen(a);
    d = d + 1; # for the trailing null
    char* b = malloc(d);
    memcpy(b, a, d);
    return b;
}

fn strrev(char* str, int end) {
    int start = 0;
    end = end - 1; # don't move the stop char itself
    char* format = "swap '%c' for '%c', at %i and %i\n";
    while end > start {
        char* c = str + end;
        char* g = str + start;
        char e = *c;
        char f = *g;
        printf(format, f, e, start, end);
        *c = f;
        *g = e;
        end = end - 1;
        start = start + 1;
    }
}
