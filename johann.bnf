// IntelliJ Grammar-Kit BNF for Johann
{
  tokens=[
    WHITE_SPACE='regexp:\s+'
    COMMENT='regexp:#.*'

    ID='regexp:[a-zA-Z][a-zA-Z0-9_]*'
    INT_DEC='regexp:-?[1-9][0-9_]*'
    INT_HEX='regexp:-?0x[0-9a-fA-F][0-9a-fA-F_]*'
    CHAR="regexp:'.'"
    STRING='regexp:"[^"]*"'
  ]
}

program_ ::= ( declaration_ )*
private declaration_ ::= ( "pub" )? ( global_declaration
                                    | function_declaration
                                    | struct_declaration
                                    )
global_declaration ::= variable_declaration
function_declaration ::= "fn" ID "(" parameter_list? ")" /*( "->" type )?*/ ( ";" | block_ )
struct_declaration ::= "struct" ID ( "{" ( member_declaration )+ "}" )? ";"? // semi is permitted, but not required
member_declaration ::= type_spec ID ";"
private type_spec ::= ( "bool"
                      | "char"
                      | "int"
                      | "void"
                      | ID "*"
                      ) ( "*" )*
private variable_declaration ::= type_and_name ( "=" expr_ )? ";"
private type_and_name ::= type_ ( "*" )* ID
private parameter_list ::= type_opt_name ( "," type_opt_name )*
private type_opt_name ::= type_ ( "*" )* ( ID )?
private type_ ::= "bool"
                | "char"
                | "int"
                | "void"
//                | "(" type_list ")" "->" type
//type_list ::= type ( "," type )*
private block_ ::= "{" block_item* "}"
block_item ::= variable_declaration
             | struct_declaration
             | "if" expr_ block_ /*( "else" block )?*/
             | "while" expr_ block_
             | "done" ";"
             | "again" ";"
             | "return" expr_ ";"
             | unary_expr assign_op expr_ ";"
             | expr_ ";"
//             | block_
             | ";"
assign_op ::= "=" //| "+=" | "-=" | "*=" | "/=" | "%="

/* Recursive descent is not ideal here, but it's straightforward to hand-code.
 * At the moment, matching the implementation is more useful than an efficient
 * (hypothetical) IDE.
 */
expr_ ::= cond_expr

private cond_expr ::= lor_expr // ( "?" expr ":" cond_expr )?

private lor_expr ::= land_expr // ( "||" land_expr )*

private land_expr ::= bor_expr // ( "&&" bor_expr )*

private bor_expr ::= bxor_expr // ( "|" bxor_expr )*

private bxor_expr ::= band_expr // ( "^" band_expr )*

private band_expr ::= eq_expr // ( "&" eq_expr )*

private eq_expr ::= rel_expr ( ( "==" | "!=" ) rel_expr )*

private rel_expr ::= shift_expr ( ( "<" | ">" | "<=" | ">=" ) shift_expr )*

private shift_expr ::= add_expr // ( ( "<<" | ">>" ) add_expr )*

private add_expr ::= mult_expr ( ( "+" | "-" ) mult_expr )*

private mult_expr ::= cast_expr ( ( "*" | "/" | "%" ) cast_expr )*

private cast_expr ::= unary_expr
//                    | "(" type ")" cast_expr

private unary_expr ::= postfix_expr
                     | un_op cast_expr
//                     | "sizeof" "(" type ")"
//                     | "sizeof" expr_
private un_op ::= "-" | "+" | "!" | "*" | "&"

private postfix_expr ::= primary_expr (
                             "(" argument_list? ")"
//                             | "[" expr "]"
//                             | "." ID // todo: obj.method().another().field?
                         )*
private argument_list ::= expr_ ( "," expr_ )*

private primary_expr ::= ID
                       | CHAR
                       | const_
                       | STRING
                       | "true" | "false"
                       | "(" expr_ ")"

private const_ ::= INT_DEC
                 | INT_HEX
                 | "0"
